---
/**
 * Guide article page body: /guides/<slug>/. Renders the markdown entry with a header, TOC (h2),
 * prose body, FAQ, related content, CTA. JSON-LD: Article + BreadcrumbList + FAQPage.
 *
 * The frame is the owner's prototype's (design/CHANGELOG.md §10); the article itself is content
 * and is rendered as the coach wrote it. The header is the cluster as a kicker, the title as the
 * display line, the description as the lede — it is the page's meta description and the one
 * paragraph the frame keeps — and then the facts: the author as a circle with his name (a person
 * is a circle), the reading time as a pill, the dates as one muted tabular line. The four-cell
 * «Опубликовано / Обновлено / 6 мин чтения / Автор: …» table it replaces said the same things in
 * a row of labels.
 *
 * Related things are rows, not grids of cards: exercises as still + name + pills, courses as
 * tile + name + pills, guides as title + reading time.
 */
import { render, type CollectionEntry } from 'astro:content';
import Landing from '@/layouts/Landing.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import CourseLinkCard from '@/components/seo/CourseLinkCard.astro';
import FaqAccordion from '@/components/seo/FaqAccordion.astro';
import GuideBody from '@/components/seo/GuideBody.astro';
import RelatedLinks from '@/components/seo/RelatedLinks.astro';
import ExerciseCard from '@/components/exercises/ExerciseCard.astro';
import Button from '@/components/landing/Button.astro';
import HeroField from '@/components/landing/HeroField.astro';
import KeyTitle from '@/components/landing/KeyTitle.astro';
import Pill from '@/components/landing/Pill.astro';
import { COURSE_BY_ID, EXERCISE_BY_ID } from '@/content/registry';
import type { Course, Exercise, Locale } from '@/content/schema';
import { formatDate, l, t } from '@/i18n/index';
import {
  clusterPath,
  guideLocalizedPaths,
  guidePath,
  guideReadingTime,
  guideWords,
  relatedGuidesFor,
  type GuideLike,
} from '@/lib/seo/guides';
import { articleJsonLd, breadcrumbJsonLd, faqJsonLd } from '@/lib/seo/jsonld';
import { ogImagePath, readingTimeMinutes } from '@/lib/seo/meta';
import { canonicalUrl, siteOrigin } from '@/lib/seo/urls';
import { absoluteUrl, href, withBase } from '@/lib/util/paths';
import { COACH } from '@content/site/coach';

interface Props {
  entry: CollectionEntry<'guides'>;
  locale: Locale;
  all: GuideLike[];
}

const { entry, locale, all } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const site = siteOrigin(Astro.site);
const path = guidePath(entry);
const localizedPaths = guideLocalizedPaths(entry, all);
const sitePath = localizedPaths.ru ?? path;
const url = canonicalUrl(site, locale, path);
const image = ogImagePath('guide', d.translationKey, locale);
const words = guideWords(entry);
const minutes = readingTimeMinutes(words, locale);
const toc = headings.filter((h) => h.depth === 2);
const clusterTitle = t(locale, `seo.cluster_${d.cluster}_title` as const);
const authorName = l(COACH.name, locale);
const updated = d.updatedAt !== d.publishedAt;

/*
 * Related movements, filmed ones only. These render as cards with links, and an unfilmed movement
 * has no page for the card to open (`src/content/registry.ts`, FILMED_EXERCISES) — a guide about
 * kettlebells can legitimately name six of them and have none of them shot yet. The frontmatter is
 * not wrong and is not edited: the day the coach films one, its card comes back on its own.
 */
const relatedExercises = d.relatedExercises
  .map((id) => EXERCISE_BY_ID.get(id))
  .filter((x): x is Exercise => x !== undefined && x.video !== undefined);
const relatedCourses = d.relatedCourses
  .map((id) => COURSE_BY_ID.get(id))
  .filter((x): x is Course => x !== undefined);
const relatedGuides = relatedGuidesFor(entry, all);
const ctaCourse =
  (d.cta.courseId ? COURSE_BY_ID.get(d.cta.courseId) : undefined) ?? relatedCourses[0];
const ctaHref = ctaCourse
  ? href(locale, `/courses/${ctaCourse.slug[locale]}/`)
  : href(locale, '/courses/');
const ctaText = ctaCourse
  ? t(locale, 'seo.guideCtaText', { course: l(ctaCourse.name, locale) })
  : t(locale, 'seo.guideCtaTextGeneric');
const ctaButton =
  d.cta.label ?? (ctaCourse ? t(locale, 'seo.guideCtaButton') : t(locale, 'seo.chooseCourse'));

const crumbs = [
  { name: t(locale, 'seo.home'), url: canonicalUrl(site, locale, '/'), href: href(locale, '/') },
  {
    name: t(locale, 'seo.guides'),
    url: canonicalUrl(site, locale, '/guides/'),
    href: href(locale, '/guides/'),
  },
  {
    name: clusterTitle,
    url: canonicalUrl(site, locale, clusterPath(d.cluster)),
    href: href(locale, clusterPath(d.cluster)),
  },
  { name: d.h1, url },
];
const jsonLd = [
  articleJsonLd({
    site,
    locale,
    headline: d.h1,
    description: d.description,
    url,
    image: absoluteUrl(site, image),
    datePublished: d.publishedAt,
    dateModified: d.updatedAt,
    wordCount: words,
    keywords: [d.targetKeyword, ...d.secondaryKeywords],
  }),
  breadcrumbJsonLd(crumbs),
  faqJsonLd(d.faq),
].filter((x): x is NonNullable<typeof x> => x !== null);

const H2 = 'display text-lg md:text-xl';
---

<Landing
  locale={locale}
  title={d.title}
  description={d.description}
  sitePath={sitePath}
  localizedPaths={localizedPaths}
  type="article"
  image={image}
  jsonLd={jsonLd}
  publishedAt={d.publishedAt}
  updatedAt={d.updatedAt}
>
  <div class="mx-auto max-w-6xl px-5 pb-16 pt-8 md:pt-12">
    <Breadcrumbs locale={locale} items={crumbs} />

    <div class="mt-6 grid gap-10 lg:grid-cols-[minmax(0,1fr)_280px]">
      <article>
        <header>
          <!--
            The article's h1 is the one 800 line on the page, in the page's blue field (Style A),
            its last word in light blue over the swoosh; long SEO titles hyphenate.
          -->
          <HeroField>
            <a
              class="eyebrow underline-offset-4 hover:underline"
              href={href(locale, clusterPath(d.cluster))}
            >
              {clusterTitle}
            </a>
            <KeyTitle text={d.h1} class="display mt-4 text-3xl md:text-5xl" />
            <p class="field-lead mt-5 text-lg leading-relaxed">{d.description}</p>
          </HeroField>
          <!--
            The author as a circle beside the reading time. The portrait is monochrome like every
            photograph on the site; without one the circle holds his initial on the tile.
          -->
          <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-3 border-t border-border pt-5">
            <span class="flex items-center gap-2.5 text-sm font-semibold">
              {
                COACH.photo ? (
                  <img
                    src={withBase(COACH.photo)}
                    alt=""
                    width="28"
                    height="28"
                    loading="lazy"
                    decoding="async"
                    class="photo-mono size-7 shrink-0 rounded-pill object-cover"
                  />
                ) : (
                  <span
                    class="glyph flex size-7 shrink-0 items-center justify-center rounded-pill bg-paper text-[11px] text-ink"
                    aria-hidden="true"
                  >
                    {authorName.trim().charAt(0)}
                  </span>
                )
              }
              <span>{authorName}</span>
            </span>
            <Pill>{t(locale, 'seo.readingTime', { n: minutes })}</Pill>
            <p class="tabular flex flex-wrap gap-x-2 text-xs text-muted-2">
              <span class="sr-only">{t(locale, 'seo.published')}</span>
              <time datetime={d.publishedAt}>{formatDate(locale, d.publishedAt, 'long')}</time>
              {
                updated && (
                  <span>
                    · {t(locale, 'seo.updated').toLowerCase()}{' '}
                    <time datetime={d.updatedAt}>{formatDate(locale, d.updatedAt, 'long')}</time>
                  </span>
                )
              }
            </p>
          </div>
        </header>

        {
          toc.length > 1 && (
            <nav
              aria-label={t(locale, 'seo.tocTitle')}
              class="mt-8 border-t border-border pt-4 lg:hidden"
            >
              <p class="eyebrow">{t(locale, 'seo.tocTitle')}</p>
              <ol class="mt-3 text-sm">
                {toc.map((h, i) => (
                  <li class="flex items-baseline gap-3 border-b border-border py-2">
                    <span
                      class="numeral tabular w-5 shrink-0 text-xs text-muted-2"
                      aria-hidden="true"
                    >
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <a class="text-muted hover:text-text" href={`#${h.slug}`}>
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        <GuideBody class="mt-10">
          <Content />
        </GuideBody>

        <FaqAccordion title={t(locale, 'seo.faqTitle')} items={d.faq} />
      </article>

      <aside class="hidden lg:block">
        {
          toc.length > 1 && (
            <nav
              aria-label={t(locale, 'seo.tocTitle')}
              class="sticky top-24 border-t border-border pt-4"
            >
              <p class="eyebrow">{t(locale, 'seo.tocTitle')}</p>
              <ol class="mt-3 text-sm">
                {toc.map((h, i) => (
                  <li class="flex items-baseline gap-3 border-b border-border py-2">
                    <span
                      class="numeral tabular w-5 shrink-0 text-xs text-muted-2"
                      aria-hidden="true"
                    >
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <a class="text-muted hover:text-text" href={`#${h.slug}`}>
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
      </aside>
    </div>

    {
      relatedExercises.length > 0 && (
        <section aria-labelledby="related-exercises-title" class="mt-14">
          <h2 id="related-exercises-title" class={H2}>
            {t(locale, 'seo.relatedExercises')}
          </h2>
          <ul class="mt-5 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-3">
            {relatedExercises.map((ex) => (
              <li>
                <ExerciseCard exercise={ex} locale={locale} showPattern />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      relatedCourses.length > 0 && (
        <section aria-labelledby="related-courses-title" class="mt-14">
          <h2 id="related-courses-title" class={H2}>
            {t(locale, 'seo.relatedCourses')}
          </h2>
          <ul class="mt-5 grid gap-x-8 md:grid-cols-2">
            {relatedCourses.map((c) => (
              <li>
                <CourseLinkCard course={c} locale={locale} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <RelatedLinks
      id="related-guides"
      title={t(locale, 'seo.relatedGuides')}
      items={relatedGuides.map((g) => ({
        title: g.data.title,
        href: href(locale, guidePath(g)),
        eyebrow: t(locale, `seo.cluster_${g.data.cluster}_title` as const),
        meta: t(locale, 'seo.readingTime', { n: guideReadingTime(g) }),
      }))}
    />

    <!-- The closing call, set over a hairline like the landing's own CTA — no box, no glow. -->
    <section
      class="mt-14 border-t border-border pt-10 md:flex md:items-end md:justify-between md:gap-8"
    >
      <div>
        <h2 class="display text-2xl md:text-3xl">{t(locale, 'seo.guideCtaTitle')}</h2>
        <p class="mt-4 max-w-xl text-[15px] leading-relaxed text-muted">{ctaText}</p>
      </div>
      <Button href={ctaHref} size="lg" class="mt-6 w-full shrink-0 sm:w-auto md:mt-0">
        {ctaButton}
      </Button>
    </section>
  </div>
</Landing>
