---
/**
 * Typography wrapper for rendered guide markdown. Prose styles are written with the design
 * tokens (no @tailwindcss/typography): comfortable measure, display-face H2s in capitals, token
 * colours, and no radius on anything — code, images, blocks are all square like the rest of the
 * product.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['guide-body', className]} data-guide-body>
  <slot />
</div>

<script>
  // Markdown tables can be wider than a phone. Without JS the table itself scrolls (display:block),
  // which costs its table semantics; with JS we move the scrolling to a focusable wrapper so
  // keyboard users can pan it and the table stays a real table for assistive technology.
  // The wrapper is only given a region role when the table carries a caption to name it with.
  for (const body of document.querySelectorAll<HTMLElement>('[data-guide-body]')) {
    for (const table of body.querySelectorAll('table')) {
      if (table.parentElement?.dataset.tableScroll !== undefined) continue;
      const wrap = document.createElement('div');
      wrap.dataset.tableScroll = '';
      wrap.className = 'guide-table-scroll';
      wrap.tabIndex = 0;
      const name = table.querySelector('caption')?.textContent?.trim();
      if (name) {
        wrap.setAttribute('role', 'region');
        wrap.setAttribute('aria-label', name);
      }
      table.replaceWith(wrap);
      wrap.append(table);
    }
  }
</script>

<style>
  .guide-body {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text);
    max-width: 72ch;
    /* Long URLs and identifiers in prose must wrap rather than widen the page. */
    overflow-wrap: break-word;
  }
  .guide-body :global(.guide-table-scroll) {
    overflow-x: auto;
    margin: 0 0 1.5rem;
  }
  .guide-body :global(.guide-table-scroll:focus-visible) {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
  /* Inside the scroll wrapper the table can be a real table again. */
  .guide-body :global(.guide-table-scroll > table) {
    display: table;
    overflow-x: visible;
    margin: 0;
  }
  .guide-body :global(h2),
  .guide-body :global(h3),
  .guide-body :global(h4) {
    scroll-margin-top: 6rem;
    color: var(--text);
  }
  /*
   * Section heads in the display face: Unbounded SemiBold, capitals, no italics (the brandbook
   * has none). Capitals set wide, so the size stays modest and the browser is allowed to
   * hyphenate at a real syllable boundary rather than snap a long word mid-letter.
   */
  .guide-body :global(h2) {
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0;
    line-height: 1.2;
    font-size: 1.25rem;
    hyphens: auto;
    margin: 3rem 0 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .guide-body :global(h3) {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 2rem 0 0.75rem;
  }
  .guide-body :global(h4) {
    font-size: 1rem;
    font-weight: 700;
    margin: 1.5rem 0 0.5rem;
  }
  .guide-body :global(p) {
    margin: 0 0 1.15rem;
  }
  /* Links are white text with a hairline underline that darkens on hover — no second colour. */
  .guide-body :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 0.2em;
  }
  .guide-body :global(a:hover) {
    text-decoration-color: var(--text);
  }
  .guide-body :global(strong) {
    color: var(--text);
    font-weight: 700;
  }
  .guide-body :global(ul),
  .guide-body :global(ol) {
    margin: 0 0 1.25rem;
    padding-left: 1.4rem;
  }
  .guide-body :global(ul) {
    list-style: disc;
  }
  .guide-body :global(ol) {
    list-style: decimal;
  }
  .guide-body :global(li) {
    margin: 0.35rem 0;
  }
  .guide-body :global(li::marker) {
    color: var(--muted);
  }
  .guide-body :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 2px solid var(--border-strong);
    color: var(--muted);
  }
  .guide-body :global(hr) {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }
  .guide-body :global(code) {
    font-size: 0.9em;
    background: var(--surface-2);
    padding: 0.1em 0.4em;
  }
  .guide-body :global(pre) {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1rem 1.25rem;
    overflow-x: auto;
    margin: 0 0 1.25rem;
  }
  .guide-body :global(pre code) {
    background: transparent;
    padding: 0;
  }
  .guide-body :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 0 0 1.5rem;
    font-size: 0.95rem;
  }
  .guide-body :global(th),
  .guide-body :global(td) {
    text-align: left;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .guide-body :global(th) {
    color: var(--muted);
    font-weight: 600;
    font-size: 0.8rem;
    /* Not uppercased: Russian table headers lose their word shape in all-caps Cyrillic. */
    letter-spacing: 0.01em;
  }
  /* Photographs in prose are monochrome like every other photograph in the product. */
  .guide-body :global(img) {
    max-width: 100%;
    height: auto;
    filter: grayscale(1) contrast(1.05) brightness(0.92);
  }
</style>
