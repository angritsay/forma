---
/**
 * Cluster hub page body: /guides/<cluster>/. Rendered by pages/[...lang]/guides/[slug].astro
 * for clusters that have at least one published guide in the locale.
 */
import Landing from '@/layouts/Landing.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import GuideCard from '@/components/seo/GuideCard.astro';
import type { Locale } from '@/content/schema';
import { LOCALES } from '@/content/schema';
import { plural, t } from '@/i18n/index';
import type { GuideCluster } from '@/lib/seo/clusters';
import { clusterPath, clustersWithGuides, guidePath, guidesForLocale, type GuideLike } from '@/lib/seo/guides';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/lib/seo/jsonld';
import { ogImagePath } from '@/lib/seo/meta';
import { canonicalUrl, siteOrigin } from '@/lib/seo/urls';
import { href } from '@/lib/util/paths';

interface Props {
  cluster: GuideCluster;
  locale: Locale;
  all: GuideLike[];
}

const { cluster, locale, all } = Astro.props;
const site = siteOrigin(Astro.site);
const sitePath = clusterPath(cluster);
const url = canonicalUrl(site, locale, sitePath);
const clusterTitle = t(locale, `seo.cluster_${cluster}_title` as const);
const description = t(locale, `seo.cluster_${cluster}_description` as const);
const title = t(locale, 'seo.clusterHubTitle', { cluster: clusterTitle });
const list = guidesForLocale(all, locale).filter((g) => g.data.cluster === cluster);

const localizedPaths: Partial<Record<Locale, string>> = {};
for (const loc of LOCALES) if (clustersWithGuides(all, loc).includes(cluster)) localizedPaths[loc] = sitePath;

const countLabel = `${list.length} ${plural(locale, list.length, {
  one: t(locale, 'seo.guideWordOne'),
  few: t(locale, 'seo.guideWordFew'),
  many: t(locale, 'seo.guideWordMany'),
})}`;

const crumbs = [
  { name: t(locale, 'seo.home'), url: canonicalUrl(site, locale, '/'), href: href(locale, '/') },
  { name: t(locale, 'seo.guides'), url: canonicalUrl(site, locale, '/guides/'), href: href(locale, '/guides/') },
  { name: clusterTitle, url },
];
const jsonLd = [
  collectionPageJsonLd({
    site,
    locale,
    name: clusterTitle,
    description,
    url,
    items: list.map((g) => ({
      name: g.data.title,
      url: canonicalUrl(site, locale, guidePath(g)),
      description: g.data.description,
    })),
  }),
  breadcrumbJsonLd(crumbs),
];
---

<Landing
  locale={locale}
  title={title}
  description={description}
  sitePath={sitePath}
  localizedPaths={localizedPaths}
  image={ogImagePath('hub', 'guides', locale)}
  jsonLd={jsonLd}
>
  <main class="mx-auto max-w-6xl px-5 pb-16 pt-8 md:pt-12">
    <Breadcrumbs locale={locale} items={crumbs} />
    <header class="mt-6 max-w-3xl">
      <p class="text-xs uppercase tracking-wide text-muted">{t(locale, 'seo.guides')}</p>
      <h1 class="mt-3 font-display text-4xl md:text-6xl">{clusterTitle}</h1>
      <p class="mt-5 text-lg leading-relaxed text-muted">{description}</p>
      <p class="mt-3 text-sm text-muted-2">{t(locale, 'seo.clusterHubIntro', { count: countLabel })}</p>
    </header>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        list.map((guide) => (
          <li>
            <GuideCard guide={guide} locale={locale} showCluster={false} />
          </li>
        ))
      }
    </ul>
    <p class="mt-10">
      <a class="text-sm text-muted hover:text-text" href={href(locale, '/guides/')}>
        ← {t(locale, 'seo.guidesAll')}
      </a>
    </p>
  </main>
</Landing>
