---
/**
 * FAQ accordion built on <details> (keyboard accessible, no JS). Pair with `faqJsonLd(items)`.
 * Hairline rows; the toggle is a + glyph that turns into × when the answer is open.
 */
interface Props {
  title: string;
  items: { q: string; a: string }[];
  id?: string;
  class?: string;
}

const { title, items, id = 'faq', class: className = '' } = Astro.props;
---

{
  items.length > 0 && (
    <section aria-labelledby={`${id}-title`} class:list={['mt-16', className]}>
      <h2 id={`${id}-title`} class="font-display text-xl md:text-2xl">
        {title}
      </h2>
      <div class="mt-6 divide-y divide-border border-t border-border">
        {items.map((it) => (
          <details class="group py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden">
              <span>{it.q}</span>
              <span
                aria-hidden="true"
                class="glyph flex size-8 shrink-0 items-center justify-center text-lg text-muted transition-transform duration-150 ease-(--ease-out) group-open:rotate-45"
              >
                +
              </span>
            </summary>
            <p class="mt-3 max-w-3xl leading-relaxed text-muted">{it.a}</p>
          </details>
        ))}
      </div>
    </section>
  )
}
