---
/**
 * FAQ accordion built on <details> (keyboard accessible, no JS). Pair with `faqJsonLd(items)`.
 */
interface Props {
  title: string;
  items: { q: string; a: string }[];
  id?: string;
  class?: string;
}

const { title, items, id = 'faq', class: className = '' } = Astro.props;
---

{
  items.length > 0 && (
    <section aria-labelledby={`${id}-title`} class:list={['mt-16', className]}>
      <h2 id={`${id}-title`} class="font-display text-2xl md:text-3xl">
        {title}
      </h2>
      <div class="mt-6 divide-y divide-border rounded-card border border-border bg-surface">
        {items.map((it) => (
          <details class="group px-5 py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden">
              <span>{it.q}</span>
              <span
                aria-hidden="true"
                class="shrink-0 text-xl leading-none text-muted transition-transform group-open:rotate-45"
              >
                +
              </span>
            </summary>
            <p class="mt-3 leading-relaxed text-muted">{it.a}</p>
          </details>
        ))}
      </div>
    </section>
  )
}
