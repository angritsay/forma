---
/**
 * Generic "related" list used for internal linking (exercises, guides, any list of links).
 * Course cards use CourseLinkCard so that every course link carries its tile and chips.
 * Hairline rows, not boxes — the same shape as GuideCard so a page of related things reads as
 * one index.
 */
export interface RelatedItem {
  title: string;
  href: string;
  description?: string;
  eyebrow?: string;
  meta?: string;
}

interface Props {
  title: string;
  items: RelatedItem[];
  id?: string;
  class?: string;
}

const { title, items, id = 'related', class: className = '' } = Astro.props;
---

{
  items.length > 0 && (
    <section aria-labelledby={`${id}-title`} class:list={['mt-16', className]}>
      <h2 id={`${id}-title`} class="font-display text-xl md:text-2xl">
        {title}
      </h2>
      <ul class="mt-6 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((it) => (
          <li>
            <a
              href={it.href}
              class="group flex h-full flex-col border-t border-border py-5 transition-colors duration-150 hover:border-border-strong"
            >
              {it.eyebrow && <span class="eyebrow">{it.eyebrow}</span>}
              <span class="mt-2 text-[15px] leading-snug font-semibold group-hover:underline">
                {it.title}
              </span>
              {it.description && (
                <span class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted">
                  {it.description}
                </span>
              )}
              {it.meta && <span class="tabular mt-auto pt-3 text-xs text-muted-2">{it.meta}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
