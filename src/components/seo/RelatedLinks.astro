---
/**
 * Generic "related" list used for internal linking (guides, any list of links).
 * Course cards use CourseLinkCard so that every course link carries its tile and chips.
 *
 * Rows, not a grid of cards: a kicker and the title on the left, the one fact as a pill and a →
 * on the right. The description each row used to carry is gone (design/CHANGELOG.md §10) — a
 * list of things to read next is an index, and an index is titles.
 */
import Pill from '@/components/landing/Pill.astro';

export interface RelatedItem {
  title: string;
  href: string;
  eyebrow?: string;
  meta?: string;
}

interface Props {
  title: string;
  items: RelatedItem[];
  id?: string;
  class?: string;
}

const { title, items, id = 'related', class: className = '' } = Astro.props;
---

{
  items.length > 0 && (
    <section aria-labelledby={`${id}-title`} class:list={['mt-14', className]}>
      <h2 id={`${id}-title`} class="display text-lg md:text-xl">
        {title}
      </h2>
      <ul class="mt-5 divide-y divide-border border-t border-border">
        {items.map((it) => (
          <li>
            <a
              href={it.href}
              class="group flex items-center justify-between gap-4 py-4 transition-colors duration-150"
            >
              <span class="min-w-0">
                {it.eyebrow && <span class="eyebrow mb-1 block">{it.eyebrow}</span>}
                <span class="block text-[15px] leading-snug font-semibold group-hover:underline">
                  {it.title}
                </span>
              </span>
              <span class="flex shrink-0 items-center gap-3">
                {it.meta && <Pill class="max-sm:hidden">{it.meta}</Pill>}
                <span class="glyph text-base text-muted-2 group-hover:text-text" aria-hidden="true">
                  →
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
