---
/**
 * Analytics snippets, rendered only when the ids are configured:
 *   PUBLIC_YANDEX_METRIKA_ID — Yandex Metrika counter (numeric)
 *   PUBLIC_GA_ID             — Google Analytics 4 measurement id (G-XXXXXXX)
 * Included by Landing.astro in the <head>. The app (/app/) does not include it.
 */
const metrikaRaw = (import.meta.env.PUBLIC_YANDEX_METRIKA_ID ?? '').trim();
const gaRaw = (import.meta.env.PUBLIC_GA_ID ?? '').trim();
const metrikaId = /^\d{4,12}$/.test(metrikaRaw) ? Number(metrikaRaw) : null;
const gaId = /^[A-Za-z0-9-]{4,32}$/.test(gaRaw) ? gaRaw : null;
const gaSrc = gaId ? `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaId)}` : '';
const metrikaPixel = metrikaId ? `https://mc.yandex.ru/watch/${metrikaId}` : '';
---

{
  metrikaId && (
    <Fragment>
      <script is:inline define:vars={{ metrikaId }}>
        (function (m, e, t, r, i, k, a) {
          m[i] =
            m[i] ||
            function () {
              (m[i].a = m[i].a || []).push(arguments);
            };
          m[i].l = 1 * new Date();
          for (var j = 0; j < document.scripts.length; j++) {
            if (document.scripts[j].src === r) return;
          }
          k = e.createElement(t);
          a = e.getElementsByTagName(t)[0];
          k.async = 1;
          k.src = r;
          a.parentNode.insertBefore(k, a);
        })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
        ym(metrikaId, 'init', {
          clickmap: true,
          trackLinks: true,
          accurateTrackBounce: true,
          webvisor: false,
        });
      </script>
      <noscript>
        <div>
          <img src={metrikaPixel} class="absolute -left-[9999px]" alt="" />
        </div>
      </noscript>
    </Fragment>
  )
}
{
  gaId && (
    <Fragment>
      <script is:inline async src={gaSrc} />
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', gaId, { anonymize_ip: true });
      </script>
    </Fragment>
  )
}
