---
/**
 * Analytics snippets, rendered only when the ids are configured:
 *   PUBLIC_YANDEX_METRIKA_ID — Yandex Metrika counter (numeric)
 *   PUBLIC_GA_ID             — Google Analytics 4 measurement id (G-XXXXXXX)
 * Included by Landing.astro in the <head>. The app (/app/) does not include it.
 *
 * The snippets are emitted as validated strings via set:html: the ids are checked against a
 * strict pattern above, and building the markup here keeps the vendor code verbatim (the Astro
 * compiler would otherwise process it) and keeps Prettier's Astro parser happy, which cannot
 * parse a <script> body nested inside a `{cond && (…)}` expression.
 * Metrika's optional <noscript> pixel is omitted on purpose: it is an <img> and this component
 * renders inside <head>, where that markup is invalid.
 */
const metrikaRaw = (import.meta.env.PUBLIC_YANDEX_METRIKA_ID ?? '').trim();
const gaRaw = (import.meta.env.PUBLIC_GA_ID ?? '').trim();
const metrikaId = /^\d{4,12}$/.test(metrikaRaw) ? Number(metrikaRaw) : null;
const gaId = /^[A-Za-z0-9-]{4,32}$/.test(gaRaw) ? gaRaw : null;

const metrikaSnippet = metrikaId
  ? [
      '<script>',
      '(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};',
      'm[i].l=1*new Date();for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}',
      'k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})',
      "(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');",
      `ym(${metrikaId},'init',{clickmap:true,trackLinks:true,accurateTrackBounce:true,webvisor:false});`,
      '</script>',
    ].join('')
  : '';

const gaSnippet = gaId
  ? [
      `<script async src="https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaId)}"></script>`,
      '<script>',
      'window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}',
      `gtag('js',new Date());gtag('config',${JSON.stringify(gaId)},{anonymize_ip:true});`,
      '</script>',
    ].join('')
  : '';
---

{metrikaSnippet && <Fragment set:html={metrikaSnippet} />}
{gaSnippet && <Fragment set:html={gaSnippet} />}
