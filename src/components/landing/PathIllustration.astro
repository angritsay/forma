---
/**
 * The course path drawn with CSS/SVG from real course nodes (the first block of five).
 * Illustrative state: first node done, second up next, the third open, the rest locked.
 *
 * Drawn the way the owner's prototype draws the path (design/ui_kits/app-v2, «Путь»;
 * design/CHANGELOG.md §10): a banner in the programme colour naming the week and counting the
 * sessions «1/5»; the sessions as circles — done is filled in the colour and ticked, today is filled in
 * paper with its number, an open day is outlined, a locked one dimmed — each with its name and one
 * muted line beside it. The squares, the progress bar and the «Прогресс · 17%» kicker it replaces
 * said the same in a smaller voice; the colour used to paint the bar and one numeral, and now it
 * paints the banner and the done stops, which is the prototype's «обложка и прогресс».
 *
 * Without a course in scope there is no programme colour, and the banner and the done stop fall
 * back to paper on ink — the same fallback `.hero-art` makes for a tile without a course.
 */
import type { CourseNode, Locale } from '@/content/schema';
import { l, t } from '@/i18n/index';
import { courseTileStyle } from '@/lib/ui/tile';
import { nodeKindLabel } from './courseHelpers';

interface Props {
  locale: Locale;
  courseName: string;
  nodes: CourseNode[];
  /** Programme colour of the course (content stores the hex). */
  tile?: string;
}
const { locale, courseName, nodes, tile } = Astro.props;

/*
 * Five, because a block of the beginner course is five workouts. It was six, which drew a banner
 * reading «Неделя 1» over a sixth stop belonging to week 2 — invisible while the path still had
 * rest nodes padding each week to seven, and wrong the moment it stopped.
 */
const shown = nodes.slice(0, 5);
const positions = [
  { x: 60, y: 40 },
  { x: 120, y: 110 },
  { x: 180, y: 180 },
  { x: 120, y: 250 },
  { x: 60, y: 320 },
];
const path = positions
  .slice(0, shown.length)
  .map((p, i) => {
    if (i === 0) return `M${p.x} ${p.y}`;
    const prev = positions[i - 1]!;
    return `C${prev.x} ${prev.y + 35} ${p.x} ${p.y - 35} ${p.x} ${p.y}`;
  })
  .join(' ');
const height = (positions[shown.length - 1]?.y ?? 40) + 40;

type State = 'done' | 'current' | 'open' | 'locked';
function stateOf(i: number): State {
  return i === 0 ? 'done' : i === 1 ? 'current' : i === 2 ? 'open' : 'locked';
}
const fill = tile ? 'bg-course text-on-course' : 'bg-paper text-ink';
const stateCls: Record<State, string> = {
  done: fill,
  current: 'bg-paper text-ink',
  open: 'border border-border-strong text-text',
  locked: 'border border-border text-muted-2',
};
const stateLabel: Record<State, string> = {
  done: t(locale, 'landing.pathNodeDone'),
  current: t(locale, 'landing.pathNodeCurrent'),
  open: t(locale, 'landing.pathNodeOpen'),
  locked: t(locale, 'landing.pathNodeLocked'),
};
const week = shown[0]?.week ?? 1;
const done = shown.filter((_, i) => stateOf(i) === 'done').length;
---

<div style={tile ? courseTileStyle(tile) : undefined}>
  <!-- The week's banner: the one large field the colour is allowed, as in the prototype. -->
  <div class:list={['flex items-baseline justify-between gap-3 px-4 py-3', fill]}>
    <span class="eyebrow text-[10px] text-current">
      {t(locale, 'landing.courseWeek', { n: week })}
    </span>
    <span class="numeral tabular text-sm" aria-label={courseName}>
      {done}/{shown.length}
    </span>
  </div>

  <div class="relative mx-auto mt-2 w-[240px]" style={`height:${height}px`}>
    <svg
      class="absolute inset-0"
      viewBox={`0 0 240 ${height}`}
      width="240"
      height={height}
      aria-hidden="true"
    >
      <path
        d={path}
        fill="none"
        stroke="currentColor"
        class="text-border-strong"
        stroke-width="2"
        stroke-dasharray="2 6"
        stroke-linecap="butt"></path>
    </svg>
    <ol class="absolute inset-0 m-0 list-none p-0">
      {
        shown.map((node, i) => {
          const pos = positions[i]!;
          const state = stateOf(i);
          const labelLeft = pos.x > 120;
          return (
            <li
              class="absolute flex items-center gap-2.5"
              style={`top:${pos.y - 22}px; ${labelLeft ? `right:${240 - pos.x - 22}px; flex-direction:row-reverse;` : `left:${pos.x - 22}px;`}`}
            >
              <span
                class={`numeral flex size-11 shrink-0 items-center justify-center rounded-pill text-sm ${stateCls[state]}`}
                title={stateLabel[state]}
              >
                {state === 'done' ? (
                  <span class="glyph text-base" aria-hidden="true">
                    ✓
                  </span>
                ) : (
                  String(node.day).padStart(2, '0')
                )}
              </span>
              <span
                class={`flex max-w-[120px] flex-col ${labelLeft ? 'items-end text-right' : ''}`}
              >
                <span class="text-[12px] leading-tight font-semibold">{l(node.title, locale)}</span>
                <span class="text-[10px] leading-tight text-muted">
                  {nodeKindLabel(locale, node)}
                </span>
              </span>
            </li>
          );
        })
      }
    </ol>
  </div>
</div>
