---
/**
 * The course path drawn with CSS/SVG from real course nodes (first six).
 * Illustrative state: first node done, second up next, the rest locked.
 *
 * Nodes are square, and there are no kind icons: a node shows the number of its day, the done
 * one a ✓ glyph. The one colour on the illustration is the programme colour of the course, set
 * with `courseTileStyle()` on the root — it paints the progress fill and the number of the
 * current day, and nothing else. The current node is otherwise the white fill; the done one is
 * outlined; the locked ones are a quiet surface.
 */
import type { CourseNode, Locale } from '@/content/schema';
import { l, t } from '@/i18n/index';
import { courseTileStyle } from '@/lib/ui/tile';
import { nodeKindLabel } from './courseHelpers';

interface Props {
  locale: Locale;
  courseName: string;
  nodes: CourseNode[];
  /** Programme colour of the course (content stores the hex). */
  tile?: string;
}
const { locale, courseName, nodes, tile } = Astro.props;

const shown = nodes.slice(0, 6);
const positions = [
  { x: 60, y: 40 },
  { x: 120, y: 110 },
  { x: 180, y: 180 },
  { x: 120, y: 250 },
  { x: 60, y: 320 },
  { x: 120, y: 390 },
];
const path = positions
  .slice(0, shown.length)
  .map((p, i) => {
    if (i === 0) return `M${p.x} ${p.y}`;
    const prev = positions[i - 1]!;
    return `C${prev.x} ${prev.y + 35} ${p.x} ${p.y - 35} ${p.x} ${p.y}`;
  })
  .join(' ');
const height = (positions[shown.length - 1]?.y ?? 40) + 40;

type State = 'done' | 'current' | 'locked';
function stateOf(i: number): State {
  return i === 0 ? 'done' : i === 1 ? 'current' : 'locked';
}
const stateCls: Record<State, string> = {
  done: 'border border-border-strong bg-surface-2 text-text',
  current: 'bg-primary text-on-primary',
  locked: 'border border-border bg-surface text-muted-2',
};
const stateLabel: Record<State, string> = {
  done: t(locale, 'landing.pathNodeDone'),
  current: t(locale, 'landing.pathNodeCurrent'),
  locked: t(locale, 'landing.pathNodeLocked'),
};
const doneShare = shown.length ? Math.round((1 / shown.length) * 100) : 0;
---

<div style={tile ? courseTileStyle(tile) : undefined}>
  <div class="px-4 pt-3 pb-4">
    <div class="flex items-baseline justify-between gap-2">
      <span class="font-display text-sm">{courseName}</span>
      <span class="eyebrow text-[10px]">{t(locale, 'landing.pathProgress')} · {doneShare}%</span>
    </div>
    <!-- 4px, square; the fill is the programme colour, or white when no course is in scope. -->
    <div class="mt-3 h-1 w-full overflow-hidden bg-surface-3" aria-hidden="true">
      <div
        class="h-full"
        style={`width:${doneShare}%;background:var(--course-tile, var(--primary))`}
      >
      </div>
    </div>
  </div>

  <div class="relative mx-auto w-[240px]" style={`height:${height}px`}>
    <svg
      class="absolute inset-0"
      viewBox={`0 0 240 ${height}`}
      width="240"
      height={height}
      aria-hidden="true"
    >
      <path
        d={path}
        fill="none"
        stroke="currentColor"
        class="text-border-strong"
        stroke-width="2"
        stroke-dasharray="2 6"
        stroke-linecap="butt"></path>
    </svg>
    <ol class="absolute inset-0 m-0 list-none p-0">
      {
        shown.map((node, i) => {
          const pos = positions[i]!;
          const state = stateOf(i);
          const labelLeft = pos.x > 120;
          return (
            <li
              class="absolute flex items-center gap-2"
              style={`top:${pos.y - 22}px; ${labelLeft ? `right:${240 - pos.x - 22}px; flex-direction:row-reverse;` : `left:${pos.x - 22}px;`}`}
            >
              <span
                class={`numeral flex size-11 shrink-0 items-center justify-center text-sm ${stateCls[state]}`}
                title={stateLabel[state]}
              >
                {state === 'done' ? (
                  <span class="glyph text-base" aria-hidden="true">
                    ✓
                  </span>
                ) : (
                  String(node.day).padStart(2, '0')
                )}
              </span>
              <span
                class={`flex max-w-[120px] flex-col ${labelLeft ? 'items-end text-right' : ''}`}
              >
                <span class="text-[12px] leading-tight font-semibold">{l(node.title, locale)}</span>
                <span class="text-[10px] leading-tight text-muted">
                  {nodeKindLabel(locale, node)}
                </span>
              </span>
            </li>
          );
        })
      }
    </ol>
  </div>
</div>
