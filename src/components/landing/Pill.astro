---
/**
 * A fact as a pill — the Astro twin of the kit's Pill (src/components/ui/Pill.tsx), kept in step
 * by hand like Button.astro is with its React original.
 *
 * Separate file rather than hydrating the React one: every pill on the site is static text, and
 * shipping React to draw «Средний» in a rounded border would undo the point of a static build.
 *
 * «4 недели», «18 мин», «Без оборудования», «Одна оплата, доступ навсегда»: a small piece of
 * information that is not a control, set in tracked capitals inside a fully rounded plaque. That
 * is the shape the owner's prototype (`design/ui_kits/app-v2`, «Программы») gives it, recorded in
 * design/CHANGELOG.md §10, and the whole distinction from `FeatureChip`, which this replaced on
 * the selling pages: a chip sits on the 12px control radius because a chip is pressed or selected,
 * and a course's facts are read. The filter row on the courses hub keeps its chips for exactly
 * that reason — those are pressed. So this never wraps a link.
 *
 * Two sizes, because a site is read from further away than a phone in the hand: `sm` is the app's
 * 28px / 10px pill and the default, `md` is 32px / 11px for a pill row that stands alone under a
 * headline.
 *
 * Tones follow the kit: `neutral` is a hairline and muted words; `course` puts the programme colour
 * on the border and the words — the brandbook's «цвет красит номера», so a course's own facts wear
 * its colour without the colour ever reaching a button; `course-fill` is the colour as a fill with
 * the tile's ink, for the one pill on a screen that is its point; `paper` is white on ink and
 * `ink` is ink on white — the two for a pill laid on a photograph or on a paper surface. The
 * caller is responsible for not asking for `course` on a neutral dark tile, where the colour is
 * the ground.
 *
 * Style A (global.css header) adds the palette's tags, the site's twins of the app `Pill`'s:
 * `action` is the neon — «новое», «выгоднее», the tags that ask for attention; `orange` marks the
 * beginners, `ciel` the coach; `sky` is the brand's light blue; `white` and `ghost` are the two
 * that sit on a blue hero field. Every filled tag takes the ink, #111111, which clears 4.5 on each
 * of them — on `ciel` too (4.75), where the graphite would not. `tilt` leans a tag ±5–6°, the
 * hand-placed look of the owner's mockups; use it on one or two tags in a row, not all of them.
 *
 * The neutral tones — `ghost`, `white`, `paper` — are glass (`.glass-tag`, design/CHANGELOG.md
 * §16): a frosted tint of the surface with a hairline, white words on it. `white` used to be a
 * white fill with blue words and `ghost` a bare white outline; on glass they share the material
 * and differ by the weight of the hairline, so the first fact in a row still stands out from the
 * rest. The words stay `--on-field`: white on the tint clears 4.5 over the blue field at the
 * sheerest alpha the class uses. The coloured tones stay solid, because their colour is their
 * meaning (§15) and a translucent neon is no longer the neon.
 *
 * The height is a minimum, not a fixed 28px, and the words wrap rather than truncate. The longest
 * equipment name in the library — «Тумба или устойчивая ступенька» — is nine pixels wider than an
 * exercise row's text column on a 390px phone, and a pill that reads «Тумба или устойчивая сту…»
 * is a fact the reader cannot use. Two lines in the pill costs ten pixels of row height and says
 * the whole thing.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'span'> {
  tone?:
    | 'neutral'
    | 'course'
    | 'course-fill'
    | 'paper'
    | 'ink'
    | 'action'
    | 'orange'
    | 'ciel'
    | 'sky'
    | 'white'
    | 'ghost';
  size?: 'sm' | 'md';
  /** Lean the tag: `left` −6°, `right` +5°. */
  tilt?: 'left' | 'right';
  /** `li` inside a list of facts, `span` (default) inline. */
  as?: 'span' | 'li';
}

const TONE = {
  neutral: 'border-border-strong text-muted',
  course: 'border-course-accent/60 text-course-accent',
  'course-fill': 'border-transparent bg-course text-tile-fg',
  paper: 'glass-tag border-paper/40 text-paper',
  ink: 'border-transparent bg-ink/85 text-paper',
  action: 'border-transparent bg-action text-on-action',
  orange: 'border-transparent bg-orange text-ink',
  ciel: 'border-transparent bg-ciel text-ink',
  sky: 'border-transparent bg-accent text-on-accent',
  white: 'glass-tag border-on-field/80 text-on-field',
  ghost: 'glass-tag border-on-field/40 text-on-field',
} as const;

const TILT = { left: '-rotate-6', right: 'rotate-5' } as const;

const SIZE = {
  sm: 'min-h-8 px-3 py-1 text-[13px]',
  md: 'min-h-9 px-3.5 py-1.5 text-[14px]',
} as const;

const {
  tone = 'neutral',
  size = 'sm',
  tilt,
  as: Tag = 'span',
  class: className = '',
  ...rest
} = Astro.props;
---

<!--
  `max-w-full min-w-0` and no `shrink-0`: in a row the pill gives way and its words wrap onto a
  second line, so a long fact can never push the price beside it off the screen — the trap
  design/CHANGELOG.md §9 records.
-->
<Tag
  class:list={[
    'control-label inline-flex max-w-full min-w-0 items-center gap-1.5 rounded-pill border leading-[1.3]',
    SIZE[size],
    TONE[tone],
    tilt && TILT[tilt],
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
