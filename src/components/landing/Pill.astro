---
/**
 * A fact as a pill — the Astro twin of the kit's Pill (src/components/ui/Pill.tsx), kept in step
 * by hand like Button.astro is with its React original.
 *
 * «4 недели», «18 мин», «Без оборудования», «Одна оплата, доступ навсегда»: a small piece of
 * information that is not a control, set in tracked capitals inside a fully rounded plaque. That
 * is the shape the owner's prototype (`design/ui_kits/app-v2`, «Программы») gives it, and the
 * whole distinction from `FeatureChip`, which this replaced on the selling pages: a chip sits on
 * the 12px control radius because a chip is pressed or selected, and a course's facts are read.
 * The filter row on the courses hub keeps its chips for exactly that reason — those are pressed.
 *
 * Two sizes, because a site is read from further away than a phone in the hand: `sm` is the app's
 * 28px / 10px pill, `md` is 32px / 11px for a pill row that stands alone under a headline.
 *
 * Tones follow the kit: `neutral` is a hairline and muted words; `course` puts the programme colour
 * on the border and the words — the brandbook's «цвет красит номера», so a course's own facts wear
 * its colour without the colour ever reaching a button; `course-fill` is the colour as a fill with
 * the tile's ink, for the one pill on a screen that is its point; `paper` is white on ink and
 * `ink` is ink on white — the two for a pill laid on a photograph or on a paper surface.
 */
interface Props {
  tone?: 'neutral' | 'course' | 'course-fill' | 'paper' | 'ink';
  size?: 'sm' | 'md';
  class?: string;
}
const { tone = 'neutral', size = 'md', class: extra = '' } = Astro.props;
const tones = {
  neutral: 'border-border-strong text-muted',
  course: 'border-course/60 text-course',
  'course-fill': 'border-transparent bg-course text-on-course',
  paper: 'border-transparent bg-paper text-ink',
  ink: 'border-transparent bg-ink/85 text-paper',
};
const sizes = {
  sm: 'h-7 px-3 text-[10px]',
  md: 'h-8 px-3.5 text-[11px]',
};
---

<!--
  `max-w-full min-w-0` and no `shrink-0`: in a row the pill gives way and its words ellipsise, so a
  long fact can never push the price beside it off the screen — the trap CHANGELOG §9 records.
-->
<span
  class={`control-label inline-flex max-w-full min-w-0 items-center gap-1.5 rounded-pill border whitespace-nowrap ${sizes[size]} ${tones[tone]} ${extra}`}
>
  <span class="truncate"><slot /></span>
</span>
