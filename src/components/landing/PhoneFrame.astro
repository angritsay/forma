---
/**
 * Phone frame for app-like tiles on the landing: a rounded bezel with a hairline, no shadow.
 *
 * It was square-cornered while the brandbook said «0px везде»; CHANGELOG §8 brought the radii back
 * for anything that is genuinely a discrete object, and a phone is the most discrete object on the
 * page. Concentric: the bezel is `--r-card` and the screen inside it `--r-inner`, which is the
 * outer radius minus the bezel's padding — the rule §8 gives for a nested radius.
 */
interface Props {
  class?: string;
  /** Accessible description of what the screen shows. */
  label?: string;
}
const { class: extra = '', label } = Astro.props;
---

<div
  class={`relative mx-auto w-[280px] max-w-full rounded-card border border-border-strong bg-surface-2 p-2 ${extra}`}
  role={label ? 'img' : undefined}
  aria-label={label}
>
  <div class="relative overflow-hidden rounded-inner border border-border bg-bg">
    <div class="mx-auto mt-2 h-1 w-16 rounded-pill bg-surface-3" aria-hidden="true"></div>
    <slot />
  </div>
</div>
