---
/**
 * Phone frame for app-like tiles on the landing: a square with a hairline bezel. No radius, no
 * shadow — the brandbook has one shape, and a rounded, shadowed phone would be the only rounded
 * thing on the page.
 */
interface Props {
  class?: string;
  /** Accessible description of what the screen shows. */
  label?: string;
}
const { class: extra = '', label } = Astro.props;
---

<div
  class={`relative mx-auto w-[280px] max-w-full border border-border-strong bg-surface-2 p-2 ${extra}`}
  role={label ? 'img' : undefined}
  aria-label={label}
>
  <div class="relative overflow-hidden border border-border bg-bg">
    <div class="mx-auto mt-2 h-1 w-16 bg-surface-3" aria-hidden="true"></div>
    <slot />
  </div>
</div>
