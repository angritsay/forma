---
/**
 * One band that sells the subscription next to the courses: the price, what it covers, a link.
 * Framed by a hairline above and below rather than boxed, with the included items as a
 * hairline-separated list — no bullets, no dots.
 */
import type { Locale } from '@/content/schema';
import { l, t } from '@/i18n/index';
import { href } from '@/lib/util/paths';
import { PLAN_BY_ID, PLAN_INCLUDES, PLANS_ENABLED } from '@content/site/plans';
import { formatPrice } from '@content/site/pricing';
import Button from './Button.astro';

interface Props {
  locale: Locale;
  class?: string;
}
const { locale, class: extra = '' } = Astro.props;
const monthly = PLAN_BY_ID.get('monthly');
const annual = PLAN_BY_ID.get('annual');
---

{
  PLANS_ENABLED && monthly && annual && (
    <div
      class={`grid gap-8 border-y border-border py-8 md:grid-cols-[minmax(0,1fr)_auto] md:items-end md:py-10 ${extra}`}
    >
      <div>
        <p class="eyebrow">{t(locale, 'landing.subscribeEyebrow')}</p>
        <h3 class="font-display mt-3 text-2xl text-balance md:text-3xl">
          {t(locale, 'landing.subscribeTitle')}
        </h3>
        <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
          {PLAN_INCLUDES.map((x, i) => (
            <li class="flex items-baseline gap-3">
              <span class="numeral text-xs text-muted-2" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              {l(x, locale)}
            </li>
          ))}
        </ul>
      </div>
      <div class="flex flex-col items-start gap-3 md:items-end md:text-right">
        <p class="tabular">
          <span class="numeral text-3xl">{formatPrice(locale, monthly.price)}</span>
          <span class="text-sm text-muted"> {t(locale, 'landing.subscribePerMonth')}</span>
        </p>
        <p class="text-sm text-muted">
          {formatPrice(locale, annual.price)} {t(locale, 'landing.subscribePerYear')} ·{' '}
          {l(annual.note, locale)}
        </p>
        <Button href={href(locale, '/subscribe/')}>
          {t(locale, 'landing.navSubscribe')}{' '}
          <span class="glyph" aria-hidden="true">
            →
          </span>
        </Button>
      </div>
    </div>
  )
}
