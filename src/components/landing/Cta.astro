---
/**
 * Final call-to-action band.
 *
 * The closing argument, set left over a hairline rather than centred inside a filled panel.
 * Centred text in a bordered box is the shape of every SaaS footer CTA; the page's last word
 * reads better in the same column everything above it was read in. Nothing glows — the only
 * emphasis is the weight of the type and the neon button, the section's one action (Style A).
 */
import Button from './Button.astro';

interface Props {
  title: string;
  text: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
  /** Marks on the primary (`data-goal`, `data-app-link`), passed to the `Button`. */
  primaryData?: Record<`data-${string}`, string | boolean>;
}
const { title, text, primary, secondary, primaryData = {} } = Astro.props;
---

<section class="mx-auto max-w-6xl px-5 py-8 md:py-12">
  <div class="border-t border-border pt-12 md:pt-16">
    <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-8">
      <div class="max-w-3xl">
        <h2 class="font-display text-4xl text-balance md:text-5xl">{title}</h2>
        <p class="mt-5 max-w-xl text-lg text-muted">{text}</p>
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <Button href={primary.href} size="lg" {...primaryData}>{primary.label}</Button>
        {
          secondary && (
            <Button href={secondary.href} variant="secondary" size="lg">
              {secondary.label}
            </Button>
          )
        }
        {/* Anything else the band offers beside the buttons — the homepage's share button. */}
        <slot name="actions" />
      </div>
    </div>
    {
      /* An optional foot: a line of small print and, from `lg`, the QR code (the homepage). */
      Astro.slots.has('default') && (
        <div class="mt-8">
          <slot />
        </div>
      )
    }
  </div>
</section>
