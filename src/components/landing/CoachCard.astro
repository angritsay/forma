---
/**
 * Coach profile from content/site/coach.ts — renders only the fields that are filled in.
 *
 * The photograph is monochrome with grain, 4:5, with the lockup running vertically down its edge
 * on wide screens — the same frame the design system's landing gives the coach. Links are quiet
 * outlined labels; the one filled button is the booking, and only when booking is on.
 */
import type { Locale } from '@/content/schema';
import { l, t } from '@/i18n/index';
import { appHref, withBase } from '@/lib/util/paths';
import { BOOKING } from '@content/site/booking';
import { COACH } from '@content/site/coach';
import { formatPrice } from '@content/site/pricing';
import Button from './Button.astro';

interface Props {
  locale: Locale;
  /** Compact = home section; full = /about hero. */
  variant?: 'compact' | 'full';
  moreHref?: string;
}
const { locale, variant = 'compact', moreHref } = Astro.props;
const name = l(COACH.name, locale);
const role = l(COACH.role, locale);
const bio = l(COACH.bio, locale);
const initial = name.trim().charAt(0).toUpperCase();
const bookHint = t(locale, 'landing.coachBookHint', {
  duration: BOOKING.durationMin,
  price: formatPrice(locale, BOOKING.price),
});
---

<div
  class={`grid items-start gap-8 ${variant === 'full' ? 'md:grid-cols-[280px_minmax(0,1fr)] md:gap-14' : 'md:grid-cols-[240px_minmax(0,1fr)] md:gap-12'}`}
>
  <div class="relative w-40 md:w-full">
    {
      COACH.photo ? (
        <div class="relative aspect-[4/5] overflow-hidden bg-surface">
          <img
            src={withBase(COACH.photo)}
            alt={name}
            width={variant === 'full' ? 280 : 240}
            height={variant === 'full' ? 350 : 300}
            class="photo-mono absolute inset-0 size-full object-cover"
            loading="lazy"
          />
          <div class="photo-grain" aria-hidden="true" />
        </div>
      ) : (
        <div class="hero-art flex aspect-[4/5] items-center justify-center" aria-hidden="true">
          <span class="display text-6xl">{initial}</span>
        </div>
      )
    }
    <span class="eyebrow kicker-vertical absolute top-1 -left-5 hidden md:block" aria-hidden="true">
      FORMA // {name}
    </span>
  </div>
  <div>
    <p class="eyebrow">{role}</p>
    {
      variant === 'full' ? (
        <h1 class="display mt-3 text-4xl md:text-5xl">{name}</h1>
      ) : (
        <h3 class="font-display mt-3 text-2xl md:text-3xl">{name}</h3>
      )
    }
    {bio && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{bio}</p>}
    {
      COACH.credentials.length > 0 && (
        <div class="mt-6 border-t border-border pt-5">
          <p class="eyebrow-sentence">{t(locale, 'landing.coachCredentials')}</p>
          <ul class="mt-3 flex flex-col divide-y divide-border text-sm text-muted">
            {COACH.credentials.map((c, i) => (
              <li class="flex items-baseline gap-4 py-2">
                <span class="numeral text-xs text-muted-2" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                {l(c, locale)}
              </li>
            ))}
          </ul>
        </div>
      )
    }
    {
      COACH.links.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-2">
          {COACH.links.map((x) => (
            <li>
              <a
                href={x.url}
                rel="me noopener"
                class="control-label inline-flex h-10 items-center rounded-control border border-border-strong px-4 text-[12px] text-muted transition-colors duration-150 hover:bg-surface-2 hover:text-text"
              >
                {x.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {
      BOOKING.enabled && (
        <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2">
          <Button href={appHref('#/book')}>{t(locale, 'landing.coachBook')}</Button>
          <span class="text-sm text-muted">{bookHint}</span>
        </div>
      )
    }
    {
      moreHref && (
        <a
          href={moreHref}
          class="control-label mt-6 inline-flex min-h-11 items-center gap-2 text-[12px] text-text hover:opacity-85"
        >
          {t(locale, 'landing.coachMore')}
          <span class="glyph" aria-hidden="true">
            →
          </span>
        </a>
      )
    }
  </div>
</div>
