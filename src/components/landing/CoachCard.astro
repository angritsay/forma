---
/** Coach profile from content/site/coach.ts — renders only the fields that are filled in. */
import type { Locale } from '@/content/schema';
import { l, t } from '@/i18n/index';
import { appHref, withBase } from '@/lib/util/paths';
import { BOOKING } from '@content/site/booking';
import { COACH } from '@content/site/coach';
import { formatPrice } from '@content/site/pricing';
import Button from './Button.astro';

interface Props {
  locale: Locale;
  /** Compact = home section; full = /about hero. */
  variant?: 'compact' | 'full';
  moreHref?: string;
}
const { locale, variant = 'compact', moreHref } = Astro.props;
const name = l(COACH.name, locale);
const role = l(COACH.role, locale);
const bio = l(COACH.bio, locale);
const initial = name.trim().charAt(0).toUpperCase();
const bookHint = t(locale, 'landing.coachBookHint', {
  duration: BOOKING.durationMin,
  price: formatPrice(locale, BOOKING.price),
});
---

<div
  class={`grid items-start gap-8 ${variant === 'full' ? 'md:grid-cols-[240px_minmax(0,1fr)]' : 'md:grid-cols-[200px_minmax(0,1fr)]'}`}
>
  {
    COACH.photo ? (
      <img
        src={withBase(COACH.photo)}
        alt={name}
        width={variant === 'full' ? 200 : 160}
        height={variant === 'full' ? 200 : 160}
        class="photo-mono aspect-[4/5] w-40 object-cover md:w-full"
        loading="lazy"
      />
    ) : (
      <div
        class="hero-art flex aspect-[4/5] w-40 items-center justify-center md:w-full"
        aria-hidden="true"
      >
        <span class="font-display text-6xl">{initial}</span>
      </div>
    )
  }
  <div>
    <p class="eyebrow">{role}</p>
    {
      variant === 'full' ? (
        <h1 class="font-display mt-2 text-4xl md:text-5xl">{name}</h1>
      ) : (
        <h3 class="font-display mt-2 text-3xl md:text-4xl">{name}</h3>
      )
    }
    {bio && <p class="mt-4 max-w-2xl leading-relaxed text-muted">{bio}</p>}
    {
      COACH.credentials.length > 0 && (
        <div class="mt-5">
          <p class="eyebrow">{t(locale, 'landing.coachCredentials')}</p>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-muted">
            {COACH.credentials.map((c) => (
              <li>{l(c, locale)}</li>
            ))}
          </ul>
        </div>
      )
    }
    {
      COACH.links.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2">
          {COACH.links.map((x) => (
            <li>
              <a
                href={x.url}
                rel="me noopener"
                class="control-label inline-flex min-h-11 items-center rounded-control border border-border px-4 text-[11px] text-muted hover:border-text hover:text-text"
              >
                {x.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {
      BOOKING.enabled && (
        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2">
          <Button href={appHref('#/book')}>{t(locale, 'landing.coachBook')}</Button>
          <span class="text-sm text-muted">{bookHint}</span>
        </div>
      )
    }
    {
      moreHref && (
        <a
          href={moreHref}
          class="mt-4 inline-flex min-h-11 items-center gap-1 text-sm font-semibold underline decoration-border-strong underline-offset-4 hover:text-accent"
        >
          {t(locale, 'landing.coachMore')} →
        </a>
      )
    }
  </div>
</div>
