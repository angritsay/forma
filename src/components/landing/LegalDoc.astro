---
/**
 * Renders a bilingual legal document (legal.ts) with a table of contents.
 *
 * A quiet reading frame: the date of the last change as a pill (a fact, not a control), the
 * title as the display line, the description under it, then the contents as a numbered hairline
 * list — not a boxed panel — and the sections carrying the same numerals so a reader can find
 * their way back. Nothing here is louder than the text it frames.
 */
import Pill from '@/components/landing/Pill.astro';
import type { Locale } from '@/content/schema';
import { formatDate, l, t } from '@/i18n/index';
import type { LegalDocument } from './legal';

interface Props {
  locale: Locale;
  title: string;
  intro?: string;
  doc: LegalDocument;
  updatedAt: string;
}
const { locale, title, intro, doc, updatedAt } = Astro.props;
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<article class="mx-auto max-w-3xl px-5 py-12 md:py-20">
  <Pill>{t(locale, 'landing.legalUpdated', { date: formatDate(locale, updatedAt, 'long') })}</Pill>
  <h1 class="display mt-5 text-3xl text-balance md:text-5xl">{title}</h1>
  {intro && <p class="mt-5 text-[15px] leading-relaxed text-muted md:text-base">{intro}</p>}

  <nav aria-label={t(locale, 'landing.legalContents')} class="mt-10 border-t border-border pt-5">
    <p class="eyebrow">{t(locale, 'landing.legalContents')}</p>
    <ol class="mt-3 grid gap-x-8 text-sm sm:grid-cols-2">
      {
        doc.sections.map((s, i) => (
          <li class="flex items-baseline gap-3 border-b border-border py-2">
            <span class="numeral tabular w-5 shrink-0 text-xs text-muted-2" aria-hidden="true">
              {num(i)}
            </span>
            <a href={`#${s.id}`} class="text-muted hover:text-text">
              {l(s.heading, locale)}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="mt-12 flex flex-col gap-12">
    {
      doc.sections.map((s, i) => (
        <section id={s.id} class="scroll-mt-24 border-t border-border pt-6">
          <h2 class="display flex items-baseline gap-4 text-base md:text-lg">
            <span class="numeral tabular w-6 shrink-0 text-sm text-muted" aria-hidden="true">
              {num(i)}
            </span>
            {l(s.heading, locale)}
          </h2>
          {s.paragraphs?.map((p) => (
            <p class="mt-4 text-[15px] leading-relaxed text-muted">{l(p, locale)}</p>
          ))}
          {s.bullets && (
            <ul class="mt-4 list-disc space-y-2 pl-5 text-[15px] leading-relaxed text-muted marker:text-muted-2">
              {s.bullets.map((b) => (
                <li>{l(b, locale)}</li>
              ))}
            </ul>
          )}
          {s.after?.map((p) => (
            <p class="mt-4 text-[15px] leading-relaxed text-muted">{l(p, locale)}</p>
          ))}
        </section>
      ))
    }
  </div>
</article>
