---
/** Renders a bilingual legal document (legal.ts) with a table of contents. */
import type { Locale } from '@/content/schema';
import { formatDate, l, t } from '@/i18n/index';
import type { LegalDocument } from './legal';

interface Props {
  locale: Locale;
  title: string;
  intro?: string;
  doc: LegalDocument;
  updatedAt: string;
}
const { locale, title, intro, doc, updatedAt } = Astro.props;
---

<article class="mx-auto max-w-3xl px-5 py-12 md:py-20">
  <p class="text-xs font-semibold tracking-[0.2em] text-muted uppercase">
    {t(locale, 'landing.legalUpdated', { date: formatDate(locale, updatedAt, 'long') })}
  </p>
  <h1 class="font-display mt-3 text-4xl text-balance md:text-5xl">{title}</h1>
  {intro && <p class="mt-4 text-lg leading-relaxed text-muted">{intro}</p>}

  <nav
    aria-label={t(locale, 'landing.legalContents')}
    class="mt-8 rounded-card border border-border bg-surface p-5"
  >
    <p class="text-sm font-semibold">{t(locale, 'landing.legalContents')}</p>
    <ol class="mt-2 grid gap-1 text-sm text-muted sm:grid-cols-2">
      {
        doc.sections.map((s) => (
          <li>
            <a href={`#${s.id}`} class="hover:text-text">
              {l(s.heading, locale)}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="mt-10 flex flex-col gap-10">
    {
      doc.sections.map((s) => (
        <section id={s.id} class="scroll-mt-24">
          <h2 class="text-xl font-semibold">{l(s.heading, locale)}</h2>
          {s.paragraphs?.map((p) => (
            <p class="mt-3 leading-relaxed text-muted">{l(p, locale)}</p>
          ))}
          {s.bullets && (
            <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed text-muted marker:text-muted-2">
              {s.bullets.map((b) => (
                <li>{l(b, locale)}</li>
              ))}
            </ul>
          )}
          {s.after?.map((p) => (
            <p class="mt-3 leading-relaxed text-muted">{l(p, locale)}</p>
          ))}
        </section>
      ))
    }
  </div>
</article>
