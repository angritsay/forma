---
/**
 * Home hero: value proposition, two CTAs, feature chips and the coach's photograph.
 *
 * The tile used to hold a drawn figure on a mint-to-lavender gradient. Against a dark landing
 * selling a real person's coaching it read as clipart, and a photograph of the coach does the
 * selling that an illustration cannot. `photo` therefore wins when it is set; the animated
 * figure stays as the fallback so the hero still renders before a usable photograph exists.
 *
 * The composition is editorial rather than centred: a 7/5 grid instead of a balanced split, the
 * columns aligned on their baselines rather than their middles, and the photograph running past
 * the page gutter with a vertical label down its outer margin.
 */
import ExerciseFigure from '@/components/anim/ExerciseFigure';
import Button from './Button.astro';
import FeatureChip from './FeatureChip.astro';

interface Props {
  title: string;
  subtitle: string;
  primary: { label: string; href: string };
  secondary: { label: string; href: string };
  chips: string[];
  figure: { animation: string; label: string };
  /** The coach, photographed. Takes precedence over `figure`. */
  photo?: { src: string; alt: string };
  tileTop: string;
  tileBottom: string;
}

const { title, subtitle, primary, secondary, chips, figure, photo, tileTop, tileBottom } =
  Astro.props;
---

<section
  class="mx-auto grid max-w-6xl items-end gap-10 px-5 pt-10 pb-16 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:gap-14 md:pt-20 md:pb-24"
>
  <div>
    <p class="eyebrow">{tileTop}</p>
    <h1 class="font-display mt-5 text-[clamp(1.75rem,7vw,2.75rem)] text-balance">
      {title}
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">{subtitle}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href={primary.href} size="lg">{primary.label}</Button>
      <Button href={secondary.href} variant="secondary" size="lg">{secondary.label}</Button>
    </div>
    <ul class="mt-8 flex flex-wrap gap-2">
      {
        chips.map((c) => (
          <li>
            <FeatureChip>{c}</FeatureChip>
          </li>
        ))
      }
    </ul>
  </div>

  <!--
    `-mr-5` on the phone, `md:-mr-10` above it: the photograph runs past the page gutter instead of
    sitting inside a rounded, shadowed card. Square corners, monochrome, grain — a photograph is
    the one element in this system allowed to reach the edge of the page, and rounding it would
    turn it straight back into the tile this hero used to be.
  -->
  <div class="relative -mr-5 md:-mr-10">
    <div
      class:list={[
        'relative flex aspect-[4/5] w-full items-center justify-center overflow-hidden',
        photo ? '' : 'hero-art',
      ]}
    >
      {
        photo ? (
          <>
            <img
              src={photo.src}
              alt={photo.alt}
              width="900"
              height="1125"
              fetchpriority="high"
              decoding="async"
              class="photo-mono absolute inset-0 size-full object-cover"
            />
            <div class="photo-grain" aria-hidden="true" />
            <div class="photo-scrim" aria-hidden="true" />
            <span class="eyebrow absolute right-5 bottom-5 text-white/80">{tileBottom}</span>
          </>
        ) : (
          <ExerciseFigure
            client:visible
            animation={figure.animation}
            variant="hero"
            label={figure.label}
          />
        )
      }
    </div>
    <span class="eyebrow kicker-vertical absolute -left-5 top-1 hidden md:block" aria-hidden="true">
      {tileTop}
    </span>
  </div>
</section>
