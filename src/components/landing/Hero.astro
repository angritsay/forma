---
/**
 * Home hero: the one big line, one line under it, the facts as pills, one button — over a
 * full-bleed monochrome photograph.
 *
 * On the phone this is the owner's prototype's «Программы» screen (`design/ui_kits/app-v2`): the
 * photograph *is* the screen, the type sits low on it over a scrim, and the facts that used to be
 * a paragraph («Пожизненный доступ, видео к каждому упражнению, нагрузка растёт вместе с тобой»)
 * are a row of pills. Her rule for this round was «МИНИМУМ текста, максимум визуала»; a hero that
 * gave the photograph the bottom half of the first screen and three lines of body copy the top was
 * the old ratio.
 *
 * From `md` the composition returns to the editorial 7/5 grid the landing already had: columns
 * aligned on their baselines, the photograph running past the page gutter with a vertical kicker
 * down its outer margin. That layout works and was not the complaint; what changed on it is the
 * same as on the phone — one line of copy, pills instead of chips, the plate with the brand's
 * formula gone (the «Внутри тренировки» section says it as its headline).
 *
 * The headline is the brand's main typographic device — two weights in one line, 800 and 200:
 * «КРОССФИТ ДОМА, который подстраивается под тебя». The copy is not touched; the split falls at
 * the first comma, or after the first two words when there is none, and `thin` overrides it.
 *
 * `photo` wins when it is set; a frame from the named movement's clip stands in, so the hero still
 * renders before a usable photograph exists.
 *
 * Style A (global.css header): the words stand in the blue hero field — the page's one — white,
 * the headline's last two words («под тебя», «to you») in the brand's light blue over the swoosh.
 * The field is opaque, so on the phone the photograph behind it no longer has to be darkened into
 * ground for the type to read; it shows above the field instead. The first fact pill is white and
 * leans, the rest are white hairlines. The primary button is the page's neon and stands under the
 * field, on charcoal, as in the owner's mockup.
 */
import ExerciseStill from '@/components/media/ExerciseStill';
import Button from './Button.astro';
import HeroField from './HeroField.astro';
import KeyTitle from './KeyTitle.astro';
import Pill from './Pill.astro';

interface Props {
  title: string;
  /** The part of `title` set at weight 200. Derived from the title when omitted. */
  thin?: string;
  subtitle: string;
  primary: { label: string; href: string };
  /** Shown from `md` only: the phone gets one button, and the app is one tap away in the menu. */
  secondary?: { label: string; href: string };
  /** Facts, as pills. */
  chips: string[];
  /** Movement whose still stands in for the photograph. */
  figure: { exerciseId: string };
  /** The coach, photographed. Takes precedence over `figure`. */
  photo?: { src: string; alt: string };
  /** The kicker over the headline and down the photograph's edge. */
  tileTop: string;
}

const { title, subtitle, primary, secondary, chips, figure, photo, tileTop } = Astro.props;

/** Where the heavy half of the headline ends: at the first comma, else after two words. */
function thinFrom(text: string, thin?: string): string | undefined {
  if (thin && text.indexOf(thin) > 0) return thin;
  const comma = text.indexOf(',');
  if (comma > 0) return text.slice(comma + 1);
  const words = text.split(' ');
  if (words.length < 3) return undefined;
  return ' ' + words.slice(2).join(' ');
}
const thin = thinFrom(title, Astro.props.thin);
/*
 * A second pill leans the other way, but only a short one: a tilt lifts a pill's far end by
 * about a tenth of its width, and a long fact leaning 5° runs into the row under it.
 */
const rightTilt = chips.findIndex((c, i) => i > 0 && c.length <= 14);
---

<!--
  `isolate` + the photograph at `-z-10`: on the phone the picture is absolutely positioned behind
  the type inside this section's own stacking context, so it can never slide under the page or over
  the glass header. `overflow-x-clip` is load-bearing (not `hidden`, which would make this a scroll
  container and stop the sticky header): from `md` the photograph bleeds past the gutter with a
  negative right margin, and between 768 and 1152 there is no slack beside the container for it to
  bleed into — 1044px of scroll width in a 1024px window, measured, before the clip.

  `min-h-[86svh]` on the phone: the first screen is the photograph with the type at its foot, and
  the 14% left over is the top of the next section showing — the hint that there is one.
-->
<section
  class="relative isolate mx-auto flex min-h-[86svh] max-w-6xl flex-col justify-end overflow-x-clip px-5 pt-10 pb-12 md:grid md:min-h-0 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:items-end md:gap-14 md:pt-20 md:pb-28"
>
  <div class="relative z-10">
    <HeroField>
      <p class="eyebrow">{tileTop}</p>
      <KeyTitle
        text={title}
        keyWords={2}
        thin={thin}
        class="display mt-4 max-w-[16ch] text-[clamp(1.75rem,7vw,2.75rem)]"
      />
      <p class="field-lead mt-5 max-w-xl text-base leading-relaxed md:text-lg">{subtitle}</p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {
          chips.map((c, i) => (
            <li class="flex max-w-full">
              <Pill
                size="md"
                tone={i === 0 ? 'white' : 'ghost'}
                tilt={i === 0 ? 'left' : i === rightTilt ? 'right' : undefined}
              >
                {c}
              </Pill>
            </li>
          ))
        }
      </ul>
    </HeroField>
    <div class="mt-5 flex flex-wrap items-center gap-3">
      <Button href={primary.href} size="lg" class="w-full sm:w-auto">{primary.label}</Button>
      {
        secondary && (
          <Button href={secondary.href} variant="secondary" size="lg" class="max-md:hidden">
            {secondary.label}
          </Button>
        )
      }
    </div>
  </div>

  <!--
    The photograph. Absolute and full-bleed on the phone; a 4:5 frame in the second column from
    `md`, with `-mr-10` running it past the gutter. Square corners, monochrome, grain — a photograph
    is the one element in this system allowed to reach the edge of the page, and rounding it would
    turn it straight back into a tile.
  -->
  <div class="absolute inset-0 -z-10 md:relative md:inset-auto md:z-0 md:-mr-10">
    <div
      class:list={[
        'relative h-full w-full overflow-hidden md:aspect-[4/5] md:h-auto',
        photo ? 'bg-surface' : 'hero-art',
      ]}
    >
      {
        photo ? (
          <>
            {/*
              `object-[35%_30%]` on the phone: the frame is 3:4 and the screen behind the type is
              taller than that, so the sides are cropped — and the coach stands a third of the way
              in from the left, which a centred crop would cut through.
            */}
            <img
              src={photo.src}
              alt={photo.alt}
              width="900"
              height="1125"
              fetchpriority="high"
              decoding="async"
              class="photo-mono absolute inset-0 size-full object-cover object-[35%_30%] md:object-center"
            />
            <div class="photo-grain" aria-hidden="true" />
            <div class="photo-scrim" aria-hidden="true" />
            {/*
              A second, page-coloured scrim for the phone only, where the field stands on the
              picture: the field is opaque and needs no protection, but the photograph has to run
              out into charcoal under it, so the button beneath the field stands on the ground.
            */}
            <div
              class="absolute inset-0 bg-linear-to-t from-bg via-bg/80 via-45% to-transparent md:hidden"
              aria-hidden="true"
            />
          </>
        ) : (
          <div class="absolute inset-0 flex items-center justify-center">
            <ExerciseStill exerciseId={figure.exerciseId} loading="eager" />
          </div>
        )
      }
    </div>
    <span class="eyebrow kicker-vertical absolute top-1 -left-5 hidden md:block" aria-hidden="true">
      {tileTop}
    </span>
  </div>
</section>
