---
/**
 * Home hero: the one big line, one line under it, the facts as pills, one button — over a
 * full-bleed monochrome photograph.
 *
 * On the phone this is the owner's prototype's «Программы» screen (`design/ui_kits/app-v2`): the
 * photograph *is* the screen, the type sits low on it over a scrim, and the facts that used to be
 * a paragraph («Пожизненный доступ, видео к каждому упражнению, нагрузка растёт вместе с тобой»)
 * are a row of pills. Her rule for this round was «МИНИМУМ текста, максимум визуала»; a hero that
 * gave the photograph the bottom half of the first screen and three lines of body copy the top was
 * the old ratio.
 *
 * From `md` the words and the picture split the width evenly (6/6) and stretch to one height, so
 * the photograph is never smaller than the field and the form beside it; it runs past the page
 * gutter. The kicker is said once, over the headline (the vertical copy down the picture's edge is
 * gone). On the phone the first screen keeps to the headline, the first pill and the form: the lead
 * and the other pills appear from `sm`, where they no longer push the button below the fold.
 *
 * The headline is the brand's main typographic device — two weights in one line, 800 and 200:
 * «КРОССФИТ ДОМА. Первая тренировка — сегодня». The copy is not touched; the split falls at
 * the first comma, or after the first two words when there is none, and `thin` overrides it.
 *
 * The picture is a silent loop of the coach doing one filmed movement (`LoopVideo`), with his
 * photograph as the poster: that is what shows before the clip plays, under reduced motion or data
 * saver, and whenever there is no clip at all. The lead is one line, the pills three at most.
 *
 * Style A (global.css header): the words stand in the blue hero field — the page's one — white,
 * the headline's last `keyWords` words («сегодня», «today») in the brand's light blue over the swoosh.
 * The field is opaque, so on the phone the photograph behind it no longer has to be darkened into
 * ground for the type to read; it shows above the field instead. The first fact pill is white and
 * leans, the rest are white hairlines. The primary button is the page's neon and stands under the
 * field, on charcoal, as in the owner's mockup.
 */
import HeroField from './HeroField.astro';
import KeyTitle from './KeyTitle.astro';
import Pill from './Pill.astro';
import LoopVideo from './media/LoopVideo.astro';

interface Props {
  title: string;
  /** The part of `title` set at weight 200. Derived from the title when omitted. */
  thin?: string;
  /** How many trailing words are the light-blue key word over the swoosh. */
  keyWords?: number;
  /** One line under the headline. */
  lead: string;
  /** Facts, as pills — three at most. */
  chips: string[];
  /** Which pill leans right (+5°). Defaults to the first short one after the first. */
  tiltRight?: number;
  /** The filmed movement that loops, the photograph that stands until it plays, and its alt. */
  loop: { id: string; poster: string; alt?: string };
  /** The kicker over the headline. */
  tileTop: string;
}

const { title, keyWords = 2, lead, chips, loop, tileTop } = Astro.props;

/** Where the heavy half of the headline ends: at the first comma, else after two words. */
function thinFrom(text: string, thin?: string): string | undefined {
  if (thin && text.indexOf(thin) > 0) return thin;
  const comma = text.indexOf(',');
  if (comma > 0) return text.slice(comma + 1);
  const words = text.split(' ');
  if (words.length < 3) return undefined;
  return ' ' + words.slice(2).join(' ');
}
const thin = thinFrom(title, Astro.props.thin);
/*
 * A second pill leans the other way, but only a short one: a tilt lifts a pill's far end by
 * about a tenth of its width, and a long fact leaning 5° runs into the row under it.
 */
const rightTilt = Astro.props.tiltRight ?? chips.findIndex((c, i) => i > 0 && c.length <= 14);
---

<!--
  `isolate`: the picture and the words stack inside this section's own context, so the picture can
  never slide over the glass header. On the phone the picture comes first (`order-first`), a band
  about half the screen tall, and the words rise into its foot; the field is opaque, so it needs no
  protection there. `overflow-x-clip` is load-bearing (not `hidden`, which would make this a scroll
  container and stop the sticky header): from `md` the photograph bleeds past the gutter with a
  negative right margin, and between 768 and 1152 there is no slack beside the container for it to
  bleed into — 1044px of scroll width in a 1024px window, measured, before the clip.
-->
<section
  class="relative isolate mx-auto flex max-w-6xl flex-col overflow-x-clip px-5 pb-10 md:grid md:grid-cols-[minmax(0,6fr)_minmax(0,6fr)] md:items-stretch md:gap-12 md:pt-16 md:pb-12"
>
  <div class="relative z-10 -mt-28 md:mt-0 md:self-end">
    <HeroField>
      <p class="eyebrow">{tileTop}</p>
      <KeyTitle
        text={title}
        keyWords={keyWords}
        thin={thin}
        class="display mt-4 max-w-[16ch] text-[clamp(1.75rem,7vw,2.75rem)]"
      />
      <p class="field-lead mt-5 max-w-xl text-base leading-snug max-sm:hidden md:text-lg">
        {lead}
      </p>
      <ul class="mt-5 flex flex-wrap gap-2 sm:mt-6">
        {
          chips.map((c, i) => (
            <li class:list={['flex max-w-full', i > 0 && 'max-sm:hidden']}>
              <Pill
                size="md"
                tone={i === 0 ? 'white' : 'ghost'}
                tilt={i === 0 ? 'left' : i === rightTilt ? 'right' : undefined}
              >
                {c}
              </Pill>
            </li>
          ))
        }
      </ul>
    </HeroField>
    {
      /* The page's action — the homepage's email form — and the quiet row under it. */
      Astro.slots.has('action') && (
        <div class="mt-5">
          <slot name="action" />
        </div>
      )
    }
    <slot name="after" />
  </div>

  <!--
    The picture. On the phone a full-width band over the top of the screen that the field rises
    into (`-mt-28` on the words), fading to the ground at its foot; a 4:5 frame in the second
    column from `md`, with `-mr-10` running it past the gutter. Square corners, monochrome, grain — a photograph is
    the one element in this system allowed to reach the edge of the page.
  -->
  <div
    class="relative order-first -mx-5 h-[48svh] min-h-80 md:order-none md:mx-0 md:h-auto md:-mr-10"
  >
    <div class="relative h-full w-full overflow-hidden bg-surface md:min-h-full md:aspect-[4/5]">
      {
        /*
        `object-[35%_30%]` on the phone: the screen behind the type is taller than the frame, so
        the sides are cropped — and the coach stands a third of the way in from the left.
      */
      }
      <LoopVideo
        id={loop.id}
        poster={loop.poster}
        alt={loop.alt}
        eager
        class="object-[35%_30%] md:object-center"
      />
      <div class="photo-grain" aria-hidden="true"></div>
      <div class="photo-scrim" aria-hidden="true"></div>
      {
        /*
        A page-coloured scrim for the phone only, where the field stands on the picture: it runs
        out into the ground under the field, so the form beneath stands on graphite.
      */
      }
      <div
        class="absolute inset-0 bg-linear-to-t from-bg via-bg/30 via-35% to-transparent md:hidden"
        aria-hidden="true"
      >
      </div>
    </div>
  </div>
</section>
