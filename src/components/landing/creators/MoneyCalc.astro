---
/**
 * `/creators/`'s money calculator: move the sliders, see the month that lands in the creator's
 * account. It replaces two worked formulas set in display type, which said the same thing in more
 * words.
 *
 * **The prices are real**, read where the business keeps them: the course's price, the club's
 * 30-day plan, the coach's hour (`BOOKING`). **The counts are the visitor's**: the sliders start at
 * round illustrative numbers and nothing on the page claims anyone sells that many. The
 * processor's fee is a slider too, because it depends on the creator's own Prodamus / lava.top
 * tariff; the default is only a starting point.
 *
 * The arithmetic is the deal stated on the page: the fee comes off first, then Forma's share —
 * 20% of course and club, 10% of sessions — and the rest is the creator's.
 *
 * The script is self-contained (no imports, so nothing reaches the site bundle — `bundle.test.ts`)
 * and the numbers it needs ride on `data-*`. Without it, the result shows the defaults' month,
 * computed at build time, so the block still says something true.
 */
import type { Locale } from '@/content/schema';
import { t } from '@/i18n/index';

interface Props {
  locale: Locale;
  /** Whole currency units in the visitor's currency. */
  coursePrice: number;
  clubPrice: number;
  hourPrice: number;
  currency: string;
}

const { locale, coursePrice, clubPrice, hourPrice, currency } = Astro.props;
const k = (key: string, params?: Record<string, string | number>) =>
  t(locale, `landing.${key}` as 'landing.creatorsH1', params);

const intl = locale === 'ru' ? 'ru-RU' : 'en-US';
const money = (n: number) =>
  new Intl.NumberFormat(intl, { style: 'currency', currency, maximumFractionDigits: 0 }).format(n);

const FEE = 5;
const rows = [
  {
    id: 'course',
    label: k('creatorsCalcCourse'),
    price: coursePrice,
    share: 0.8,
    max: 200,
    value: 20,
  },
  { id: 'club', label: k('creatorsCalcClub'), price: clubPrice, share: 0.8, max: 500, value: 60 },
  {
    id: 'sessions',
    label: k('creatorsCalcSessions'),
    price: hourPrice,
    share: 0.9,
    max: 60,
    value: 8,
  },
].filter((r) => r.price > 0);

const yours = (r: (typeof rows)[number], count: number, fee: number) =>
  count * r.price * (1 - fee / 100) * r.share;
const total = rows.reduce((sum, r) => sum + yours(r, r.value, FEE), 0);
---

<div
  class="calc grid bg-surface gap-8 rounded-card border border-border p-6 md:p-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-12"
  data-locale={intl}
  data-currency={currency}
>
  <div class="flex flex-col gap-6">
    <h3 class="font-display text-2xl leading-tight md:text-3xl">{k('creatorsCalcTitle')}</h3>
    {
      rows.map((r) => (
        <label class="flex flex-col gap-2">
          <span class="flex items-baseline justify-between gap-3">
            <span class="text-[15px]">
              {r.label}{' '}
              <span class="text-muted">{k('creatorsCalcEach', { price: money(r.price) })}</span>
            </span>
            <output class="numeral text-xl text-accent" data-out={r.id}>
              {r.value}
            </output>
          </span>
          <input
            type="range"
            min="0"
            max={r.max}
            step="1"
            value={r.value}
            data-row={r.id}
            data-price={r.price}
            data-share={r.share}
          />
        </label>
      ))
    }
    <label class="flex flex-col gap-2">
      <span class="flex items-baseline justify-between gap-3">
        <span class="text-[15px] text-muted">{k('creatorsCalcFee')}</span>
        <output class="numeral text-base text-muted" data-out="fee">{FEE}%</output>
      </span>
      <input type="range" min="0" max="10" step="0.5" value={FEE} data-fee />
    </label>
  </div>

  <div class="flex flex-col justify-between gap-6 rounded-tile bg-accent p-6 text-on-accent md:p-8">
    <div>
      <p class="text-[15px] opacity-75">{k('creatorsCalcResult')}</p>
      <p
        class="numeral mt-2 text-[clamp(2.5rem,9vw,4.5rem)] leading-none tracking-tight"
        data-total
      >
        {money(total)}
      </p>
    </div>
    <p class="text-[13px] leading-snug opacity-75">{k('creatorsCalcNote')}</p>
  </div>
</div>

<style>
  .calc input[type='range'] {
    width: 100%;
    accent-color: var(--accent);
    cursor: pointer;
  }
</style>

<script>
  for (const calc of document.querySelectorAll<HTMLElement>('.calc')) {
    const fmt = new Intl.NumberFormat(calc.dataset.locale, {
      style: 'currency',
      currency: calc.dataset.currency,
      maximumFractionDigits: 0,
    });
    const rows = [...calc.querySelectorAll<HTMLInputElement>('input[data-row]')];
    const fee = calc.querySelector<HTMLInputElement>('input[data-fee]');
    const total = calc.querySelector<HTMLElement>('[data-total]');
    const update = () => {
      const f = Number(fee?.value ?? 0);
      let sum = 0;
      for (const r of rows) {
        const n = Number(r.value);
        sum += n * Number(r.dataset.price) * (1 - f / 100) * Number(r.dataset.share);
        const out = calc.querySelector(`[data-out="${r.dataset.row}"]`);
        if (out) out.textContent = String(n);
      }
      const feeOut = calc.querySelector('[data-out="fee"]');
      if (feeOut) feeOut.textContent = `${f}%`;
      if (total) total.textContent = fmt.format(sum);
    };
    calc.addEventListener('input', update);
  }
</script>
