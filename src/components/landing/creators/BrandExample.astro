---
/**
 * One made-up creator brand (content/site/creator-examples.ts) wearing the product: their site on
 * their domain, the app on a phone and on a computer, and a line from their bot. Everything is
 * painted from the brand's own palette and typeface through scoped custom properties, so the two
 * examples side by side read as two different businesses — and neither shows Forma.
 *
 * The mocks are pictures (`aria-hidden`); the list underneath carries the same information as text.
 */
import Pill from '@/components/landing/Pill.astro';
import type { CreatorExample } from '@content/site/creator-examples';
import type { Locale } from '@/content/schema';
import { l, t } from '@/i18n/index';

interface Props {
  example: CreatorExample;
  locale: Locale;
}

const { example: e, locale } = Astro.props;
const k = (key: string) => t(locale, `landing.${key}` as 'landing.creatorsH1');
const th = e.theme;
const vars = [
  `--bx-ground:${th.ground}`,
  `--bx-surface:${th.surface}`,
  `--bx-ink:${th.ink}`,
  `--bx-muted:${th.muted}`,
  `--bx-accent:${th.accent}`,
  `--bx-accent-ink:${th.accentInk}`,
  `--bx-font:${th.font}`,
  `--bx-case:${th.upper ? 'uppercase' : 'none'}`,
].join(';');
const moves = e.workout.moves.map((m) => l(m, locale));
---

<article
  class="glass-card flex min-w-0 flex-col gap-5 rounded-card border border-border p-4 md:p-6"
>
  <header class="flex flex-wrap items-center justify-between gap-2">
    <div class="flex items-center gap-2">
      <Pill tone="neutral">{l(e.kind, locale)}</Pill>
      <Pill tone="ghost">{k('creatorsExampleTag')}</Pill>
    </div>
    <ul class="flex gap-1.5" aria-hidden="true">
      {
        [th.ground, th.surface, th.accent, th.ink].map((c) => (
          <li class="size-5 rounded-full border border-border" style={`background:${c}`} />
        ))
      }
    </ul>
  </header>

  <div class="bx flex flex-col gap-3" style={vars} aria-hidden="true">
    <!-- the site, on their domain -->
    <div class="bx-frame">
      <div class="bx-bar">
        <span class="bx-dots"><i></i><i></i><i></i></span>
        <span class="bx-url">{e.domain}</span>
      </div>
      <div class="bx-site">
        <span class="bx-brand">{e.brand}</span>
        <span class="bx-headline">{l(e.siteLine, locale)}</span>
        <span class="bx-btn">{l(e.siteCta, locale)}</span>
      </div>
    </div>

    <div class="grid grid-cols-[minmax(0,4fr)_minmax(0,6fr)] gap-3">
      <!-- the app, on a phone -->
      <div class="bx-phone">
        <span class="bx-brand bx-brand-sm">{e.brand}</span>
        <span class="bx-card">
          <span class="bx-title">{l(e.workout.title, locale)}</span>
          <span class="bx-meta">{l(e.workout.meta, locale)}</span>
          {moves.map((m) => <span class="bx-move">{m}</span>)}
        </span>
        <span class="bx-btn bx-btn-block">▶</span>
      </div>

      <div class="flex min-w-0 flex-col gap-3">
        <!-- the same app, on a computer -->
        <div class="bx-frame">
          <div class="bx-bar">
            <span class="bx-dots"><i></i><i></i><i></i></span>
            <span class="bx-url">app.{e.domain}</span>
          </div>
          <div class="bx-desk">
            <span class="bx-side">
              <span class="bx-brand bx-brand-sm">{e.brand}</span>
              <i></i><i></i><i></i>
            </span>
            <span class="bx-card">
              <span class="bx-title">{l(e.workout.title, locale)}</span>
              <span class="bx-meta">{l(e.workout.meta, locale)}</span>
            </span>
          </div>
        </div>

        <!-- their bot -->
        <div class="bx-chat">
          <span class="bx-bot">{e.bot}</span>
          <span class="bx-bubble">{l(e.botLine, locale)}</span>
        </div>
      </div>
    </div>
  </div>

  <div>
    <h3 class="eyebrow">{k('creatorsExampleTuned')} · {e.brand}</h3>
    <ul class="mt-3 flex flex-col divide-y divide-border border-y border-border">
      {
        e.tuned.map((x) => (
          <li class="flex items-baseline gap-3 py-2.5 text-[15px] leading-snug">
            <span class="glyph text-accent" aria-hidden="true">
              ›
            </span>
            {l(x, locale)}
          </li>
        ))
      }
    </ul>
  </div>
</article>

<style>
  .bx {
    font-family: var(--bx-font);
    color: var(--bx-ink);
  }
  .bx-frame {
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--bx-ink) 14%, transparent);
    background: var(--bx-ground);
  }
  .bx-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    background: var(--bx-surface);
    border-bottom: 1px solid color-mix(in srgb, var(--bx-ink) 10%, transparent);
  }
  .bx-dots {
    display: flex;
    gap: 4px;
  }
  .bx-dots i {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bx-ink) 25%, transparent);
  }
  .bx-url {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: 10px;
    color: var(--bx-muted);
  }
  .bx-site {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 18px 16px 20px;
  }
  .bx-brand {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: var(--bx-case);
    color: var(--bx-accent);
  }
  .bx-brand-sm {
    font-size: 10px;
  }
  .bx-headline {
    max-width: 18ch;
    font-size: clamp(1.25rem, 5vw, 1.75rem);
    line-height: 1.05;
    text-transform: var(--bx-case);
    text-wrap: balance;
  }
  .bx-btn {
    display: inline-flex;
    justify-content: center;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--bx-accent);
    color: var(--bx-accent-ink);
    font-size: 11px;
    text-transform: var(--bx-case);
  }
  .bx-btn-block {
    margin-top: auto;
  }
  .bx-phone {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 8px;
    padding: 12px 8px 10px;
    border-radius: 22px;
    border: 3px solid color-mix(in srgb, var(--bx-ink) 22%, transparent);
    background: var(--bx-ground);
  }
  .bx-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 4px;
    padding: 8px;
    border-radius: 10px;
    background: var(--bx-surface);
  }
  .bx-title {
    font-size: 13px;
    line-height: 1.1;
    text-transform: var(--bx-case);
  }
  .bx-meta {
    font-size: 10px;
    color: var(--bx-accent);
  }
  .bx-move {
    font-size: 10px;
    line-height: 1.25;
    color: var(--bx-muted);
  }
  .bx-desk {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 5fr);
    gap: 8px;
    padding: 8px;
  }
  .bx-side {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 5px;
  }
  .bx-side i {
    height: 5px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bx-ink) 16%, transparent);
  }
  .bx-chat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px;
    border-radius: 14px;
    background: #e9eef3;
    color: #1d2733;
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      sans-serif;
  }
  .bx-bot {
    font-size: 10px;
    font-weight: 600;
    color: #2a7ab8;
  }
  .bx-bubble {
    align-self: flex-start;
    padding: 6px 9px;
    border-radius: 12px 12px 12px 4px;
    background: #fff;
    font-size: 11px;
    line-height: 1.3;
  }
</style>
