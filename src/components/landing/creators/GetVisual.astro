---
/**
 * The small picture on each «Что у тебя будет» card on `/creators/`: what the creator ends up
 * with, drawn rather than named — their bot's chat, their site in a browser on their domain, the
 * app on a phone and a computer, the two store badges.
 *
 * White-label by construction: the brand, the bot and the domain are placeholders («твой бренд»,
 * «tvoy_bot», «tvoy-domen.ru»), never Forma. A picture (`aria-hidden`); the card's title and line
 * carry the text. Light blue for what is the creator's, no neon (the page keeps it for the hero).
 */
import type { Locale } from '@/content/schema';
import { t } from '@/i18n/index';

interface Props {
  kind: 'bot' | 'site' | 'app' | 'stores';
  locale: Locale;
  /** The app screen's workout title, e.g. «Тренировка 1». */
  workout?: string;
}

const { kind, locale, workout = '' } = Astro.props;
const k = (key: string) => t(locale, `landing.${key}` as 'landing.creatorsH1');
const brand = k('creatorsGetMockBrand');
const domain = k('creatorsGetMockDomain');
---

<div class="gv" aria-hidden="true">
  {
    kind === 'bot' && (
      <div class="flex h-full flex-col justify-end gap-1.5">
        <span class="flex items-center gap-2 text-[11px] text-muted">
          <span class="gv-avatar">{brand.slice(0, 1)}</span>@{k('creatorsMockBot')}
        </span>
        <span class="gv-bubble">{k('creatorsGetMockBotLine')}</span>
        <span class="gv-bubble gv-bubble-me">{k('creatorsMockBot2')}</span>
      </div>
    )
  }
  {
    kind === 'site' && (
      <div class="gv-frame h-full">
        <span class="gv-bar">
          <i />
          <i />
          <i />
          <span class="gv-url">{domain}</span>
        </span>
        <span class="flex flex-1 flex-col items-start justify-center gap-1.5 px-3">
          <span class="text-[10px] tracking-wide text-accent">{brand}</span>
          <span class="font-display text-[15px] leading-tight">{k('creatorsGetMockSiteLine')}</span>
          <span class="gv-btn">{k('creatorsGetMockBuy')}</span>
        </span>
      </div>
    )
  }
  {
    kind === 'app' && (
      <div class="flex h-full items-end gap-2">
        <span class="gv-frame flex-1 self-stretch">
          <span class="gv-bar">
            <i />
            <i />
            <i />
            <span class="gv-url">app.{domain}</span>
          </span>
          <span class="flex flex-1 gap-2 p-2">
            <span class="flex w-6 flex-col gap-1">
              <i class="gv-line" />
              <i class="gv-line" />
              <i class="gv-line" />
            </span>
            <span class="gv-card flex-1">
              <span class="truncate text-[10px]">{workout}</span>
              <i class="gv-line w-2/3" />
            </span>
          </span>
        </span>
        <span class="gv-phone">
          <span class="truncate text-[9px] text-accent">{brand}</span>
          <span class="gv-card">
            <span class="truncate text-[9px]">{workout}</span>
          </span>
          <span class="gv-btn gv-btn-block">▶</span>
        </span>
      </div>
    )
  }
  {
    kind === 'stores' && (
      <div class="flex h-full flex-col items-start justify-center gap-2">
        <span class="gv-badge">
          <span class="text-[9px] text-muted">Download on the</span>
          <span class="font-display text-[14px] leading-none">App Store</span>
        </span>
        <span class="gv-badge">
          <span class="text-[9px] text-muted">Get it on</span>
          <span class="font-display text-[14px] leading-none">Google Play</span>
        </span>
      </div>
    )
  }
</div>

<style>
  .gv {
    height: 7.5rem;
  }
  .gv-frame {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--r-inner);
    border: 1px solid var(--border-strong);
    background: var(--bg);
  }
  .gv-bar {
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 5px 8px;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }
  .gv-bar i {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--surface-3);
  }
  .gv-url {
    min-width: 0;
    margin-left: 6px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 9px;
    color: var(--muted-2);
  }
  .gv-btn {
    display: inline-flex;
    justify-content: center;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 10px;
    font-weight: 600;
  }
  .gv-btn-block {
    align-self: stretch;
  }
  .gv-avatar {
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 10px;
    font-weight: 700;
  }
  .gv-bubble {
    align-self: flex-start;
    max-width: 90%;
    padding: 6px 10px;
    border-radius: 12px 12px 12px 3px;
    background: var(--surface-3);
    font-size: 12px;
    line-height: 1.3;
  }
  .gv-bubble-me {
    align-self: flex-end;
    border-radius: 12px 12px 3px 12px;
    background: var(--accent);
    color: var(--on-accent);
  }
  .gv-phone {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 4.25rem;
    height: 100%;
    padding: 8px 6px;
    border-radius: 14px;
    border: 1px solid var(--border-strong);
    background: var(--bg);
  }
  .gv-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 4px;
    padding: 6px;
    border-radius: 6px;
    background: var(--surface-2);
  }
  .gv-line {
    display: block;
    height: 4px;
    border-radius: 999px;
    background: var(--surface-3);
  }
  .gv-badge {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 8.5rem;
    padding: 7px 12px;
    border-radius: 10px;
    border: 1px solid var(--border-strong);
    background: var(--bg);
  }
</style>
