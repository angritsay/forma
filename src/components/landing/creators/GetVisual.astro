---
/**
 * The small picture on each «Что у тебя будет» card on `/creators/`: what the creator ends up
 * with, drawn rather than named — their bot's chat, their site in a browser on their domain, the
 * app on a phone and a computer, the two store badges.
 *
 * White-label by construction: the brand, the bot and the domain are placeholders («твой бренд»,
 * «tvoy_bot», «tvoy-domen.ru»), never Forma. A picture (`aria-hidden`); the card's title and line
 * carry the text. Light blue for what is the creator's, no neon (the page keeps it for the hero).
 */
import type { Locale } from '@/content/schema';
import { t } from '@/i18n/index';

interface Props {
  kind: 'bot' | 'site' | 'app' | 'stores';
  locale: Locale;
  /** The app screen's workout title, e.g. «Тренировка 1». */
  workout?: string;
  /** A base-resolved photo for the bot's card, the site's hero and the app's tile. */
  photo?: string;
}

const { kind, locale, workout = '', photo } = Astro.props;
const k = (key: string) => t(locale, `landing.${key}` as 'landing.creatorsH1');
const brand = k('creatorsGetMockBrand');
const domain = k('creatorsGetMockDomain');
---

<div class="gv" aria-hidden="true">
  {
    kind === 'bot' && (
      <div class="flex h-full flex-col justify-end gap-1.5">
        <span class="flex items-center gap-2 text-[11px] text-muted">
          <span class="gv-avatar">{brand.slice(0, 1)}</span>@{k('creatorsMockBot')}
        </span>
        <span class="gv-bubble gv-bubble-photo">
          {photo && <img src={photo} alt="" loading="lazy" decoding="async" />}
          <span class="block px-2.5 py-1.5">{k('creatorsGetMockBotLine')}</span>
        </span>
        <span class="gv-bubble gv-bubble-me">{k('creatorsMockBot2')}</span>
      </div>
    )
  }
  {
    kind === 'site' && (
      <div class="gv-frame h-full">
        <span class="gv-bar">
          <i />
          <i />
          <i />
          <span class="gv-url">{domain}</span>
        </span>
        <span
          class="gv-hero flex flex-1 flex-col items-start justify-end gap-1.5 px-3 pb-3"
          style={photo ? `background-image:url('${photo}')` : undefined}
        >
          <span class="text-[10px] tracking-wide text-accent">{brand}</span>
          <span class="font-display text-[15px] leading-tight">{k('creatorsGetMockSiteLine')}</span>
          <span class="gv-btn">{k('creatorsGetMockBuy')}</span>
        </span>
      </div>
    )
  }
  {
    kind === 'app' && (
      <div class="flex h-full items-end gap-2">
        <span class="gv-frame flex-1 self-stretch">
          <span class="gv-bar">
            <i />
            <i />
            <i />
            <span class="gv-url">app.{domain}</span>
          </span>
          <span class="flex flex-1 gap-2 p-2">
            <span class="flex w-6 flex-col gap-1">
              <i class="gv-line" />
              <i class="gv-line" />
              <i class="gv-line" />
            </span>
            <span class="gv-card flex-1">
              <span class="truncate text-[10px]">{workout}</span>
              <i class="gv-line w-2/3" />
            </span>
          </span>
        </span>
        <span class="gv-phone">
          <span class="truncate text-[9px] text-accent">{brand}</span>
          {photo && <img class="gv-thumb" src={photo} alt="" loading="lazy" decoding="async" />}
          <span class="truncate text-[9px]">{workout}</span>
          <span class="gv-btn gv-btn-block">▶</span>
        </span>
      </div>
    )
  }
  {
    kind === 'stores' && (
      <div class="flex h-full items-center gap-4">
        <span class="gv-icon">{brand.slice(0, 1)}</span>
        <span class="flex flex-col gap-2">
          <span class="gv-badge -rotate-3">
            <span class="text-[9px] opacity-70">Download on the</span>
            <span class="font-display text-[15px] leading-none">App Store</span>
          </span>
          <span class="gv-badge rotate-2">
            <span class="text-[9px] opacity-70">Get it on</span>
            <span class="font-display text-[15px] leading-none">Google Play</span>
          </span>
        </span>
      </div>
    )
  }
</div>

<style>
  /* The picture's stage: the brand's electric blue glowing up from a corner of the surface. */
  .gv {
    height: 10rem;
    padding: 14px;
    overflow: hidden;
    border-radius: var(--r-inner);
    background:
      radial-gradient(
        110% 90% at 100% 100%,
        color-mix(in srgb, var(--field) 70%, transparent),
        transparent 65%
      ),
      radial-gradient(
        70% 60% at 0% 0%,
        color-mix(in srgb, var(--accent) 18%, transparent),
        transparent 70%
      ),
      var(--surface-2);
  }
  .gv-bubble-photo {
    padding: 0;
    overflow: hidden;
  }
  .gv-bubble-photo img {
    display: block;
    width: 100%;
    height: 54px;
    object-fit: cover;
  }
  .gv-hero {
    background-color: var(--surface-2);
    background-size: cover;
    background-position: center;
    box-shadow: inset 0 -60px 50px -10px rgba(0, 0, 0, 0.75);
  }
  .gv-thumb {
    width: 100%;
    height: 44px;
    border-radius: 6px;
    object-fit: cover;
  }
  .gv-icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 16px;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-display, inherit);
    font-size: 30px;
    font-weight: 800;
    box-shadow: 0 12px 30px -8px rgba(0, 0, 0, 0.6);
  }
  .gv-frame {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--r-inner);
    border: 1px solid var(--border-strong);
    background: var(--bg);
  }
  .gv-bar {
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 5px 8px;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }
  .gv-bar i {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--surface-3);
  }
  .gv-url {
    min-width: 0;
    margin-left: 6px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 9px;
    color: var(--muted-2);
  }
  .gv-btn {
    display: inline-flex;
    justify-content: center;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 10px;
    font-weight: 600;
  }
  .gv-btn-block {
    align-self: stretch;
  }
  .gv-avatar {
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 10px;
    font-weight: 700;
  }
  .gv-bubble {
    align-self: flex-start;
    max-width: 90%;
    padding: 6px 10px;
    border-radius: 12px 12px 12px 3px;
    background: var(--surface-3);
    font-size: 12px;
    line-height: 1.3;
  }
  .gv-bubble-me {
    align-self: flex-end;
    border-radius: 12px 12px 3px 12px;
    background: var(--accent);
    color: var(--on-accent);
  }
  .gv-phone {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 4.25rem;
    height: 100%;
    padding: 8px 6px;
    border-radius: 14px;
    border: 1px solid var(--border-strong);
    background: var(--bg);
  }
  .gv-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 4px;
    padding: 6px;
    border-radius: 6px;
    background: var(--surface-2);
  }
  .gv-line {
    display: block;
    height: 4px;
    border-radius: 999px;
    background: var(--surface-3);
  }
  .gv-badge {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 8.5rem;
    padding: 7px 12px;
    border-radius: 10px;
    background: #050505;
    color: var(--paper);
    box-shadow:
      0 0 0 1px var(--border-strong),
      0 10px 24px -8px rgba(0, 0, 0, 0.7);
  }
</style>
