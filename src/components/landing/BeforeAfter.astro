---
/**
 * Client before/after results.
 *
 * Renders nothing when there is nothing to show, so the landing never carries an empty promise:
 * pairs without both photos and a recorded consent date are filtered out in the content layer
 * (content/site/results.ts).
 *
 * Two shapes, because coaching archives hold both: a single image with the panels already joined
 * (the common case — sometimes three panels for a longer progression), or two separate files that
 * this component joins itself. Neither uses a drag divider: a slider only reads well when both
 * frames share an exact camera position, which real client photos rarely do.
 *
 * The card carries the photograph and, at most, a name and a sentence in the client's words. No
 * duration and no course name: both are performance claims that would need substantiating, and
 * the owner asked for neither. Photographs are monochrome with grain like every other photograph
 * in the product, and the «До» / «После» stamps are the same dark plate in both panels — the
 * result is in the picture, not in a highlighted label.
 *
 * Composites are declared square so the browser reserves the space before the file arrives. The
 * archive's files run from 1.000 to 0.968 of square, so the object-cover crop takes at most 1.6%
 * off the top and bottom of the tallest one — invisible on a full-body shot, and worth it to stop
 * ten lazy-loaded images shoving the page around as they land.
 */
import { publishableResults } from '@content/site/results';
import { t } from '@/i18n';
import type { Locale } from '@/i18n';
import { withBase } from '@/lib/util/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const results = publishableResults();
const STAMP =
  'absolute top-3 left-3 inline-flex h-6 items-center bg-ink/85 px-2.5 text-[11px] font-semibold uppercase tracking-[0.12em] text-paper';
---

{
  results.length > 0 && (
    <ul class="grid gap-6 sm:grid-cols-2">
      {results.map((r) => (
        <li class="overflow-hidden border border-border bg-surface">
          {r.composite ? (
            /* The panels are already joined in the file — one image, no overlaid labels, because
               where "before" sits inside the frame is the photographer's decision, not ours. */
            <div class="relative">
              <img
                src={withBase(r.composite)}
                alt={r.compositeAlt ? r.compositeAlt[locale] : ''}
                loading="lazy"
                decoding="async"
                width="1000"
                height="1000"
                class="photo-mono aspect-square w-full bg-surface-2 object-cover"
              />
              <div class="photo-grain" aria-hidden="true" />
            </div>
          ) : (
            <div class="grid grid-cols-2 gap-px bg-border">
              <figure class="relative m-0 bg-surface-2">
                <img
                  src={withBase(r.before ?? '')}
                  alt={r.beforeAlt ? r.beforeAlt[locale] : ''}
                  loading="lazy"
                  decoding="async"
                  width="400"
                  height="533"
                  class="photo-mono aspect-[3/4] w-full object-cover"
                />
                <div class="photo-grain" aria-hidden="true" />
                <figcaption class={STAMP}>{t(locale, 'landing.resultsBefore')}</figcaption>
              </figure>
              <figure class="relative m-0 bg-surface-2">
                <img
                  src={withBase(r.after ?? '')}
                  alt={r.afterAlt ? r.afterAlt[locale] : ''}
                  loading="lazy"
                  decoding="async"
                  width="400"
                  height="533"
                  class="photo-mono aspect-[3/4] w-full object-cover"
                />
                <div class="photo-grain" aria-hidden="true" />
                <figcaption class={STAMP}>{t(locale, 'landing.resultsAfter')}</figcaption>
              </figure>
            </div>
          )}
          {(r.name || r.quote) && (
            <div class="flex flex-col gap-2 border-t border-border p-5">
              {r.name && <p class="font-display text-sm">{r.name[locale]}</p>}
              {r.quote && <p class="text-[15px] leading-relaxed text-muted">{r.quote[locale]}</p>}
            </div>
          )}
        </li>
      ))}
    </ul>
  )
}
