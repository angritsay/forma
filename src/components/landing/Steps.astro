---
/** Numbered steps (how it works). */
interface Props {
  steps: { title: string; text: string }[];
  columns?: 3 | 4;
}
const { steps, columns = 3 } = Astro.props;
const cols = columns === 4 ? 'md:grid-cols-2 lg:grid-cols-4' : 'md:grid-cols-3';
---

<ol class={`grid gap-4 ${cols}`}>
  {
    steps.map((s, i) => (
      <li class="flex flex-col gap-3 rounded-card border border-border bg-surface p-6">
        <span class="font-display text-5xl text-accent" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <h3 class="text-xl font-semibold">{s.title}</h3>
        <p class="leading-relaxed text-muted">{s.text}</p>
      </li>
    ))
  }
</ol>
