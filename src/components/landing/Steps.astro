---
/**
 * Numbered steps (how it works).
 *
 * Ruled rows, not bordered cards. This block carries the brand's own "объяснили → сделали →
 * отдохнули" — three beats of one sentence — and three filled boxes side by side read as three
 * separate offers instead. A hairline above each and the numeral in the margin, and the sequence
 * reads as a sequence.
 *
 * The numeral is the biggest thing in the row — display size, above a one-line title and one
 * sentence. It used to be a small «01» over a heading over a three-sentence paragraph; the owner's
 * prototype (`design/ui_kits/app-v2`, «Сложность») sets the figure at 40px and the word at 13, and
 * the strings behind this were cut to a sentence each to match. The numerals are the brand's
 * light blue (13.2:1), not the programme colour: that marks the *current* day in the app, and
 * nothing on this page is current.
 */
interface Props {
  steps: { title: string; text: string }[];
  columns?: 3 | 4;
}
const { steps, columns = 3 } = Astro.props;
const cols = columns === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'md:grid-cols-3';
---

<ol class={`grid gap-x-8 gap-y-2 ${cols}`}>
  {
    steps.map((s, i) => (
      <li class="flex flex-col border-t border-border pt-5 pb-3">
        <span class="numeral text-4xl leading-none text-accent" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <h3 class="font-display mt-4 text-base">{s.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">{s.text}</p>
      </li>
    ))
  }
</ol>
