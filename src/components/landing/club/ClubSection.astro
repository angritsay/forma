---
/**
 * The homepage's club section, «Клуб маленьких шагов» (site synthesis §2, S5): the reason to stay,
 * in the club's own palette, drawn rather than described.
 *
 * It lives in `club/` so `site-club-no-neon.test.ts` holds it to the club's rule: no neon. The
 * one action is the warm-gradient join button, and the section is marked `data-club-zone` so the
 * phone's neon sticky bar steps aside while it is on screen.
 *
 *   header   kicker, the name as a lockup (`ClubTitle`) — no line under it; the phone says it
 *   picture  a day in the club as a still chat in a phone (`ClubDay`), beside four glyph tiles —
 *            a task a day, the streak, the weekly prize, solo or as a pair
 *   price    the figure large (`clubPriceLabels`: 666 never without the year's 7 990, EN the year
 *            only), «Автосписаний нет», the gradient join
 *   photos   the strip `clubPitchPhotos()` gives, labelled by whose photographs they are
 *            (`app.clubPhotosMembers` / `app.clubPhotosClients`) with the matching consent line
 *
 * The paragraphs that used to explain each feature, the duo rule and the bot's rhythm belong to
 * the club's own page (`/subscribe/`).
 *
 * The header copies `Section`'s hairline, kicker and number, because `Section` takes its title
 * as a string and the club's is a three-weight lockup.
 */
import type { Locale } from '@/content/schema';
import { t } from '@/i18n/index';
import { href } from '@/lib/util/paths';
import { clubPitchPhotos } from '@content/site/club';
import Button from '../Button.astro';
import IconTiles from '../IconTiles.astro';
import PhotoStrip from '../media/PhotoStrip.astro';
import ClubDay from './ClubDay.astro';
import ClubTitle from './ClubTitle.astro';
import { clubPriceLabels } from './clubPrice';

interface Props {
  locale: Locale;
  /** Section number drawn opposite the header. */
  n?: number;
  id?: string;
}
const { locale, n, id = 'club' } = Astro.props;

const club = clubPriceLabels(locale);
const tiles = [
  { kind: 'steps', label: t(locale, 'landing.clubTileTask') },
  { kind: 'flame', label: t(locale, 'landing.clubTileStreak') },
  { kind: 'trophy', label: t(locale, 'landing.clubTilePrize') },
  { kind: 'heart', label: t(locale, 'landing.clubTileDuo') },
] as const;

const { photos, source } = clubPitchPhotos();
const members = source === 'members';
const strip = photos.map((p) => ({
  src: p.src,
  alt: p.alt ? p.alt[locale] : '',
  width: 1000,
  height: 1000,
}));
---

<section
  id={id}
  data-club-zone
  class="club-aurora-host mx-auto max-w-6xl overflow-x-clip px-5 py-16"
>
  <span class="club-aurora" aria-hidden="true"></span>
  <div class="flex items-start justify-between gap-8 border-t border-border pt-8">
    <header class="max-w-2xl">
      <p class="eyebrow">{t(locale, 'landing.clubEyebrow')}</p>
      <ClubTitle locale={locale} class="mt-4" />
    </header>
    {
      n !== undefined && (
        <span class="numeral shrink-0 text-sm text-muted" aria-hidden="true">
          {String(n).padStart(2, '0')}
        </span>
      )
    }
  </div>

  <div class="mt-10 grid items-center gap-10 md:mt-12 lg:grid-cols-[320px_minmax(0,1fr)] lg:gap-14">
    <ClubDay locale={locale} class="mx-auto w-full max-w-[320px]" />

    <div class="flex flex-col gap-8">
      <IconTiles items={tiles} />
      {
        club && (
          <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
            <div class="flex flex-col gap-1.5">
              <p class="numeral text-5xl leading-none md:text-6xl">{club.headline}</p>
              <p class="text-[14px] leading-snug text-text">{club.chargeShort}</p>
              {club.chargeShort !== t(locale, 'landing.clubNoAutoRenew') && (
                <p class="text-[13px] leading-snug text-muted">
                  {t(locale, 'landing.clubNoAutoRenew')}
                </p>
              )}
            </div>
            <Button
              href={`${href(locale, '/subscribe/')}#order`}
              variant="gradient"
              size="lg"
              class="w-full sm:w-auto"
              data-club-join
              data-goal="club_join"
            >
              {club.join}
            </Button>
          </div>
        )
      }
    </div>
  </div>

  <PhotoStrip
    class="mt-12"
    photos={strip}
    label={t(locale, members ? 'app.clubPhotosMembers' : 'app.clubPhotosClients')}
    caption={t(locale, members ? 'app.clubPhotosMembersRow' : 'app.clubPhotosClientsRow')}
  />
</section>
