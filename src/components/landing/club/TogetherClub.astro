---
/**
 * `/together/`'s «Вдвоём в клубе»: what the club adds for two people, said only as far as it is
 * true (site synthesis §4, the owner's decision of 29 Sep), and drawn the way the homepage's club
 * section is — the club's own screen in a phone, the tiles, the price, the photographs.
 *
 * It lives in `club/` so `site-club-no-neon.test.ts` holds it to the club's rule: warm gradient,
 * no neon. The section is `data-club-zone`, so the phone's sticky bar steps aside over it.
 *
 *   picture  a day in the club as a still chat (`ClubDay`), beside the tiles and the price
 *   line     only `[data-with-ref]`: the visitor came with a friend's code (valid, not their own)
 *            — +30 days of the club each once they pay through this link, and one pair if
 *            neither has a pair yet (0051, 0053). Hidden in the HTML, because the static page
 *            cannot know; the page's script shows it. With no code there is no line at all.
 *   tiles    what the club is: a task a day, the streak, the weekly prize, solo or as a pair — the
 *            prize's terms are the page's second question, never «вступите вдвоём — получите час»
 *   price    `clubPriceLabels` (666 never without the year's 7 990) and the gradient join
 *            (`data-club-join`: with a pending code the layout's script sends it through the app's
 *            club screen so the code attaches before payment)
 *   photos   the strip `clubPitchPhotos()` gives, with its matching consent line
 */
import type { Locale } from '@/content/schema';
import { t } from '@/i18n/index';
import { href } from '@/lib/util/paths';
import { clubPitchPhotos } from '@content/site/club';
import Button from '../Button.astro';
import IconTiles from '../IconTiles.astro';
import PhotoStrip from '../media/PhotoStrip.astro';
import ClubDay from './ClubDay.astro';
import { clubPriceLabels } from './clubPrice';

interface Props {
  locale: Locale;
  id?: string;
}
const { locale, id = 'club' } = Astro.props;
const club = clubPriceLabels(locale);
const tiles = [
  { kind: 'steps', label: t(locale, 'landing.clubTileTask') },
  { kind: 'flame', label: t(locale, 'landing.clubTileStreak') },
  { kind: 'trophy', label: t(locale, 'landing.clubTilePrize') },
  { kind: 'heart', label: t(locale, 'landing.clubTileDuo') },
] as const;

const { photos, source } = clubPitchPhotos();
const members = source === 'members';
const strip = photos.map((p) => ({
  src: p.src,
  alt: p.alt ? p.alt[locale] : '',
  width: 1000,
  height: 1000,
}));
---

<section
  id={id}
  data-club-zone
  class="club-aurora-host mx-auto max-w-6xl overflow-x-clip px-5 py-16"
>
  <span class="club-aurora" aria-hidden="true"></span>
  <div class="border-t border-border pt-8">
    <p class="eyebrow">{t(locale, 'landing.togetherClubEyebrow')}</p>
    <h2 class="font-display mt-4 max-w-2xl text-3xl text-balance md:text-4xl">
      {t(locale, 'landing.togetherClubTitle')}
    </h2>
    <p class="mt-4 max-w-xl text-base leading-snug text-text md:text-lg" data-with-ref hidden>
      {t(locale, 'landing.togetherClubRef')}
    </p>
  </div>

  <div class="mt-10 grid items-center gap-10 lg:grid-cols-[320px_minmax(0,1fr)] lg:gap-14">
    <ClubDay locale={locale} class="mx-auto w-full max-w-[320px]" />

    <div class="flex flex-col gap-8">
      <IconTiles items={tiles} />
      {
        club && (
          <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
            <div class="flex flex-col gap-1.5">
              <p class="numeral text-5xl leading-none md:text-6xl">{club.headline}</p>
              <p class="text-[14px] leading-snug text-text">{club.chargeShort}</p>
            </div>
            <Button
              href={`${href(locale, '/subscribe/')}#order`}
              variant="gradient"
              size="lg"
              class="w-full sm:w-auto"
              data-club-join
              data-goal="club_join"
            >
              {club.join}
            </Button>
          </div>
        )
      }
    </div>
  </div>

  <PhotoStrip
    class="mt-12"
    photos={strip}
    label={t(locale, members ? 'app.clubPhotosMembers' : 'app.clubPhotosClients')}
    caption={t(locale, members ? 'app.clubPhotosMembersRow' : 'app.clubPhotosClientsRow')}
  />
</section>
