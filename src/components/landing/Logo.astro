---
/**
 * The wordmark for .astro templates — the same three spans as src/components/ui/Logo.tsx, kept
 * in step by hand. «FORMA»: FOR at 800, MA at 200, the first F stretched ×1.22. Colour is
 * inherited; size is the font-size of the wrapper.
 *
 * The mark always stands alone: the lockup with the coach's name («FORMA // Сергей Титов») is
 * retired now that Forma has more than one coach (design/CHANGELOG.md §25).
 */
interface Props {
  label?: string;
  class?: string;
}
const { label = 'Forma', class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-baseline', className]} aria-label={label}>
  <span class="wordmark inline-flex items-baseline" aria-hidden="true">
    <span class="wordmark-f">F</span><span>OR</span><span class="wordmark-thin">MA</span>
  </span>
</span>
