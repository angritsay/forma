---
/**
 * Workout 1, shown the way the app shows it, in three phones: the path with today's node, the
 * player on the first movement, and the screen after — so «бесплатно» on the page is a real thing
 * a visitor can look at before tapping.
 *
 * Every word and number is the product's own. The node's title and subtitle are the course's
 * («Тренировка 1», «По таймеру, 3 движения»); the movement, its still and its count come from
 * `start.ts` through `firstWorkoutFacts()`; the minute counter is the engine's EMOM clock; the
 * after-screen quotes the app's keys — `app.summaryFeedbackTitle` «Как зашло?»,
 * `app.summaryAdaptTitle` «В следующий раз» and `app.summaryVolumeDelta` with the engine's
 * easy-session step (`ADAPTATION.easyDelta`, +5) — the same four feeling rows the landing's
 * adaptation demo labels, the first one selected in the light blue (selection, §15).
 *
 * The phones are pictures (`role="img"` on each frame, with a label); the three movements are set
 * again under them as real links to their exercise pages, where a screen reader and a search
 * engine can follow them. Scroll-snap on a phone, a row of three from `md`.
 *
 * No neon in the pictures: the section's one neon is its CTA, outside this component. Today's node
 * is paper with ink, the free tag the light blue.
 */
import ExerciseStill from '@/components/media/ExerciseStill';
import { COURSE_BY_ID } from '@/content/registry';
import type { Locale } from '@/content/schema';
import { l, t } from '@/i18n/index';
import PhoneFrame from './PhoneFrame.astro';
import Pill from './Pill.astro';
import Ring from './Ring.astro';
import { DEMO_COURSE_ID, firstWorkoutFacts } from './demo';

interface Props {
  locale: Locale;
  class?: string;
}
const { locale, class: extra = '' } = Astro.props;

const course = COURSE_BY_ID.get(DEMO_COURSE_ID);
const facts = firstWorkoutFacts(locale, course);
const path = (course?.nodes ?? [])
  .filter((n) => n.kind === 'workout' || n.kind === 'benchmark')
  .slice(0, 5);
const first = facts?.moves[0];
const feelings = [
  t(locale, 'landing.adaptRpeEasy'),
  t(locale, 'landing.adaptRpeOk'),
  t(locale, 'landing.adaptRpeHard'),
  t(locale, 'landing.adaptRpePain'),
];
const delta = facts ? `+${facts.easyDeltaPercent}` : '';
const moveLine = (name: string, reps: number | undefined) => (reps ? `${name} · ${reps}` : name);
---

{
  facts && course && (
    <div class:list={['flex flex-col gap-6', extra]}>
      {/* Focusable below `md`, where it scrolls sideways: the phones are `role="img"`, so without
          this a keyboard user could not reach phones 2 and 3 (axe: scrollable-region-focusable). */}
      <ul
        aria-label={t(locale, 'landing.phonesLabel')}
        tabindex="0"
        class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:mx-0 md:grid md:grid-cols-3 md:overflow-visible md:px-0"
      >
        <li class="w-[280px] max-w-[85vw] shrink-0 snap-center md:w-auto md:max-w-none">
          <PhoneFrame label={`${t(locale, 'landing.phonesPath')} — ${facts.nodeTitle}`}>
            <ol class="flex flex-col gap-3 px-4 pt-4 pb-5">
              {path.map((node, i) => (
                <li class="flex items-center gap-3">
                  <span
                    class:list={[
                      'numeral flex size-11 shrink-0 items-center justify-center rounded-pill text-sm',
                      i === 0 ? 'bg-paper text-ink' : 'border border-border text-muted-2',
                    ]}
                  >
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="flex min-w-0 flex-col gap-0.5">
                    <span
                      class:list={[
                        'text-[13px] leading-tight font-semibold',
                        i > 0 && 'text-muted-2',
                      ]}
                    >
                      {l(node.title, locale)}
                      {i === 0 && (
                        <span class="font-normal text-accent">
                          {' '}
                          — {t(locale, 'landing.phonesToday')}
                        </span>
                      )}
                    </span>
                    <span class="text-[11px] leading-tight text-muted">
                      {i === 0 ? facts.nodeSubtitle : t(locale, 'landing.pathNodeLocked')}
                    </span>
                    {i === 0 && (
                      <span class="mt-1 flex">
                        <Pill tone="sky">{t(locale, 'landing.priceFree')}</Pill>
                      </span>
                    )}
                  </span>
                </li>
              ))}
            </ol>
          </PhoneFrame>
        </li>

        <li class="w-[280px] max-w-[85vw] shrink-0 snap-center md:w-auto md:max-w-none">
          <PhoneFrame
            label={`${t(locale, 'landing.phonesPlayer')} — ${first ? moveLine(first.name, first.reps) : ''}`}
          >
            <div class="aspect-[4/5] w-full overflow-hidden bg-surface-2">
              {first && <ExerciseStill exerciseId={first.exerciseId} />}
            </div>
            <div class="flex items-center gap-4 px-4 pt-4 pb-5">
              <Ring value={1 / facts.playerMinutes} size={64} stroke={5}>
                <span class="numeral text-lg">1</span>
              </Ring>
              <div class="flex min-w-0 flex-col gap-1">
                <p class="text-[14px] leading-tight font-semibold">
                  {first && moveLine(first.name, first.reps)}
                </p>
                <p class="text-[12px] leading-tight text-muted">
                  {t(locale, 'landing.phonesMinute', { n: 1, total: facts.playerMinutes })}
                </p>
              </div>
            </div>
          </PhoneFrame>
        </li>

        <li class="w-[280px] max-w-[85vw] shrink-0 snap-center md:w-auto md:max-w-none">
          <PhoneFrame label={t(locale, 'landing.phonesAfter')}>
            <div class="flex flex-col gap-4 px-4 pt-4 pb-5">
              <p class="font-display text-lg">{t(locale, 'app.summaryFeedbackTitle')}</p>
              <ul class="flex flex-col gap-2">
                {feelings.map((label, i) => (
                  <li
                    class:list={[
                      'rounded-control px-3.5 py-2.5 text-[13px]',
                      i === 0 ? 'bg-accent text-ink' : 'border border-border text-muted',
                    ]}
                  >
                    {label}
                  </li>
                ))}
              </ul>
              <div class="flex flex-col gap-1 border-t border-border pt-4">
                <p class="text-[12px] text-muted">{t(locale, 'app.summaryAdaptTitle')}</p>
                <p class="numeral text-2xl text-accent">
                  {t(locale, 'app.summaryVolumeDelta', { delta })}
                </p>
              </div>
            </div>
          </PhoneFrame>
        </li>
      </ul>

      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-[14px]">
        {facts.moves.map((m) =>
          m.href ? (
            <li>
              <a
                href={m.href}
                class="text-text underline decoration-border-strong underline-offset-4 hover:decoration-text"
              >
                {moveLine(m.name, m.reps)}
              </a>
            </li>
          ) : (
            <li class="text-text">{moveLine(m.name, m.reps)}</li>
          ),
        )}
      </ul>
    </div>
  )
}
