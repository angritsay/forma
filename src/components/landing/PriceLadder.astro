---
/**
 * Every price Forma charges, as one ladder of four cards — a short label, the figure large, one
 * button each — in the order a person meets them: workout 1 for
 * nothing, the course for good, the club with the course, the coach when needed. The same order
 * wherever prices are listed (site synthesis §5), so a reader who has seen it once can find a step
 * again.
 *
 * **No figure is typed here.** Workout 1 is zero by rule (0022, `firstTrainableNode`); the course
 * is `course.price` from `content/courses/start.ts`; the club is `clubPriceLabels()` over
 * `content/site/plans.ts`; the coach is `BOOKING.options` from `content/site/booking.ts`; the
 * refund window and its limit are `PRICING`. Change a price in its file and the ladder follows.
 *
 * **The rules the ladder keeps.**
 * - Neon on the first step only: it is the one main action of the section, «Начать бесплатно»
 *   into workout 1. The course is the white `plain`, the coach `secondary`.
 * - The club's step is the club's palette — the warm `Выгоднее` pill and the gradient button under
 *   ink, marked `data-club-zone` so the sticky bar steps aside — and no neon (§17).
 * - 666 never without 7 990: the club step prints `clubPriceLabels().chargeShort` («7 990 ₽ за
 *   год, одной оплатой») directly under the headline. EN leads with the year's `$` price and shows
 *   no monthly figure. The 30-day alternative and the long charge line live on `/subscribe/`.
 * - Links go to the app, the course page's order form and the club page's order form — never to a
 *   payment page, so no price and no referral code rides in a payment URL. The club's button is
 *   `data-club-join`, which the layout script reroutes through the app when a referral is pending.
 *
 * `omit` leaves steps out where the page already prices them: the homepage prints the club's
 * figure in its club section and the coach's tickets in its coach section, so its ladder is only
 * workout 1 and the course — each price once on the page. The order of what remains never changes.
 */
import { COURSE_BY_ID } from '@/content/registry';
import type { Locale } from '@/content/schema';
import { l, t } from '@/i18n/index';
import { renewalKey } from '@/lib/renewal';
import { appHref, href } from '@/lib/util/paths';
import { BOOKING } from '@content/site/booking';
import { formatPrice, PRICING } from '@content/site/pricing';
import Button from './Button.astro';
import Pill from './Pill.astro';
import { clubPriceLabels } from './club/clubPrice';
import { courseHref } from './courseHelpers';
import { DEMO_COURSE_ID } from './demo';

type Step = 'free' | 'course' | 'club' | 'coach';

interface Props {
  locale: Locale;
  /** Steps the page already prices elsewhere. */
  omit?: readonly Step[];
  class?: string;
}
const { locale, omit = [], class: extra = '' } = Astro.props;
const show = (step: Step) => !omit.includes(step);

const course = COURSE_BY_ID.get(DEMO_COURSE_ID);
const club = clubPriceLabels(locale);
const half = BOOKING.options.find((o) => o.id === 'half');
const free = formatPrice(locale, { rub: 0, usd: 0 });

const card = 'flex flex-col gap-4 rounded-card border p-5 md:p-6';
const label = 'text-[14px] leading-snug text-muted';
const figure = 'numeral text-5xl leading-none';
---

<div class:list={['flex flex-col gap-5', extra]}>
  <ol
    class:list={[
      'grid gap-3 sm:grid-cols-2',
      omit.length === 0 ? 'lg:grid-cols-4' : omit.length === 1 ? 'lg:grid-cols-3' : '',
    ]}
    aria-label={t(locale, 'landing.ladderLabel')}
  >
    {
      show('free') && (
        <li class={`glass-card border-border ${card}`}>
          <h3 class={label}>{t(locale, 'landing.ladderFreeTitle')}</h3>
          <p class={figure}>{free}</p>
          <Button
            href={appHref('/start', { locale })}
            variant="primary"
            class="mt-auto w-full"
            data-goal="app_start"
            data-app-link
          >
            {t(locale, 'landing.startCta')}
          </Button>
        </li>
      )
    }

    {
      show('course') && course && (
        <li class={`glass-card border-border ${card}`}>
          <h3 class={label}>{t(locale, 'landing.ladderCourseShort')}</h3>
          <p class={figure}>{formatPrice(locale, course.price)}</p>
          <p class="-mt-2 text-[13px] leading-snug text-muted-2">
            {t(locale, 'landing.ladderCourseNote')}
          </p>
          <Button
            href={`${courseHref(locale, course)}#order`}
            variant="plain"
            class="mt-auto w-full"
          >
            {t(locale, 'landing.ladderCourseCta')}
          </Button>
        </li>
      )
    }

    {
      show('club') && club && (
        <li
          data-club-zone
          class={`club-aurora-host glass-card-2 relative overflow-hidden border-border-strong ${card}`}
        >
          <span class="club-aurora" aria-hidden="true" />
          <h3 class={label}>{t(locale, 'landing.ladderClubTitle')}</h3>
          <span class="absolute top-4 right-4 flex">
            <Pill tone="warm" tilt="right">
              {t(locale, 'landing.ladderClubBadge')}
            </Pill>
          </span>
          <p class={figure}>{club.headline}</p>
          <p class="-mt-2 text-[13px] leading-snug text-text">{club.chargeShort}</p>
          <Button
            href={`${href(locale, '/subscribe/')}#order`}
            variant="gradient"
            class="mt-auto w-full"
            data-club-join
            data-goal="club_join"
          >
            {t(locale, 'landing.subscribeOrderTitle')}
          </Button>
        </li>
      )
    }

    {
      show('coach') && BOOKING.enabled && half && (
        <li class={`glass-card border-border ${card}`}>
          <h3 class={label}>{l(half.name, locale)}</h3>
          <p class={figure}>{formatPrice(locale, half.price)}</p>
          <Button
            href={appHref('/book', { locale })}
            variant="secondary"
            class="mt-auto w-full"
            data-app-link
          >
            {t(locale, 'landing.ladderCoachCta')}
          </Button>
        </li>
      )
    }
  </ol>
  <p class="text-[13px] leading-snug text-muted">
    {
      t(locale, renewalKey('ladderFootnoteShort'), {
        days: PRICING.refundDays,
        n: PRICING.refundMaxCompletedWorkouts,
      })
    }
  </p>
</div>
