---
/**
 * Sample workout: blocks with their format as a pill and items linking to exercise pages.
 * Numbers are the authored (scale 1.0) values — the app adapts them per athlete.
 *
 * One rounded glass plate around the workout (`.glass-card`, design/CHANGELOG.md §16), hairlines
 * between the blocks. A block's format and
 * volume («Круговая · 3 раунда») is a pill on its row; the block descriptions are gone from the
 * page — they are the coach's coaching notes and belong in the player, where the athlete reads
 * them one at a time, not stacked under a sales page's sample.
 */
import { EXERCISE_BY_ID } from '@/content/registry';
import type { Locale, Workout } from '@/content/schema';
import { l, t } from '@/i18n/index';
import { blockMetaLabel, exerciseHref, itemTargetLabel } from './courseHelpers';
import Pill from './Pill.astro';

interface Props {
  locale: Locale;
  workout: Workout;
}
const { locale, workout } = Astro.props;
---

<div class="glass-card rounded-card border border-border p-5 md:p-7">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h3 class="font-display text-xl">{l(workout.name, locale)}</h3>
    <Pill tone="course" size="sm">{l(workout.focus, locale)}</Pill>
  </div>
  <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-muted">
    {l(workout.description, locale)}
  </p>
  <ol class="mt-5 flex flex-col divide-y divide-border border-t border-border">
    {
      workout.blocks.map((b, i) => (
        <li class="py-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="flex min-w-0 items-baseline gap-3">
              <span class="numeral tabular shrink-0 text-sm text-muted" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="truncate font-semibold">
                {b.title ? l(b.title, locale) : t(locale, `training.block_${b.type}`)}
              </span>
            </span>
            <Pill size="sm">{blockMetaLabel(locale, b)}</Pill>
          </div>
          <ul class="mt-3 flex flex-col gap-1.5 pl-8 text-sm">
            {b.items.map((it) => {
              const ex = EXERCISE_BY_ID.get(it.exerciseId);
              return (
                <li class="flex items-baseline justify-between gap-3">
                  {ex ? (
                    <a
                      href={exerciseHref(locale, ex)}
                      class="min-w-0 underline decoration-border-strong underline-offset-4 hover:decoration-text"
                    >
                      {l(ex.name, locale)}
                    </a>
                  ) : (
                    <span>{it.exerciseId}</span>
                  )}
                  <span class="tabular shrink-0 text-right text-muted">
                    {itemTargetLabel(locale, it)}
                  </span>
                </li>
              );
            })}
          </ul>
        </li>
      ))
    }
  </ol>
</div>
