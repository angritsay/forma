---
/**
 * Sample workout: blocks with format/volume labels and items linking to exercise pages.
 * Numbers are the authored (scale 1.0) values — the app adapts them per athlete.
 *
 * One frame around the workout, hairlines between the blocks: a card inside a card inside a card
 * was three borders saying one thing.
 */
import { EXERCISE_BY_ID } from '@/content/registry';
import type { Locale, Workout } from '@/content/schema';
import { l, t } from '@/i18n/index';
import { blockMetaLabel, exerciseHref, itemTargetLabel } from './courseHelpers';

interface Props {
  locale: Locale;
  workout: Workout;
}
const { locale, workout } = Astro.props;
---

<div class="border border-border bg-surface p-5 md:p-7">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h3 class="font-display text-xl">{l(workout.name, locale)}</h3>
    <span class="eyebrow">{l(workout.focus, locale)}</span>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-muted">{l(workout.description, locale)}</p>
  <ol class="mt-6 flex flex-col divide-y divide-border border-t border-border">
    {
      workout.blocks.map((b, i) => (
        <li class="grid gap-3 py-4 sm:grid-cols-[2.5rem_minmax(0,1fr)]">
          <span class="numeral text-sm text-muted" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div>
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <span class="font-semibold">
                {b.title ? l(b.title, locale) : t(locale, `training.block_${b.type}`)}
              </span>
              <span class="text-xs text-muted">{blockMetaLabel(locale, b)}</span>
            </div>
            {b.description && <p class="mt-1 text-xs text-muted">{l(b.description, locale)}</p>}
            <ul class="mt-2 flex flex-col gap-1.5 text-sm">
              {b.items.map((it) => {
                const ex = EXERCISE_BY_ID.get(it.exerciseId);
                return (
                  <li class="flex items-baseline justify-between gap-3">
                    {ex ? (
                      <a
                        href={exerciseHref(locale, ex)}
                        class="underline decoration-border-strong underline-offset-4 hover:decoration-text"
                      >
                        {l(ex.name, locale)}
                      </a>
                    ) : (
                      <span>{it.exerciseId}</span>
                    )}
                    <span class="tabular text-right text-muted">{itemTargetLabel(locale, it)}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</div>
