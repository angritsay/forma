---
/**
 * Landing button: squared blue primary, outlined secondary, quiet ghost. Labels are capitalised
 * and tracked to match the app kit's Button — the two surfaces share one control language.
 * Renders <a> when `href` is set, otherwise <button>.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  type?: 'button' | 'submit';
  class?: string;
  ariaLabel?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: extra = '',
  ariaLabel,
} = Astro.props;

// `min-h-11` keeps every button at the 44px minimum touch target on coarse pointers.
const base =
  'control-label inline-flex min-h-11 items-center justify-center gap-2 rounded-control transition focus-visible:outline-accent';
// Uppercase at 0.08em tracking sets wider than sentence case, so each step drops a size.
const sizes = { md: 'px-5 py-2.5 text-[12px]', lg: 'px-7 py-3.5 text-[13px]' };
const variants = {
  primary: 'bg-accent text-on-primary hover:opacity-85',
  secondary:
    'border border-border-strong bg-transparent text-text hover:border-text hover:bg-surface-2',
  ghost: 'text-muted hover:text-text',
};
const cls = `${base} ${sizes[size]} ${variants[variant]} ${extra}`;
---

{
  href ? (
    <a href={href} class={cls} aria-label={ariaLabel}>
      <slot />
    </a>
  ) : (
    <button type={type} class={cls} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}
