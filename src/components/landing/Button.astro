---
/**
 * Landing button — the Astro twin of the kit's Button (src/components/ui/Button.tsx), kept in
 * step by hand so both surfaces share one control language.
 *
 * Black and white only: primary is a white fill with black text, secondary a raised surface
 * behind a strong hairline, ghost is text alone, danger an outline with red text. None of them
 * ever takes the programme colour. Heights 40 / 48 / 56; the label is capitals at 12–13px
 * tracked .16em (`.control-label`), which sets wide, so the padding does the work of making the
 * box read as a button. Hover drops to .85 opacity or lightens one surface; press is a 2% scale.
 * Renders <a> when `href` is set, otherwise <button>.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'danger';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit';
  class?: string;
  ariaLabel?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: extra = '',
  ariaLabel,
} = Astro.props;

const base =
  'control-label inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-control transition-[background-color,color,opacity,transform] duration-150 ease-(--ease-out) active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
// `sm` is under the 44px touch minimum on its own; `tap-target-y` grows its hit area, not its box.
const sizes = {
  sm: 'tap-target-y h-10 px-4.5 text-[12px]',
  md: 'h-12 px-6.5 text-[13px]',
  lg: 'h-14 px-8 text-[13px]',
};
const variants = {
  primary: 'bg-primary text-on-primary hover:opacity-85',
  secondary: 'border border-border-strong bg-surface-2 text-text hover:bg-surface-3',
  ghost: 'bg-transparent text-muted hover:text-text',
  danger: 'border border-border-strong bg-transparent text-danger hover:bg-surface-2',
};
const cls = `${base} ${sizes[size]} ${variants[variant]} ${extra}`;
---

{
  href ? (
    <a href={href} class={cls} aria-label={ariaLabel}>
      <slot />
    </a>
  ) : (
    <button type={type} class={cls} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}
