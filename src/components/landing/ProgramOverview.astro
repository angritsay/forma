---
/**
 * Weeks accordion listing every node of a course: the day's numeral, its title and its kind.
 *
 * No kind icons. A day on the path is told apart by its number and the word after it —
 * «День 3 · Отдых» — which is what the icon row was trying to say with five little pictures.
 * Rows are hairlines, the toggle is a + glyph that turns into × when the week is open, and the
 * deload week is stamped with an outlined badge rather than a filled one.
 */
import type { Course, Locale } from '@/content/schema';
import { l, t } from '@/i18n/index';
import { groupNodesByWeek, nodeKindLabel } from './courseHelpers';

interface Props {
  locale: Locale;
  course: Course;
}
const { locale, course } = Astro.props;
const weeks = groupNodesByWeek(course);
---

<div class="divide-y divide-border border-t border-border">
  {
    weeks.map((w, i) => (
      <details class="group py-4" open={i === 0}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 [&::-webkit-details-marker]:hidden">
          <span class="flex flex-wrap items-center gap-3">
            <span class="font-display text-base">
              {t(locale, 'landing.courseWeek', { n: w.week })}
            </span>
            {w.deload && (
              <span class="inline-flex h-6 items-center rounded-control border border-border-strong px-2.5 text-[11px] font-semibold tracking-[0.12em] text-warning uppercase">
                {t(locale, 'landing.courseDeload')}
              </span>
            )}
          </span>
          <span class="flex items-center gap-4 text-sm text-muted">
            <span class="tabular hidden sm:inline">
              {w.nodes.filter((n) => n.kind !== 'rest').length} ·{' '}
              {w.nodes.filter((n) => n.kind === 'rest').length}
            </span>
            <span
              class="glyph flex size-8 items-center justify-center text-lg text-text transition-transform duration-150 ease-(--ease-out) group-open:rotate-45"
              aria-hidden="true"
            >
              +
            </span>
          </span>
        </summary>
        <ol class="mt-3 flex flex-col divide-y divide-border">
          {w.nodes.map((n) => (
            <li class="flex items-baseline gap-4 py-2.5">
              <span
                class:list={[
                  'numeral w-8 shrink-0 text-sm',
                  n.kind === 'rest' ? 'text-muted-2' : 'text-text',
                ]}
                aria-hidden="true"
              >
                {String(n.day).padStart(2, '0')}
              </span>
              <span class="flex min-w-0 flex-1 flex-col">
                <span
                  class:list={[
                    'truncate text-sm font-medium',
                    n.kind === 'rest' ? 'text-muted' : 'text-text',
                  ]}
                >
                  {l(n.title, locale)}
                </span>
                <span class="text-xs text-muted">
                  {t(locale, 'landing.courseDay', { n: n.day })} · {nodeKindLabel(locale, n)}
                  {n.subtitle ? ` · ${l(n.subtitle, locale)}` : ''}
                </span>
              </span>
            </li>
          ))}
        </ol>
      </details>
    ))
  }
</div>
