---
/** Weeks accordion listing every node of a course with a kind icon and title. */
import type { Course, Locale } from '@/content/schema';
import { l, t } from '@/i18n/index';
import { groupNodesByWeek, nodeKindLabel } from './courseHelpers';

interface Props {
  locale: Locale;
  course: Course;
}
const { locale, course } = Astro.props;
const weeks = groupNodesByWeek(course);

const kindIcon: Record<Course['nodes'][number]['kind'], string> = {
  workout: 'M5 3l10 6-10 6z',
  rest: 'M12.6 2.2a6.8 6.8 0 1 0 3.2 9.9 5.2 5.2 0 0 1-3.2-9.9z',
  test: 'M4 2h1.5v14H4zM6.5 2.5h8l-2 3.5 2 3.5h-8z',
  benchmark: 'M9 1.5l2.2 4.6 5 .7-3.6 3.5.9 5L9 12.9l-4.5 2.4.9-5L1.8 6.8l5-.7z',
  milestone: 'M9 2a7 7 0 1 0 0 14A7 7 0 0 0 9 2zm0 4a3 3 0 1 1 0 6 3 3 0 0 1 0-6z',
};
const kindTone: Record<Course['nodes'][number]['kind'], string> = {
  workout: 'bg-primary text-on-primary',
  rest: 'border border-border bg-surface-2 text-muted',
  test: 'bg-accent text-on-primary',
  benchmark: 'bg-warning text-on-primary',
  milestone: 'bg-accent-2 text-on-primary',
};
---

<div class="divide-y divide-border rounded-card border border-border bg-surface px-5 md:px-7">
  {
    weeks.map((w, i) => (
      <details class="group py-4" open={i === 0}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 [&::-webkit-details-marker]:hidden">
          <span class="flex flex-wrap items-center gap-2">
            <span class="text-lg font-semibold">
              {t(locale, 'landing.courseWeek', { n: w.week })}
            </span>
            {w.deload && (
              <span class="rounded-pill bg-warning/20 px-2 py-0.5 text-xs font-semibold text-warning">
                {t(locale, 'landing.courseDeload')}
              </span>
            )}
          </span>
          <span class="flex items-center gap-3 text-sm text-muted">
            <span class="hidden sm:inline">
              {w.nodes.filter((n) => n.kind !== 'rest').length} ·{' '}
              {w.nodes.filter((n) => n.kind === 'rest').length}
            </span>
            <span
              class="flex size-8 items-center justify-center rounded-pill border border-border transition group-open:rotate-45"
              aria-hidden="true"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 14 14"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M7 1v12M1 7h12" />
              </svg>
            </span>
          </span>
        </summary>
        <ol class="mt-3 flex flex-col gap-2">
          {w.nodes.map((n) => (
            <li class="flex items-center gap-3 rounded-inner bg-bg px-3 py-2.5">
              <span
                class={`flex size-8 shrink-0 items-center justify-center rounded-full ${kindTone[n.kind]}`}
                aria-hidden="true"
              >
                <svg width="16" height="16" viewBox="0 0 18 18" fill="currentColor">
                  <path d={kindIcon[n.kind]} />
                </svg>
              </span>
              <span class="flex min-w-0 flex-1 flex-col">
                <span class="truncate text-sm font-medium">{l(n.title, locale)}</span>
                <span class="text-xs text-muted">
                  {t(locale, 'landing.courseDay', { n: n.day })} · {nodeKindLabel(locale, n)}
                  {n.subtitle ? ` · ${l(n.subtitle, locale)}` : ''}
                </span>
              </span>
            </li>
          ))}
        </ol>
      </details>
    ))
  }
</div>
