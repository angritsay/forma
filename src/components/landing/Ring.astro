---
/**
 * A static ring — the Astro twin of the kit's RingProgress (src/components/ui/RingProgress.tsx).
 *
 * The landing is a static build and draws three of these (the steps goal, the rest countdown, a
 * course's progress); hydrating React for an SVG that never changes would ship the framework to
 * draw a circle. Same rules as the original: square arc ends, the track in --surface-3, the fill
 * in the programme colour when a course is in scope (`--course-tile` set above it) and white
 * otherwise. Whatever sits in the middle — a numeral, a word — comes through the slot.
 */
interface Props {
  /** Progress 0..1 (clamped). */
  value: number;
  /** Outer diameter in px. */
  size?: number;
  stroke?: number;
  /** Accessible name; omit for a purely decorative ring. */
  label?: string;
  class?: string;
}
const { value, size = 96, stroke = 6, label, class: extra = '' } = Astro.props;
const v = Math.min(1, Math.max(0, Number.isFinite(value) ? value : 0));
const r = (size - stroke) / 2;
const c = 2 * Math.PI * r;
const half = size / 2;
---

<div class={`relative inline-flex shrink-0 ${extra}`} style={`width:${size}px;height:${size}px`}>
  <svg
    width={size}
    height={size}
    viewBox={`0 0 ${size} ${size}`}
    role={label ? 'progressbar' : undefined}
    aria-label={label}
    aria-valuemin={label ? 0 : undefined}
    aria-valuemax={label ? 100 : undefined}
    aria-valuenow={label ? Math.round(v * 100) : undefined}
    aria-hidden={label ? undefined : 'true'}
  >
    <circle cx={half} cy={half} r={r} fill="none" stroke-width={stroke} class="stroke-surface-3"
    ></circle>
    <circle
      cx={half}
      cy={half}
      r={r}
      fill="none"
      stroke-width={stroke}
      stroke-linecap="butt"
      stroke-dasharray={`${c * v} ${c}`}
      transform={`rotate(-90 ${half} ${half})`}
      style="stroke:var(--course-tile, var(--primary))"></circle>
  </svg>
  <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
    <slot />
  </div>
</div>
