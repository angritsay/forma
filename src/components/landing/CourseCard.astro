---
/**
 * Course card for the home grid and the courses hub: the course tile carrying the signature
 * exercise figure (static render), then name, tagline, metric chips, price and a link.
 *
 * The one place on the landing where a course has to read as a discrete, buyable object, so it
 * keeps a 1px frame — and nothing else: no radius, no shadow. The cover is the programme colour
 * set through `courseTileStyle()`, which also sets the ink the figure and the stamps on it are
 * drawn in, so a yellow cover never carries white text. The level is stamped in the programme
 * colour's own badge tone — the one badge allowed to take colour, because it names the
 * programme — and the number in the corner is the card's numeral, not a decoration.
 */
import ExerciseFigure from '@/components/anim/ExerciseFigure';
import type { Course, Locale } from '@/content/schema';
import { l, t } from '@/i18n/index';
import { courseTileStyle } from '@/lib/ui/tile';
import { formatPrice, isFree } from '@content/site/pricing';
import FeatureChip from './FeatureChip.astro';
import {
  courseEquipmentForDisplay,
  courseHref,
  equipmentLabel,
  levelLabel,
  sessionsLabel,
  signatureExercise,
  weeksLabel,
} from './courseHelpers';

interface Props {
  course: Course;
  locale: Locale;
  /** Heading level inside the card. */
  headingLevel?: 'h2' | 'h3';
  /** 1-based position in the grid, drawn as the card's numeral. */
  n?: number;
}

const { course, locale, headingLevel: Heading = 'h3', n } = Astro.props;
const url = courseHref(locale, course);
const signature = signatureExercise(course);
const equipment = courseEquipmentForDisplay(course);
const price = isFree(course.price, locale)
  ? t(locale, 'landing.priceFree')
  : formatPrice(locale, course.price);
---

<article
  class="group flex h-full flex-col overflow-hidden border border-border transition-colors duration-150 hover:border-border-strong"
  style={courseTileStyle(course.tile)}
  data-course-card
  data-equipment={course.equipment.join(' ')}
  data-level={course.level}
>
  <div class="relative">
    <!-- Decorative duplicate of the title link below: hidden from AT and from the tab order so the
         card exposes one link per destination instead of three. The level badge stays outside it
         so it is still announced. -->
    <a
      href={url}
      class="hero-art relative flex aspect-[16/10] items-center justify-center overflow-hidden"
      aria-hidden="true"
      tabindex="-1"
    >
      {
        signature ? (
          <ExerciseFigure
            animation={signature.animation}
            variant="card"
            playing={false}
            tile={course.tile}
            label={l(signature.name, locale)}
          />
        ) : null
      }
    </a>
    {
      n !== undefined && (
        <span class="numeral absolute top-4 left-5 text-sm text-tile-fg">
          {String(n).padStart(2, '0')}
        </span>
      )
    }
    <span
      class="absolute right-4 bottom-4 inline-flex h-6 items-center bg-ink/85 px-2.5 text-[11px] font-semibold tracking-[0.12em] text-paper uppercase"
    >
      {levelLabel(locale, course.level)}
    </span>
  </div>

  <div class="flex flex-1 flex-col gap-3 p-6">
    <Heading class="font-display text-xl">
      <a href={url} class="hover:underline">{l(course.name, locale)}</a>
    </Heading>
    <p class="text-sm leading-relaxed text-muted">{l(course.tagline, locale)}</p>
    <ul class="mt-1 flex flex-wrap gap-1.5">
      <li>
        <FeatureChip tone="outline" size="sm">{weeksLabel(locale, course.weeks)}</FeatureChip>
      </li>
      <li>
        <FeatureChip tone="outline" size="sm"
          >{sessionsLabel(locale, course.sessionsPerWeek)}</FeatureChip
        >
      </li>
      <li>
        <FeatureChip tone="outline" size="sm"
          >{t(locale, 'landing.avgSession', { n: course.avgSessionMin })}</FeatureChip
        >
      </li>
      {
        equipment.map((e) => (
          <li>
            <FeatureChip tone="outline" size="sm">
              {equipmentLabel(locale, e)}
            </FeatureChip>
          </li>
        ))
      }
    </ul>
    <!-- `mt-auto` pins the price row to the bottom so cards of unequal height line their prices
         up; the hairline above it gets its air from `pt-4`, not from a second margin. -->
    <div class="mt-auto flex items-center justify-between gap-3 border-t border-border pt-4">
      <span class="numeral tabular text-xl">{price}</span>
      <a
        href={url}
        class="control-label inline-flex h-10 items-center rounded-control bg-primary px-4.5 text-[12px] text-on-primary transition-opacity duration-150 group-hover:opacity-85"
      >
        {t(locale, 'landing.cardView')}
      </a>
    </div>
  </div>
</article>
