---
/**
 * Course card for the home grid and the courses hub: the course tile carrying the signature
 * exercise figure (static render), then name, tagline, metric chips, price and a link.
 *
 * The card keeps its 24px radius and its border — this is the one place on the landing where a
 * course has to read as a discrete, buyable object, and a grid of ruled rows would lose that. The
 * art above it is a flat course tile now instead of a pastel gradient, the chips are outlines,
 * and the "view" control is a squared caps label rather than a white pill.
 */
import ExerciseFigure from '@/components/anim/ExerciseFigure';
import type { Course, Locale } from '@/content/schema';
import { l, t } from '@/i18n/index';
import { formatPrice, isFree } from '@content/site/pricing';
import FeatureChip from './FeatureChip.astro';
import {
  courseEquipmentForDisplay,
  courseHref,
  equipmentLabel,
  levelLabel,
  sessionsLabel,
  signatureExercise,
  weeksLabel,
} from './courseHelpers';

interface Props {
  course: Course;
  locale: Locale;
  /** Heading level inside the card. */
  headingLevel?: 'h2' | 'h3';
  /** 1-based position in the grid, drawn as the card's numeral. */
  n?: number;
}

const { course, locale, headingLevel: Heading = 'h3', n } = Astro.props;
const url = courseHref(locale, course);
const signature = signatureExercise(course);
const equipment = courseEquipmentForDisplay(course);
const price = isFree(course.price, locale)
  ? t(locale, 'landing.priceFree')
  : formatPrice(locale, course.price);
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-card border border-border transition hover:border-border-strong"
  data-course-card
  data-equipment={course.equipment.join(' ')}
  data-level={course.level}
>
  <div class="relative">
    <!-- Decorative duplicate of the title link below: hidden from AT and from the tab order so the
         card exposes one link per destination instead of three. The level badge stays outside it
         so it is still announced. -->
    <a
      href={url}
      class="hero-art relative flex aspect-[16/10] items-center justify-center overflow-hidden"
      style={`--course-tile:${course.tile}`}
      aria-hidden="true"
      tabindex="-1"
    >
      {
        signature ? (
          <ExerciseFigure
            animation={signature.animation}
            variant="card"
            playing={false}
            tile={course.tile}
            label={l(signature.name, locale)}
          />
        ) : null
      }
    </a>
    {
      n !== undefined && (
        <span class="numeral absolute top-4 left-5 text-sm text-tile-fg/70">
          {String(n).padStart(2, '0')}
        </span>
      )
    }
    <span class="eyebrow absolute right-5 bottom-4 text-tile-fg">
      {levelLabel(locale, course.level)}
    </span>
  </div>

  <div class="flex flex-1 flex-col gap-3 p-6">
    <Heading class="font-display text-2xl">
      <a href={url} class="hover:underline">{l(course.name, locale)}</a>
    </Heading>
    <p class="text-muted">{l(course.tagline, locale)}</p>
    <ul class="mt-1 flex flex-wrap gap-1.5">
      <li><FeatureChip tone="outline">{weeksLabel(locale, course.weeks)}</FeatureChip></li>
      <li>
        <FeatureChip tone="outline">{sessionsLabel(locale, course.sessionsPerWeek)}</FeatureChip>
      </li>
      <li>
        <FeatureChip tone="outline"
          >{t(locale, 'landing.avgSession', { n: course.avgSessionMin })}</FeatureChip
        >
      </li>
      {
        equipment.map((e) => (
          <li>
            <FeatureChip tone="outline">{equipmentLabel(locale, e)}</FeatureChip>
          </li>
        ))
      }
    </ul>
    <div class="mt-auto flex items-center justify-between gap-3 border-t border-border pt-4 mt-4">
      <span class="numeral tabular text-xl">{price}</span>
      <a
        href={url}
        class="control-label inline-flex min-h-11 items-center rounded-control bg-accent px-4 text-[12px] text-on-primary transition group-hover:opacity-85"
      >
        {t(locale, 'landing.cardView')}
      </a>
    </div>
  </div>
</article>
