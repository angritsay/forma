---
/**
 * A course on the site, as the same ticket it is in the app (`src/app/features/programs/CourseTicket`).
 *
 * The owner's brief for the site was that a course should look like the same object here and in
 * the app: the cover, «4 недели · 18 мин · без оборудования» as pills, the price as the figure, one
 * button. This card used to be its own thing — a square-cornered frame, the tagline as a paragraph,
 * eight capitalised chips, a stamped level badge and an index numeral in the corner — and a person
 * who came from the site into the app met the course twice, drawn two ways.
 *
 * So the parts are the ticket's, in the ticket's order: the **cover** (the course's own art, or the
 * signature movement's still on the programme colour when there is none), the **kicker** saying
 * what kind of thing this is and for whom, the **name**, the **facts** as pills in the programme
 * colour, the **price** and the **action**. Two departures from the app, both for the same reason:
 * the name stays printed under a cover that already carries it, because on the site the heading is
 * the link and the h2/h3 the page's outline is built from; and the facts are pills rather than the
 * app's one line of lead, because a stranger choosing a course compares facts.
 *
 * `wide` lays the ticket sideways from `md` — cover left, words right — for a page with one course
 * on it: a 4:3 cover the full width of a 1152px container is 860px of picture and a page that
 * scrolls a screen before it reaches a price.
 */
import ExerciseStill from '@/components/media/ExerciseStill';
import { publicMediaUrl } from '@/lib/api/storage';
import type { Course, Locale } from '@/content/schema';
import { l, t } from '@/i18n/index';
import { courseTileStyle } from '@/lib/ui/tile';
import { formatPrice, isFree } from '@content/site/pricing';
import Pill from './Pill.astro';
import {
  courseEquipmentForDisplay,
  courseHref,
  equipmentLabel,
  levelLabel,
  sessionsLabel,
  signatureExercise,
  weeksLabel,
} from './courseHelpers';

interface Props {
  course: Course;
  locale: Locale;
  /** Heading level inside the card. */
  headingLevel?: 'h2' | 'h3';
  /** Cover beside the words from `md`, for a grid with one course in it. */
  wide?: boolean;
  /**
   * The card's button in neon, as the page's one main action. Off by default: the cards stand in
   * a grid under a hero whose own CTA is the neon (`Hero`, `Cta`), and the third palette allows one
   * neon per viewport (global.css header) — a row of neon «Смотреть курс» makes none of them the
   * main one. So the card's button is the white `plain` fill, the site's secondary button, unless a
   * page with nothing neon above it asks for the neon.
   */
  action?: boolean;
}

const { course, locale, headingLevel: Heading = 'h3', wide = false, action = false } = Astro.props;
const url = courseHref(locale, course);
const signature = signatureExercise(course);
/*
 * The course's own cover art beats the signature movement's still. The still is a stand-in — one
 * frame of one exercise, standing for a whole course — and it was the best the card could do
 * before a course could carry a picture of its own. The art is not treated as a photograph (no
 * `.photo-mono`, no grain): it is already the product's monochrome with the programme colour drawn
 * on, and desaturating it would strip the colour out of the one place the brandbook wants it.
 */
const cover = course.cover ? publicMediaUrl(course.cover) : undefined;
const equipment = courseEquipmentForDisplay(course);
const price = isFree(course.price, locale)
  ? t(locale, 'landing.priceFree')
  : formatPrice(locale, course.price);
const facts = [
  weeksLabel(locale, course.weeks),
  sessionsLabel(locale, course.sessionsPerWeek),
  t(locale, 'landing.avgSession', { n: course.avgSessionMin }),
  ...equipment.map((e) => equipmentLabel(locale, e)),
];
---

<article
  class:list={[
    'glass-card group flex h-full flex-col overflow-hidden rounded-card border border-border transition-colors duration-150 hover:border-border-strong',
    wide && 'md:grid md:grid-cols-[minmax(0,5fr)_minmax(0,4fr)]',
  ]}
  style={courseTileStyle(course.tile)}
  data-course-card
  data-equipment={course.equipment.join(' ')}
  data-level={course.level}
>
  <!--
    The cover, 4:3 — the ticket's ratio, chosen there so the art carries the name. A decorative
    duplicate of the heading's link below: hidden from AT and from the tab order so the card
    exposes one link per destination instead of three.
  -->
  <a
    href={url}
    class:list={[
      'relative block aspect-4/3 overflow-hidden',
      cover ? 'bg-ink' : 'hero-art',
      wide && 'md:aspect-auto md:h-full md:min-h-80',
    ]}
    aria-hidden="true"
    tabindex="-1"
  >
    {
      cover ? (
        <img
          src={cover}
          alt=""
          loading="lazy"
          decoding="async"
          class="absolute inset-0 size-full object-cover"
        />
      ) : signature ? (
        <div class="absolute inset-0 flex items-center justify-center">
          <ExerciseStill exerciseId={signature.id} />
        </div>
      ) : null
    }
  </a>

  <div
    class:list={['flex flex-1 flex-col px-5 pt-4 pb-5 md:p-6', wide && 'md:justify-center md:p-8']}
  >
    <!--
      The level is the course's own tag, filled in its colour with its ink and leaning — orange for
      the beginners (Style A, global.css header). The kicker beside it is the quiet word.
    -->
    <p class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <Pill tone="course-fill" size="sm" tilt="left">{levelLabel(locale, course.level)}</Pill>
      <span class="eyebrow truncate">{t(locale, 'landing.cardKicker')}</span>
    </p>
    <Heading class="font-display mt-3 text-lg leading-snug text-balance">
      <a href={url} class="hover:underline">{l(course.name, locale)}</a>
    </Heading>
    <ul class="mt-4 flex flex-wrap gap-1.5">
      {
        facts.map((f) => (
          <li class="flex max-w-full">
            <Pill tone="course" size="sm">
              {f}
            </Pill>
          </li>
        ))
      }
    </ul>
    <!--
      `mt-auto` pins the price row to the bottom so tickets of unequal height line their prices up.
      Both the price and the button are `shrink-0` and the row wraps: neither is text that can give
      way — the price is the ticket's figure and the button is a control — so when they do not fit
      side by side the button drops to its own line. It had to: in the sideways ticket at 768 the
      words sit in 4fr of a 728px grid, which left «2 990 ₽» 54px and rendered it «2 99…».
    -->
    <div class="mt-auto flex flex-wrap items-center justify-between gap-x-4 gap-y-4 pt-6">
      <span class="numeral tabular shrink-0 text-3xl whitespace-nowrap">{price}</span>
      <a
        href={url}
        class:list={[
          'control-label inline-flex h-12 shrink-0 items-center rounded-control px-6 text-[15px] transition-opacity duration-150 group-hover:opacity-85',
          action ? 'bg-action text-on-action' : 'bg-primary text-on-primary',
        ]}
      >
        {t(locale, 'landing.cardView')}
      </a>
    </div>
  </div>
</article>
