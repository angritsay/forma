---
/**
 * Landing section: a numbered, ruled header (kicker + display title + optional intro), then the
 * slot content.
 *
 * Sections are separated by a hairline and marked with a section number rather than by alternating
 * background bands — the landing has one ground, black, and the rules and numerals are what give
 * it structure. `n` sets the numeral (01, 02, …); omit it for sections outside the sequence.
 *
 * The title is a heading in the display face (600). Pass `display` for the one big 800 line a
 * page is allowed — a screen has one of those, and it is usually the hero's.
 */
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  /** Section number drawn opposite the header, e.g. 2 → "02". */
  n?: number;
  /** Heading element for the title (h2 by default). */
  headingTag?: 'h1' | 'h2';
  /** Set the title at the 800 display weight instead of the 600 heading weight. */
  display?: boolean;
  align?: 'left' | 'center';
  /** Extra classes on the <section>. */
  class?: string;
  /** Narrower header (max-w-2xl) by default; pass false for full-width headers. */
  narrow?: boolean;
}

const {
  id,
  eyebrow,
  title,
  intro,
  n,
  headingTag: Tag = 'h2',
  display = false,
  align = 'left',
  class: extra = '',
  narrow = true,
} = Astro.props;
const headerCls = [narrow ? 'max-w-2xl' : '', align === 'center' ? 'mx-auto text-center' : ''].join(
  ' ',
);
---

<section id={id} class={`mx-auto max-w-6xl px-5 py-16 md:py-24 ${extra}`}>
  <div class="flex items-start justify-between gap-8 border-t border-border pt-8">
    <header class={headerCls}>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <Tag
        class:list={[
          display ? 'display' : 'font-display',
          'mt-4 text-4xl text-balance md:text-5xl',
        ]}
      >
        {title}
      </Tag>
      {intro && <p class="mt-5 text-lg leading-relaxed text-muted">{intro}</p>}
    </header>
    {
      n !== undefined && (
        <span class="numeral shrink-0 text-sm text-muted" aria-hidden="true">
          {String(n).padStart(2, '0')}
        </span>
      )
    }
  </div>
  <div class="mt-10 md:mt-12">
    <slot />
  </div>
</section>
