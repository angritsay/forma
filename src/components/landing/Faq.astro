---
/**
 * Accordion FAQ built on <details>; works without JS and is keyboard accessible. Hairline rows;
 * the toggle is a + glyph that turns into × when the answer is open — punctuation, not an icon.
 */
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="divide-y divide-border border-t border-border">
  {
    items.map((it) => (
      <details class="group py-5">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold [&::-webkit-details-marker]:hidden">
          <span>{it.q}</span>
          <span
            class="glyph flex size-8 shrink-0 items-center justify-center text-lg text-muted transition-transform duration-150 ease-(--ease-out) group-open:rotate-45"
            aria-hidden="true"
          >
            +
          </span>
        </summary>
        <p class="mt-3 max-w-3xl leading-relaxed text-muted">{it.a}</p>
      </details>
    ))
  }
</div>
