---
/**
 * The together block's card: the link to pass on, today as a plain copy button.
 *
 * This is the one place the homepage's «Вместе с понедельника» section takes a link, and it is
 * deliberately a single component so the full invite (a share sheet with the Monday text, the
 * date chip, Telegram and WhatsApp, the calendar and the personal-link row — site synthesis §4)
 * replaces this file's use in `index.astro` by one line, with nothing else on the page moving.
 *
 * What it does now, and nothing it does not:
 * - «Скопировать ссылку» copies this page's own `#together` on the visitor's origin (`shareHome.ts`
 *   `bindCopyLink`), so a friend who opens it lands on the same steps. The plain link carries no
 *   reward and the copy promises none.
 * - The personal link — the one that earns +30 days each once the friend pays for the club — is
 *   made in the app (`#/invite`), and the card says so and links there. The conditions under it
 *   are the app's own `app.inviteNote`, quoted rather than retyped.
 *
 * A glass plate with the club's aurora behind it and the crossroads gradient as a hairline along
 * its top edge — never under a word. No neon: the page's neon is workout 1, and this block is the
 * one the phone's sticky bar steps aside for (`#together`).
 */
import type { Locale } from '@/content/schema';
import { t } from '@/i18n/index';
import { appHref, localePath, withBase } from '@/lib/util/paths';
import Button from './Button.astro';

interface Props {
  locale: Locale;
  class?: string;
}
const { locale, class: extra = '' } = Astro.props;
const homePath = withBase(localePath(locale, '/'));
---

<div
  class:list={[
    'club-aurora-host glass-card-2 relative overflow-hidden rounded-card border border-border-strong p-6 md:p-8',
    extra,
  ]}
>
  <span class="club-aurora" aria-hidden="true"></span>
  <span class="bg-cross absolute inset-x-0 top-0 h-px" aria-hidden="true"></span>
  <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between md:gap-10">
    <div class="flex flex-col gap-2">
      <p class="eyebrow">{t(locale, 'landing.togetherLinkLabel')}</p>
      <p class="max-w-md text-[15px] leading-snug text-muted">
        {t(locale, 'landing.togetherLinkHint')}
      </p>
    </div>
    <Button
      variant="plain"
      size="lg"
      class="w-full md:w-auto"
      data-copy-link
      data-copy-path={homePath}
      data-copy-hash="#together"
      data-copied-label={t(locale, 'landing.copyLinkDone')}
      data-goal="together_copy"
    >
      <span data-copy-label aria-live="polite">{t(locale, 'landing.copyLink')}</span>
    </Button>
  </div>
  <div class="mt-6 flex flex-col gap-3 border-t border-border pt-5">
    <p class="text-[14px] leading-snug text-text">
      {t(locale, 'landing.togetherPersonal')}
      {' '}
      <a
        href={appHref('/invite', { locale })}
        data-app-link
        class="whitespace-nowrap text-text underline decoration-border-strong underline-offset-4 hover:decoration-text"
      >
        {t(locale, 'landing.togetherPersonalCta')}
        <span class="glyph" aria-hidden="true">→</span>
      </a>
    </p>
    <p class="text-[13px] leading-snug text-muted">
      {t(locale, 'app.inviteNote')}
      {' '}
      {t(locale, 'landing.togetherNoDiscount')}
    </p>
  </div>
</div>

<script>
  import { bindCopyLink } from './shareHome';

  bindCopyLink();
</script>
