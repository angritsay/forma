---
/**
 * The React app island. Rendered client-only (it depends on auth state); excluded from indexing.
 */
import Base from '@/layouts/Base.astro';
import App from '@/app/main';
import { withBase } from '@/lib/util/paths';
---

<Base locale="ru" bodyClass="app-body">
  <Fragment slot="head">
    <title>Forma</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="apple-touch-icon" href={withBase('/favicon.svg')} />
    {
      /*
      Telegram Mini App bootstrap.

      Two reasons this is an inline script in the head rather than a plain <script src>:
      a plain web visitor should not make a request to telegram.org at all, and Telegram passes
      the launch data in the URL hash — which HashRouter rewrites the moment the app mounts. So
      we detect Telegram first, load the SDK immediately, and the app waits for it before its
      first render (see waitForTelegram in src/lib/telegram/webapp.ts).
    */
    }
    <script is:inline>
      (function () {
        var byHash = location.hash.indexOf('tgWebApp') !== -1;
        var byBridge = typeof window.TelegramWebviewProxy !== 'undefined';
        if (!byHash && !byBridge) return;
        window.__formaTelegram = true;
        var s = document.createElement('script');
        s.src = 'https://telegram.org/js/telegram-web-app.js';
        document.head.appendChild(s);
      })();
    </script>
  </Fragment>
  <App client:only="react" />
</Base>
