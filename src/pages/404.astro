---
/** Bilingual 404 (served by GitHub Pages for any unknown path). */
import Base from '@/layouts/Base.astro';
import { t } from '@/i18n/index';
import { appHref, href, withBase } from '@/lib/util/paths';
import { BRAND } from '@content/site/brand';

const blocks = [
  {
    locale: 'ru' as const,
    title: t('ru', 'landing.notFoundTitle'),
    text: t('ru', 'landing.notFoundText'),
    home: t('ru', 'landing.notFoundHome'),
    app: t('ru', 'landing.notFoundApp'),
  },
  {
    locale: 'en' as const,
    title: t('en', 'landing.notFoundTitle'),
    text: t('en', 'landing.notFoundText'),
    home: t('en', 'landing.notFoundHome'),
    app: t('en', 'landing.notFoundApp'),
  },
];
---

<Base locale="ru">
  <Fragment slot="head">
    <title>404 — {BRAND.name}</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={`${blocks[0]!.title} / ${blocks[1]!.title}`} />
  </Fragment>
  <main class="mx-auto flex min-h-dvh max-w-3xl flex-col justify-center gap-10 px-6 py-16">
    <a href={withBase('/')} class="font-display text-3xl">{BRAND.name}</a>
    <h1 class="font-display text-8xl text-muted-2">404</h1>
    <div class="grid gap-8 md:grid-cols-2">
      {
        blocks.map((b) => (
          <section lang={b.locale} class="rounded-card border border-border bg-surface p-6">
            <h2 class="font-display text-3xl">{b.title}</h2>
            <p class="mt-2 text-muted">{b.text}</p>
            <div class="mt-5 flex flex-wrap gap-2">
              <a
                href={href(b.locale, '/')}
                class="inline-flex min-h-11 items-center rounded-pill bg-primary px-4 text-sm font-semibold text-on-primary"
              >
                {b.home}
              </a>
              <a
                href={appHref()}
                class="inline-flex min-h-11 items-center rounded-pill border border-border-strong px-4 text-sm font-semibold"
              >
                {b.app}
              </a>
            </div>
          </section>
        ))
      }
    </div>
  </main>
</Base>
