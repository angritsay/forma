---
/**
 * Exercise library hub: /exercises/ and /en/exercises/. Grouped by movement pattern with anchor
 * navigation; JSON-LD CollectionPage (with ItemList) + BreadcrumbList.
 *
 * The frame is the owner's prototype's (design/CHANGELOG.md §10): the count of movements as the
 * one display-size figure, set larger than the word beside it; the intro kept to a single muted
 * measure because it is the hub's prose for search, not a paragraph for the eye; the patterns as
 * a row of chips (they are pressed, so they stay on the control radius); and each pattern as a
 * numbered heading over rows of still + name + pills. The count line under the heading, the
 * kicker inside every row and the boxed count in every chip went — the figure says the first,
 * the heading says the second, and a count belongs beside the name, not in a box.
 *
 * The count is `FILMED_EXERCISES`, not the whole library: this hub lists movements the coach has
 * actually filmed, because a page with no clip on it has nothing to show (docs/SPEC.md §11). The
 * figure grows on its own the week he films more.
 */
import Landing from '@/layouts/Landing.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import ExerciseCard from '@/components/exercises/ExerciseCard.astro';
import { FILMED_EXERCISES } from '@/content/registry';
import type { Locale } from '@/content/schema';
import { l, plural, t } from '@/i18n/index';
import { exercisesByPattern, patternName } from '@/lib/seo/exercises';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/lib/seo/jsonld';
import { ogImagePath } from '@/lib/seo/meta';
import { canonicalUrl, siteOrigin } from '@/lib/seo/urls';
import { href, localeStaticPaths } from '@/lib/util/paths';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale: Locale = Astro.params.lang === 'en' ? 'en' : 'ru';
const site = siteOrigin(Astro.site);
const sitePath = '/exercises/';
const url = canonicalUrl(site, locale, sitePath);
const title = t(locale, 'seo.exercisesHubTitle');
const description = t(locale, 'seo.exercisesHubDescription');
const groups = exercisesByPattern(locale);
const count = FILMED_EXERCISES.length;
const countWord = plural(locale, count, {
  one: t(locale, 'seo.exerciseWordOne'),
  few: t(locale, 'seo.exerciseWordFew'),
  many: t(locale, 'seo.exerciseWordMany'),
});

const crumbs = [
  { name: t(locale, 'seo.home'), url: canonicalUrl(site, locale, '/'), href: href(locale, '/') },
  { name: t(locale, 'seo.exercises'), url, href: href(locale, sitePath) },
];
const jsonLd = [
  collectionPageJsonLd({
    site,
    locale,
    name: t(locale, 'seo.exercisesHubH1'),
    description,
    url,
    items: groups.flatMap((g) =>
      g.items.map((ex) => ({
        name: l(ex.name, locale),
        url: canonicalUrl(site, locale, `/exercises/${ex.slug[locale]}/`),
      })),
    ),
  }),
  breadcrumbJsonLd(crumbs),
];
---

<Landing
  locale={locale}
  title={title}
  description={description}
  sitePath={sitePath}
  image={ogImagePath('hub', 'exercises', locale)}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-5 pb-16 pt-8 md:pt-12">
    <Breadcrumbs locale={locale} items={crumbs} />

    <!--
      The figure and the heading share one row from `md`: «26 упражнений» on the right at display
      size, the H1 on the left. On a phone they stack in reading order — the name of the page,
      then the number that sizes it — because the H1 has to come first for anything reading the
      document rather than looking at it.
    -->
    <header class="mt-8 md:flex md:items-end md:justify-between md:gap-10">
      <div class="max-w-2xl md:order-1">
        <h1 class="display text-3xl md:text-5xl">{t(locale, 'seo.exercisesHubH1')}</h1>
        <p class="mt-4 max-w-xl text-[15px] leading-relaxed text-muted">
          {t(locale, 'seo.exercisesHubIntro')}
        </p>
      </div>
      {
        count > 0 && (
          <p class="mt-8 flex items-baseline gap-3 md:order-2 md:mt-0 md:shrink-0 md:flex-col md:items-end md:gap-1">
            <span class="display tabular text-7xl leading-none md:text-8xl">{count}</span>
            <span class="eyebrow">{countWord}</span>
          </p>
        )
      }
    </header>

    {
      groups.length === 0 ? (
        <p class="mt-10 border-t border-border pt-5 text-muted">
          {t(locale, 'seo.exercisesHubEmpty')}
        </p>
      ) : (
        <Fragment>
          {/* Pattern anchors as chips — pressed, so 12px, not pills. The count rides along as a
              plain tabular figure. */}
          <nav aria-label={t(locale, 'seo.exercisesHubPatternsNav')} class="mt-10">
            <ul class="flex flex-wrap gap-2">
              {groups.map((g) => (
                <li>
                  <a
                    href={`#pattern-${g.pattern}`}
                    class="tap-target-y control-label inline-flex h-9 items-center gap-2 rounded-control border border-border px-3 text-[13px] text-muted transition-colors duration-150 hover:border-border-strong hover:text-text"
                  >
                    {patternName(g.pattern, locale)}
                    <span class="tabular text-muted-2">{g.items.length}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          {groups.map((g, i) => (
            <section
              id={`pattern-${g.pattern}`}
              class="mt-14 scroll-mt-24"
              aria-labelledby={`pattern-${g.pattern}-title`}
            >
              <h2
                id={`pattern-${g.pattern}-title`}
                class="display flex items-baseline gap-4 text-xl md:text-2xl"
              >
                <span class="numeral tabular shrink-0 text-sm text-muted" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span>{patternName(g.pattern, locale)}</span>
                <span class="numeral tabular ml-auto text-sm text-muted-2" aria-hidden="true">
                  {g.items.length}
                </span>
              </h2>
              <ul class="mt-5 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-3">
                {g.items.map((ex) => (
                  <li>
                    <ExerciseCard exercise={ex} locale={locale} />
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </Fragment>
      )
    }
  </div>
</Landing>
