---
/**
 * Programmatic exercise page: /exercises/<slug>/ (RU) and /en/exercises/<slug>/.
 * Everything on the page comes from the exercise entry and the registry — nothing is invented.
 * JSON-LD: HowTo (steps), BreadcrumbList, VideoObject (public video only), FAQPage.
 */
import Landing from '@/layouts/Landing.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import CourseLinkCard from '@/components/seo/CourseLinkCard.astro';
import FaqAccordion from '@/components/seo/FaqAccordion.astro';
import ExerciseCard from '@/components/exercises/ExerciseCard.astro';
import ExerciseFigure from '@/components/anim/ExerciseFigure';
import { EXERCISES, coursesUsingExercise, getExercise } from '@/content/registry';
import { LOCALES, type Locale } from '@/content/schema';
import { l, t } from '@/i18n/index';
import {
  equipmentNames,
  exerciseFaq,
  exerciseTile,
  levelName,
  muscleName,
  patternName,
  publicVideoUrl,
  relatedExercises,
  scalingExercises,
  unitName,
} from '@/lib/seo/exercises';
import {
  breadcrumbJsonLd,
  faqJsonLd,
  howToJsonLd,
  videoEmbed,
  videoObjectJsonLd,
} from '@/lib/seo/jsonld';
import { exerciseDescription, exerciseTitle, ogImagePath } from '@/lib/seo/meta';
import { canonicalUrl, siteOrigin } from '@/lib/seo/urls';
import { courseTileStyle } from '@/lib/ui/tile';
import { absoluteUrl, href } from '@/lib/util/paths';
import Button from '@/components/landing/Button.astro';

export function getStaticPaths() {
  return EXERCISES.flatMap((ex) =>
    LOCALES.map((locale) => ({
      params: { lang: locale === 'ru' ? undefined : locale, slug: ex.slug[locale] },
      props: { id: ex.id, locale },
    })),
  );
}

interface Props {
  id: string;
  locale: Locale;
}

const { id, locale } = Astro.props;
const ex = getExercise(id);
const site = siteOrigin(Astro.site);
const name = l(ex.name, locale);
const localizedPaths = { ru: `/exercises/${ex.slug.ru}/`, en: `/exercises/${ex.slug.en}/` };
const sitePath = localizedPaths.ru;
const url = canonicalUrl(site, locale, localizedPaths[locale]);
const title = exerciseTitle(ex, locale);
const description = exerciseDescription(ex, locale);
const image = ogImagePath('exercise', ex.id, locale);
const imageUrl = absoluteUrl(site, image);
const tile = exerciseTile(ex);

const courses = coursesUsingExercise(ex.id);
const primary = courses[0];
const { easier, harder } = scalingExercises(ex);
const related = relatedExercises(ex, locale);
const faq = exerciseFaq(ex, locale);
const video = publicVideoUrl(ex, locale);
const embed = video ? videoEmbed(video) : null;

const facts: { label: string; value: string }[] = [
  {
    label: t(locale, 'seo.factMuscles'),
    value: ex.muscles.map((m) => muscleName(m, locale)).join(', '),
  },
  { label: t(locale, 'seo.factPattern'), value: patternName(ex.pattern, locale) },
  { label: t(locale, 'seo.factEquipment'), value: equipmentNames(ex, locale).join(', ') },
  { label: t(locale, 'seo.factLevel'), value: levelName(ex.level, locale) },
  { label: t(locale, 'seo.factUnit'), value: unitName(ex.unit, locale) },
];
if (ex.secondsPerRep) {
  facts.push({
    label: t(locale, 'seo.factTempo'),
    value: t(locale, 'seo.tempoPerRep', { n: ex.secondsPerRep }),
  });
}

const ctaHref = primary
  ? href(locale, `/courses/${primary.slug[locale]}/`)
  : href(locale, '/courses/');
const ctaText = primary
  ? t(locale, 'seo.exerciseCtaText', { name, course: l(primary.name, locale) })
  : t(locale, 'seo.exerciseCtaTextGeneric');
const ctaButton = primary ? t(locale, 'seo.exerciseCtaButton') : t(locale, 'seo.chooseCourse');

const crumbs = [
  { name: t(locale, 'seo.home'), url: canonicalUrl(site, locale, '/'), href: href(locale, '/') },
  {
    name: t(locale, 'seo.exercises'),
    url: canonicalUrl(site, locale, '/exercises/'),
    href: href(locale, '/exercises/'),
  },
  { name, url },
];
const jsonLd = [
  howToJsonLd({ exercise: ex, locale, url, image: imageUrl, description }),
  breadcrumbJsonLd(crumbs),
  video
    ? videoObjectJsonLd({ name, description, url: video, thumbnailUrl: imageUrl, locale })
    : null,
  faqJsonLd(faq),
].filter((x): x is NonNullable<typeof x> => x !== null);
---

<Landing
  locale={locale}
  title={title}
  description={description}
  sitePath={sitePath}
  localizedPaths={localizedPaths}
  image={image}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-5 pb-16 pt-8 md:pt-12">
    <Breadcrumbs locale={locale} items={crumbs} />

    <!-- The tile takes the colour of the course the exercise belongs to; `courseTileStyle()` sets
         the ink for the figure to match. -->
    <section
      class="mt-6 grid items-start gap-8 md:grid-cols-[minmax(0,1fr)_minmax(260px,400px)]"
      style={courseTileStyle(tile)}
    >
      <div>
        <p class="eyebrow flex flex-wrap items-center gap-3">
          <span>{patternName(ex.pattern, locale)}</span>
          {
            ex.isTest && (
              <span class="inline-flex h-6 items-center border border-border-strong px-2.5 text-[11px] tracking-[0.12em] text-text">
                {t(locale, 'seo.exerciseTestBadge')}
              </span>
            )
          }
        </p>
        <h1 class="display mt-4 text-4xl md:text-6xl">{name}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{l(ex.description, locale)}</p>
        <ul class="mt-6 flex flex-wrap gap-2">
          <li
            class="inline-flex h-8.5 items-center border border-border bg-surface-3 px-3 text-[12px] font-semibold tracking-[0.06em] text-text uppercase"
          >
            {levelName(ex.level, locale)}
          </li>
          {
            equipmentNames(ex, locale).map((eq) => (
              <li class="inline-flex h-8.5 items-center border border-border bg-surface-3 px-3 text-[12px] font-semibold tracking-[0.06em] text-text uppercase">
                {eq}
              </li>
            ))
          }
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={ctaHref} size="lg">{ctaButton}</Button>
        </div>
      </div>
      <div class="mx-auto w-full max-w-sm md:max-w-none">
        <div class="hero-art aspect-square w-full overflow-hidden">
          <ExerciseFigure
            client:visible
            animation={ex.animation}
            variant="hero"
            tile={tile}
            label={name}
          />
        </div>
      </div>
    </section>

    <section aria-labelledby="facts-title" class="mt-14">
      <h2 id="facts-title" class="font-display text-xl md:text-2xl">
        {t(locale, 'seo.exerciseFacts')}
      </h2>
      <!-- Facts as a ruled grid: a kicker over a value, no boxes. -->
      <dl class="mt-6 grid grid-cols-2 gap-x-8 sm:grid-cols-3">
        {
          facts.map((f) => (
            <div class="border-t border-border py-4">
              <dt class="eyebrow">{f.label}</dt>
              <dd class="mt-2 font-semibold">{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <div class="mt-14 grid gap-10 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
      <section aria-labelledby="howto-title">
        <h2 id="howto-title" class="font-display text-xl md:text-2xl">
          {t(locale, 'seo.exerciseHowTo')}
        </h2>
        <!-- Steps as numbered hairline rows — the numeral in the margin, the instruction beside. -->
        <ol class="mt-6 divide-y divide-border border-t border-border">
          {
            ex.howTo.map((step, i) => (
              <li class="flex gap-5 py-4">
                <span class="numeral shrink-0 text-sm text-muted" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <p class="leading-relaxed">{l(step, locale)}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <div class="space-y-10">
        <section aria-labelledby="cues-title">
          <h2 id="cues-title" class="font-display text-xl md:text-2xl">
            {t(locale, 'seo.exerciseCues')}
          </h2>
          <ul class="mt-6 divide-y divide-border border-t border-border">
            {
              ex.cues.map((c) => (
                <li class="flex items-baseline gap-3 py-3">
                  <span aria-hidden="true" class="glyph text-sm text-text">
                    ✓
                  </span>
                  <span>{l(c, locale)}</span>
                </li>
              ))
            }
          </ul>
        </section>
        <section aria-labelledby="mistakes-title">
          <h2 id="mistakes-title" class="font-display text-xl md:text-2xl">
            {t(locale, 'seo.exerciseMistakes')}
          </h2>
          <ul class="mt-6 divide-y divide-border border-t border-border">
            {
              ex.mistakes.map((m) => (
                <li class="flex items-baseline gap-3 py-3">
                  <span aria-hidden="true" class="glyph text-sm text-danger">
                    ×
                  </span>
                  <span>{l(m, locale)}</span>
                </li>
              ))
            }
          </ul>
        </section>
        {
          ex.breathing && (
            <section aria-labelledby="breathing-title">
              <h2 id="breathing-title" class="font-display text-xl md:text-2xl">
                {t(locale, 'seo.exerciseBreathing')}
              </h2>
              <p class="mt-6 border-t border-border pt-4 leading-relaxed text-muted">
                {l(ex.breathing, locale)}
              </p>
            </section>
          )
        }
      </div>
    </div>

    {
      (easier || harder) && (
        <section aria-labelledby="scaling-title" class="mt-16">
          <h2 id="scaling-title" class="font-display text-xl md:text-2xl">
            {t(locale, 'seo.exerciseScaling')}
          </h2>
          <ul class="mt-6 grid gap-x-8 gap-y-4 sm:grid-cols-2">
            {[
              { label: t(locale, 'seo.exerciseEasier'), item: easier },
              { label: t(locale, 'seo.exerciseHarder'), item: harder },
            ]
              .filter((x) => x.item)
              .map((x) => (
                <li>
                  <span class="mb-2 block eyebrow">{x.label}</span>
                  <ExerciseCard exercise={x.item!} locale={locale} />
                </li>
              ))}
          </ul>
        </section>
      )
    }

    {
      video && embed && (
        <section aria-labelledby="video-title" class="mt-16">
          <h2 id="video-title" class="font-display text-xl md:text-2xl">
            {t(locale, 'seo.exerciseVideo')}
          </h2>
          <div class="mt-6 aspect-video overflow-hidden border border-border bg-surface">
            {embed.kind === 'file' ? (
              <video controls preload="metadata" class="h-full w-full" src={embed.contentUrl}>
                <p class="p-4 text-muted">{t(locale, 'seo.exerciseVideoUnsupported')}</p>
              </video>
            ) : (
              <iframe
                class="h-full w-full"
                src={embed.embedUrl}
                title={name}
                loading="lazy"
                allow="accelerometer; encrypted-media; picture-in-picture"
                allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"
              />
            )}
          </div>
        </section>
      )
    }

    {
      courses.length > 0 && (
        <section aria-labelledby="courses-title" class="mt-16">
          <h2 id="courses-title" class="font-display text-xl md:text-2xl">
            {t(locale, 'seo.exerciseUsedIn')}
          </h2>
          <ul class="mt-6 grid gap-x-8 md:grid-cols-2">
            {courses.map((c) => (
              <li>
                <CourseLinkCard course={c} locale={locale} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section aria-labelledby="related-title" class="mt-16">
          <h2 id="related-title" class="font-display text-xl md:text-2xl">
            {t(locale, 'seo.exerciseRelated')}
          </h2>
          <ul class="mt-6 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((r) => (
              <li>
                <ExerciseCard exercise={r} locale={locale} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <FaqAccordion title={t(locale, 'seo.faqTitle')} items={faq} />

    <!-- The closing call, set over a hairline like the landing's own CTA — no box, no glow. -->
    <section
      class="mt-16 border-t border-border pt-10 md:flex md:items-end md:justify-between md:gap-8"
    >
      <div>
        <h2 class="font-display text-2xl md:text-3xl">{t(locale, 'seo.exerciseCtaTitle')}</h2>
        <p class="mt-4 max-w-xl leading-relaxed text-muted">{ctaText}</p>
      </div>
      <Button href={ctaHref} size="lg" class="mt-6 shrink-0 md:mt-0">{ctaButton}</Button>
    </section>
  </div>
</Landing>
