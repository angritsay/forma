---
/**
 * Landing home: «Тренировка 1 — сегодня» (site synthesis §2). The page sells one thing first —
 * workout 1 of «Форма с нуля», real, free, no card — and then follows the order the app runs in:
 * today workout 1, from Monday together with someone, every day the club, when needed the coach.
 * JSON-LD: WebSite, Organization, FAQPage, ItemList (the set is unchanged).
 *
 *   hero   «Кроссфит дома. Первая тренировка — сегодня», the email form (`StartForm`) and
 *          «Позвать с собой» right under it
 *   01     workout 1 in three phones, the coach's line, the course it opens, the QR from `lg`
 *   02     «Вместе с понедельника» (`#together`): steps and the invite card (`ShareInvite`)
 *   03     the load follows you: the adaptation demo and the engine's numbers as pills
 *   04     the club (`club/ClubSection`, the club's palette, no neon)
 *   05     the coach and his two tickets
 *   —      before and after, only while there is something publishable
 *   06     prices, one ladder
 *   07     FAQ, then the closing band
 *
 * **Colour.** Neon is workout 1's and nobody else's: the hero form, 01's button, the ladder's
 * first step, the closing band and the phone's sticky bar all go to `#/start`. The club is the
 * warm gradient, the coach's tickets ciel, everything else white or glass.
 *
 * **Numbers are never typed here.** Minutes of work come from the engine (`firstWorkoutFacts`),
 * the adaptation pills from `ADAPTATION` / `CHOICE_VOLUME`, every price from the content files
 * through the blocks that print them.
 */
import Landing from '@/layouts/Landing.astro';
import BeforeAfter from '@/components/landing/BeforeAfter.astro';
import Button from '@/components/landing/Button.astro';
import CoachCard from '@/components/landing/CoachCard.astro';
import CourseCard from '@/components/landing/CourseCard.astro';
import Cta from '@/components/landing/Cta.astro';
import DifficultyDemo from '@/components/landing/DifficultyDemo';
import Faq from '@/components/landing/Faq.astro';
import FirstWorkoutPhones from '@/components/landing/FirstWorkoutPhones.astro';
import Hero from '@/components/landing/Hero.astro';
import Pill from '@/components/landing/Pill.astro';
import PriceLadder from '@/components/landing/PriceLadder.astro';
import QrCode from '@/components/landing/QrCode.astro';
import Section from '@/components/landing/Section.astro';
import SessionTickets from '@/components/landing/SessionTickets.astro';
import ShareInvite from '@/components/landing/ShareInvite';
import StartForm from '@/components/landing/StartForm';
import Steps from '@/components/landing/Steps.astro';
import StickyStart from '@/components/landing/StickyStart.astro';
import ClubSection from '@/components/landing/club/ClubSection.astro';
import {
  buildDemo,
  DEMO_COURSE_ID,
  firstWorkoutFacts,
  firstWorkoutIntro,
} from '@/components/landing/demo';
import { inviteShareAttrs, shareInviteProps } from '@/components/landing/inviteProps';
import { ADAPTATION, CHOICE_VOLUME } from '@/lib/training/constants';
import { courseHref, coursePath } from '@/components/landing/courseHelpers';
import { faqLd, itemListLd, organizationLd, websiteLd } from '@/components/landing/jsonld';
import { COURSE_BY_ID } from '@/content/registry';
import { SITE_COURSES } from '@/content/published';
import { publishableResults } from '@content/site/results';
import type { Locale } from '@/content/schema';
import { l, t } from '@/i18n/index';
import { PHOTOS, photoSrc } from '@/lib/media/photos';
import { canonicalUrl } from '@/lib/seo/urls';
import { absoluteUrl, appHref, href, localeStaticPaths, withBase } from '@/lib/util/paths';
import { BOOKING } from '@content/site/booking';
import { COACH } from '@content/site/coach';
import { ASSESSMENT_TOTAL_MIN } from '@content/site/assessment';
import { FAQ } from '@content/site/faq';
import { LINKS } from '@content/site/links';
import { formatPrice } from '@content/site/pricing';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale: Locale = Astro.params.lang === 'en' ? 'en' : 'ru';
const site = (Astro.site?.toString() ?? 'http://localhost:4321').replace(/\/$/, '');

const title = t(locale, 'landing.homeTitle');
const description = t(locale, 'landing.homeDescription');

const startHref = appHref('/start', { locale });
const signInHref = appHref('', { locale });
const telegramBot = LINKS.telegramBot;

const demoCourse = COURSE_BY_ID.get(DEMO_COURSE_ID) ?? SITE_COURSES[0];
const demo = demoCourse ? buildDemo(locale, demoCourse) : null;
const facts = firstWorkoutFacts(locale, demoCourse);

/*
 * The QR a desktop visitor scans to open workout 1 on the phone: the app's own `/start` in this
 * language, marked `src=qr` so the first touch says where it came from (site synthesis §3, row 8).
 */
const qrUrl = `${absoluteUrl(site, '/app/')}?lang=${locale}&src=qr#/start`;

/*
 * The coach, photographed, with a monochrome placeholder until his picture exists
 * (src/lib/media/photos.ts; decorative — the headline says everything the picture would).
 */
const heroPhoto = COACH.heroPhoto
  ? { src: withBase(COACH.heroPhoto), alt: COACH.name[locale] }
  : { src: photoSrc(PHOTOS.landingHero), alt: '' };

/*
 * The hero's pills: the first white and leaning left, the short «Без прыжков» leaning right. No
 * «Пожизненный доступ» and no «с оборудованием и без» — the page sells workout 1, not a catalogue.
 */
const chips = [
  t(locale, 'landing.heroChipFree'),
  t(locale, 'landing.heroChipTime'),
  t(locale, 'landing.heroChipNoKit'),
  t(locale, 'landing.heroChipVideo'),
  t(locale, 'landing.heroChipNoJumps'),
];

// The engine's constants, as pills under the demo — read from the engine, never retyped.
const factor = (n: number) => new Intl.NumberFormat(locale).format(n);
const percent = (n: number) =>
  new Intl.NumberFormat(locale, { style: 'percent', signDisplay: 'exceptZero' })
    .format(n)
    .replace('-', '−');
const adaptRules = [
  t(locale, 'landing.adaptRuleEasy', { x: percent(ADAPTATION.easyDelta) }),
  t(locale, 'landing.adaptRuleModerate', { x: percent(ADAPTATION.moderateDelta) }),
  t(locale, 'landing.adaptRuleHard', { x: percent(ADAPTATION.hardDelta) }),
  t(locale, 'landing.adaptRulePain', { x: percent(ADAPTATION.painDelta) }),
  t(locale, 'landing.adaptRuleEasier', { x: factor(CHOICE_VOLUME.easier) }),
  t(locale, 'landing.adaptRuleHarder', { x: factor(CHOICE_VOLUME.harder) }),
];
const adaptRows = [
  {
    title: t(locale, 'landing.adaptRow1Title'),
    text: t(locale, 'landing.adaptRow1Text', { n: ASSESSMENT_TOTAL_MIN }),
  },
  { title: t(locale, 'landing.adaptRow2Title'), text: t(locale, 'landing.adaptRow2Text') },
  { title: t(locale, 'landing.adaptRow3Title'), text: t(locale, 'landing.adaptRow3Text') },
];

/**
 * «Позвать с собой»: the Monday message and the `/together/` link, composed in the tap by the same
 * rule the together card uses (`inviteShareAttrs`, `shareHome.ts`).
 */
const share = inviteShareAttrs(locale);

const quietLink =
  'control-label inline-flex min-h-11 items-center gap-2 text-[14px] text-text underline decoration-border-strong underline-offset-4 hover:decoration-text';

const jsonLd = [
  websiteLd(site, locale, description),
  organizationLd(site, locale),
  faqLd(FAQ, locale),
  itemListLd(
    SITE_COURSES.map((c) => ({
      name: l(c.name, locale),
      url: canonicalUrl(site, locale, coursePath(locale, c)),
    })),
    t(locale, 'landing.navCourses'),
  ),
];
---

<Landing locale={locale} title={title} description={description} sitePath="/" jsonLd={jsonLd}>
  <Hero
    title={t(locale, 'landing.heroTitle')}
    thin={t(locale, 'landing.heroThin')}
    keyWords={1}
    subtitle={t(locale, 'landing.heroSubtitle')}
    chips={chips}
    tiltRight={chips.length - 1}
    figure={{ exerciseId: 'knee_push_up' }}
    photo={heroPhoto}
    tileTop={t(locale, 'landing.heroEyebrow')}
  >
    {/* The hero's one neon is the form's button; the sticky bar appears once it scrolls away. */}
    <div slot="action" data-sticky-anchor>
      <StartForm
        client:load
        appUrl={startHref}
        privacyUrl={href(locale, '/privacy/')}
        termsUrl={href(locale, '/terms/')}
        labels={{
          emailLabel: t(locale, 'landing.startEmailLabel'),
          emailPlaceholder: t(locale, 'landing.startEmailPlaceholder'),
          submit: t(locale, 'landing.startCta'),
          hint: t(locale, 'landing.startHint'),
          invalid: t(locale, 'landing.startEmailInvalid'),
          legal: t(locale, 'app.authLegal'),
          legalPrivacy: t(locale, 'app.authLegalPrivacy'),
          legalTerms: t(locale, 'app.authLegalTerms'),
        }}
      />
    </div>
    {
      /*
      «Позвать с собой» right under the form, on every width: the share sheet inside the tap
      where there is one — the Monday message and the /together/ link — otherwise a scroll to the
      together block's card (shareHome.ts).
    */
    }
    <div slot="after" class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2">
      <Button variant="plain" size="lg" class="w-full sm:w-auto" data-goal="share_home" {...share}>
        {t(locale, 'landing.shareCta')}
      </Button>
      <a href={signInHref} class={quietLink} data-app-link>
        {t(locale, 'landing.heroSignIn')}
      </a>
      {
        telegramBot && (
          <a href={telegramBot} class={quietLink} rel="noopener">
            {t(locale, 'landing.openTelegram')}
          </a>
        )
      }
    </div>
  </Hero>

  <Section
    id="first"
    n={1}
    eyebrow={t(locale, 'landing.firstEyebrow')}
    title={t(locale, 'landing.firstTitle')}
    intro={facts ? firstWorkoutIntro(locale, facts) : undefined}
  >
    <FirstWorkoutPhones locale={locale} />

    <figure class="mt-10 max-w-2xl border-l-2 border-accent pl-5">
      <blockquote class="font-display text-xl leading-snug text-balance md:text-2xl">
        «{t(locale, 'landing.firstQuote')}»
      </blockquote>
      <figcaption class="mt-3 text-sm text-muted">— {l(COACH.name, locale)}</figcaption>
    </figure>

    {
      demoCourse && (
        <div class="mt-12 flex flex-col gap-5">
          <div class="flex flex-wrap items-center gap-3">
            <Pill tone="sky" tilt="left">
              {t(locale, 'landing.firstCourseTag')}
            </Pill>
            <span class="text-[15px] text-muted">
              {t(locale, 'landing.firstCoursePrice', {
                price: formatPrice(locale, demoCourse.price),
              })}
            </span>
          </div>
          <CourseCard course={demoCourse} locale={locale} wide />
          <p class="max-w-2xl text-base leading-relaxed text-muted">
            {t(locale, 'landing.firstCourseLine', {
              course: l(demoCourse.shortName ?? demoCourse.name, locale),
            })}{' '}
            <a
              href={courseHref(locale, demoCourse)}
              class="whitespace-nowrap text-text underline decoration-border-strong underline-offset-4 hover:decoration-text"
            >
              {t(locale, 'landing.firstCourseMore')}
              <span class="glyph" aria-hidden="true">
                →
              </span>
            </a>
          </p>
        </div>
      )
    }

    <div class="mt-10 flex flex-wrap items-end justify-between gap-8">
      <Button
        href={startHref}
        size="lg"
        class="w-full sm:w-auto"
        data-goal="app_start"
        data-app-link
      >
        {t(locale, 'landing.firstCta')}
      </Button>
      <QrCode url={qrUrl} label={t(locale, 'landing.qrLabel')} class="max-lg:hidden" />
    </div>
  </Section>

  <Section
    id="together"
    n={2}
    eyebrow={t(locale, 'landing.togetherEyebrow')}
    title={t(locale, 'landing.togetherTitle')}
    intro={t(locale, 'landing.togetherIntro')}
  >
    <Steps
      steps={[
        {
          title: t(locale, 'landing.togetherStep1Title'),
          text: t(locale, 'landing.togetherStep1Text'),
        },
        {
          title: t(locale, 'landing.togetherStep2Title'),
          text: facts
            ? t(locale, 'landing.togetherStep2Text', { total: facts.totalMinutes })
            : t(locale, 'landing.heroChipFree'),
        },
        {
          title: t(locale, 'landing.togetherStep3Title'),
          text: t(locale, 'landing.togetherStep3Text'),
        },
      ]}
    />
    <ShareInvite client:visible class="mt-10" {...shareInviteProps(locale, site)} />
  </Section>

  <Section
    id="adaptive"
    n={3}
    eyebrow={t(locale, 'landing.adaptEyebrow')}
    title={t(locale, 'landing.adaptTitle')}
    intro={t(locale, 'landing.adaptIntro')}
  >
    {demo && <DifficultyDemo client:visible {...demo} />}
    <div class="mt-8 border-t border-border pt-5">
      {/* Body text in the quiet register, not `.eyebrow`: it is a sentence, and past 29 chars. */}
      <h3 class="text-[13px] leading-[1.3] text-muted">{t(locale, 'landing.adaptHowTitle')}</h3>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          adaptRules.map((rule) => (
            <li class="flex max-w-full">
              <Pill size="md">{rule}</Pill>
            </li>
          ))
        }
      </ul>
    </div>
    <ul class="mt-8 grid gap-x-8 md:grid-cols-3">
      {
        adaptRows.map((row) => (
          <li class="flex flex-col gap-2 border-t border-border py-5">
            <h3 class="font-display text-base">{row.title}</h3>
            <p class="text-sm leading-relaxed text-muted">{row.text}</p>
          </li>
        ))
      }
    </ul>
    <div class="mt-6">
      <Button href={startHref} variant="plain" data-goal="app_start" data-app-link>
        {t(locale, 'landing.adaptCta')}
      </Button>
    </div>
  </Section>

  <ClubSection locale={locale} n={4} />

  <Section
    id="coach"
    n={5}
    eyebrow={t(locale, 'landing.coachEyebrow')}
    title={t(locale, 'landing.coachTitle')}
  >
    <CoachCard locale={locale} moreHref={href(locale, '/about/')} book={false} />
    {
      BOOKING.enabled && (
        <>
          <ul class="mt-12 grid gap-x-8 md:grid-cols-3">
            {BOOKING.outcomes.map((o) => (
              <li class="flex flex-col gap-2 border-t border-border py-5">
                <h3 class="font-display text-base">{l(o.title, locale)}</h3>
                <p class="text-sm leading-relaxed text-muted">{l(o.body, locale)}</p>
              </li>
            ))}
          </ul>
          <SessionTickets locale={locale} class="mt-8" />
          <div class="mt-8">
            <Button href={appHref('/book', { locale })} variant="secondary" data-app-link>
              {t(locale, 'landing.ladderCoachCta')}
            </Button>
          </div>
        </>
      )
    }
  </Section>

  {
    /* Social proof sits next to the coach. The whole section is skipped while there is nothing
       publishable, so the landing never shows an empty "before and after" promise. */
    publishableResults().length > 0 && (
      <Section
        id="results"
        eyebrow={t(locale, 'landing.resultsEyebrow')}
        title={t(locale, 'landing.resultsTitle')}
        intro={t(locale, 'app.clubPhotosClientsRow')}
      >
        <BeforeAfter locale={locale} />
      </Section>
    )
  }

  <Section
    id="prices"
    n={6}
    eyebrow={t(locale, 'landing.pricesEyebrow')}
    title={t(locale, 'landing.pricesTitle')}
  >
    <PriceLadder locale={locale} />
  </Section>

  <Section
    id="faq"
    n={7}
    eyebrow={t(locale, 'landing.faqEyebrow')}
    title={t(locale, 'landing.faqTitle')}
  >
    <Faq items={FAQ.map((f) => ({ q: l(f.q, locale), a: l(f.a, locale) }))} />
  </Section>

  <Cta
    title={t(locale, 'landing.homeCtaTitle')}
    text={facts
      ? t(locale, 'landing.homeCtaText', { total: facts.totalMinutes })
      : t(locale, 'landing.heroChipFree')}
    primary={{ label: t(locale, 'landing.startCta'), href: startHref }}
    primaryData={{ 'data-goal': 'app_start', 'data-app-link': true }}
  >
    <Button slot="actions" variant="plain" size="lg" data-goal="share_home" {...share}>
      {t(locale, 'landing.shareCta')}
    </Button>
    <div class="flex flex-wrap items-end justify-between gap-8">
      <p class="max-w-xl text-sm leading-relaxed text-muted">{t(locale, 'landing.homeCtaNote')}</p>
      <QrCode url={qrUrl} label={t(locale, 'landing.qrLabel')} class="max-lg:hidden" />
    </div>
  </Cta>

  <StickyStart locale={locale} />
</Landing>
