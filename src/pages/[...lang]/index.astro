---
/**
 * Landing home: hero, how it works, courses, adaptive-load demo, path & motivation,
 * inside a workout, coach, FAQ, final CTA. JSON-LD: WebSite, Organization, FAQPage, ItemList.
 */
import Landing from '@/layouts/Landing.astro';
import ExerciseFigure from '@/components/anim/ExerciseFigure';
import BeforeAfter from '@/components/landing/BeforeAfter.astro';
import Button from '@/components/landing/Button.astro';
import CoachCard from '@/components/landing/CoachCard.astro';
import CourseCard from '@/components/landing/CourseCard.astro';
import SubscribeBanner from '@/components/landing/SubscribeBanner.astro';
import Cta from '@/components/landing/Cta.astro';
import DifficultyDemo from '@/components/landing/DifficultyDemo';
import Faq from '@/components/landing/Faq.astro';
import FeatureChip from '@/components/landing/FeatureChip.astro';
import Hero from '@/components/landing/Hero.astro';
import PathIllustration from '@/components/landing/PathIllustration.astro';
import PhoneFrame from '@/components/landing/PhoneFrame.astro';
import Section from '@/components/landing/Section.astro';
import Steps from '@/components/landing/Steps.astro';
import { buildDemo, DEMO_COURSE_ID } from '@/components/landing/demo';
import {
  coursePath,
  coursesCountLabel,
  itemTargetLabel,
  sampleWorkout,
} from '@/components/landing/courseHelpers';
import { faqLd, itemListLd, organizationLd, websiteLd } from '@/components/landing/jsonld';
import { COURSE_BY_ID, EXERCISE_BY_ID } from '@/content/registry';
import { SITE_COURSES } from '@/content/published';
import { publishableResults } from '@content/site/results';
import type { Exercise, Locale, WorkoutItem } from '@/content/schema';
import { formatNumber, l, t } from '@/i18n/index';
import { PHOTOS, photoSrc } from '@/lib/media/photos';
import { canonicalUrl } from '@/lib/seo/urls';
import { courseTileStyle } from '@/lib/ui/tile';
import { appHref, href, localeStaticPaths, withBase } from '@/lib/util/paths';
import { COACH } from '@content/site/coach';
import { FAQ } from '@content/site/faq';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale: Locale = Astro.params.lang === 'en' ? 'en' : 'ru';
const site = (Astro.site?.toString() ?? 'http://localhost:4321').replace(/\/$/, '');

const title = t(locale, 'landing.homeTitle');
const description = t(locale, 'landing.homeDescription');

const demoCourse = COURSE_BY_ID.get(DEMO_COURSE_ID) ?? SITE_COURSES[0];
const demo = demoCourse ? buildDemo(locale, demoCourse) : null;
// The demo course's programme colour is the one colour the path and player tiles may take.
const demoTile = demoCourse ? courseTileStyle(demoCourse.tile) : undefined;

// "Inside a workout" tiles use real items of the demo course's first workout.
const insideWorkout = demoCourse ? sampleWorkout(demoCourse) : undefined;
const insideItems: { exercise: Exercise; item: WorkoutItem; restSec: number }[] = [];
if (insideWorkout) {
  const seen = new Set<string>();
  for (const b of insideWorkout.blocks) {
    if (b.type === 'warmup' || b.type === 'cooldown') continue;
    for (const it of b.items) {
      const ex = EXERCISE_BY_ID.get(it.exerciseId);
      if (ex && !seen.has(ex.id)) {
        seen.add(ex.id);
        insideItems.push({
          exercise: ex,
          item: it,
          restSec: it.restAfterSec ?? b.restBetweenSetsSec ?? b.restSec ?? 0,
        });
      }
      if (insideItems.length >= 2) break;
    }
    if (insideItems.length >= 2) break;
  }
}
const explainTile = insideItems[0];
const workTile = insideItems[1] ?? insideItems[0];
const restSec = insideItems.find((x) => x.restSec > 0)?.restSec ?? 0;

const chips = [
  SITE_COURSES.length > 0 ? coursesCountLabel(locale, SITE_COURSES.length) : '',
  t(locale, 'landing.chipLifetime'),
  t(locale, 'landing.chipAdaptive'),
  t(locale, 'landing.chipHome'),
].filter(Boolean);

const weekdays = t(locale, 'landing.pathWeekdays').split(',');

/*
 * The coach's own photograph wins; until it exists the hero shows the monochrome placeholder
 * from src/lib/media/photos.ts (decorative — the headline says everything the picture would).
 */
const heroPhoto = COACH.heroPhoto
  ? { src: withBase(COACH.heroPhoto), alt: COACH.name[locale] }
  : { src: photoSrc(PHOTOS.landingHero), alt: '' };

// Leaderboard demo rows: three neutral avatars, the visitor's row picked out by the white bar.
const boardRows = [
  { w: '100%', you: false },
  { w: '78%', you: true },
  { w: '61%', you: false },
];

const jsonLd = [
  websiteLd(site, locale, description),
  organizationLd(site, locale),
  faqLd(FAQ, locale),
  itemListLd(
    SITE_COURSES.map((c) => ({
      name: l(c.name, locale),
      url: canonicalUrl(site, locale, coursePath(locale, c)),
    })),
    t(locale, 'landing.navCourses'),
  ),
];
---

<Landing locale={locale} title={title} description={description} sitePath="/" jsonLd={jsonLd}>
  <Hero
    title={t(locale, 'landing.heroTitle')}
    subtitle={t(locale, 'landing.heroSubtitle')}
    primary={{ label: t(locale, 'landing.heroCtaCourses'), href: href(locale, '/courses/') }}
    secondary={{ label: t(locale, 'landing.heroCtaApp'), href: appHref() }}
    chips={chips}
    figure={{ animation: 'burpee', label: t(locale, 'landing.heroFigureAlt') }}
    photo={heroPhoto}
    tileTop={t(locale, 'landing.heroTileTop')}
    tileBottom={t(locale, 'landing.heroTileBottom')}
  />

  <Section
    id="how"
    n={1}
    eyebrow={t(locale, 'landing.howEyebrow')}
    title={t(locale, 'landing.howTitle')}
  >
    <Steps
      steps={[
        { title: t(locale, 'landing.howStep1Title'), text: t(locale, 'landing.howStep1Text') },
        { title: t(locale, 'landing.howStep2Title'), text: t(locale, 'landing.howStep2Text') },
        { title: t(locale, 'landing.howStep3Title'), text: t(locale, 'landing.howStep3Text') },
      ]}
    />
  </Section>

  <Section
    id="courses"
    n={2}
    eyebrow={t(locale, 'landing.coursesEyebrow')}
    title={t(locale, 'landing.coursesTitle')}
    intro={t(locale, 'landing.coursesIntro')}
  >
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        SITE_COURSES.map((c, i) => (
          <li>
            <CourseCard course={c} locale={locale} n={i + 1} />
          </li>
        ))
      }
    </ul>
    <div class="mt-8">
      <Button href={href(locale, '/courses/')} variant="secondary">
        {t(locale, 'landing.coursesAll')}
        <span class="glyph" aria-hidden="true">→</span>
      </Button>
    </div>
    <SubscribeBanner locale={locale} class="mt-12" />
  </Section>

  {
    demo && (
      <Section
        id="adaptive"
        eyebrow={t(locale, 'landing.adaptEyebrow')}
        title={t(locale, 'landing.adaptTitle')}
        intro={t(locale, 'landing.adaptIntro')}
      >
        <DifficultyDemo client:visible {...demo} />
        <div class="mt-10 border-t border-border pt-5">
          <h3 class="eyebrow-sentence">{t(locale, 'landing.adaptHowTitle')}</h3>
          <ol class="mt-4 grid gap-x-8 text-sm leading-relaxed md:grid-cols-3">
            {[
              t(locale, 'landing.adaptHow1'),
              t(locale, 'landing.adaptHow2'),
              t(locale, 'landing.adaptHow3'),
            ].map((rule, i) => (
              <li class="flex items-baseline gap-4 border-t border-border py-4">
                <span class="numeral text-sm text-muted" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span>{rule}</span>
              </li>
            ))}
          </ol>
        </div>
      </Section>
    )
  }

  <Section
    id="path"
    n={3}
    eyebrow={t(locale, 'landing.pathEyebrow')}
    title={t(locale, 'landing.pathTitle')}
    intro={t(locale, 'landing.pathIntro')}
  >
    <div class="grid items-start gap-10 lg:grid-cols-[320px_minmax(0,1fr)] lg:gap-14">
      {
        demoCourse && (
          <PhoneFrame label={`${l(demoCourse.name, locale)} — ${t(locale, 'landing.pathEyebrow')}`}>
            <PathIllustration
              locale={locale}
              courseName={l(demoCourse.name, locale)}
              nodes={demoCourse.nodes}
              tile={demoCourse.tile}
            />
          </PhoneFrame>
        )
      }
      <!--
        Three facts as hairline columns rather than three cards. No icon on the streak — the
        row of days is the picture — and the visitor's row on the board is the one white bar.
      -->
      <div class="grid gap-x-8 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-3">
        <article class="flex flex-col gap-4 border-t border-border py-6">
          <div class="flex items-center justify-between gap-3">
            <span class="numeral text-sm text-muted" aria-hidden="true">01</span>
            <FeatureChip tone="accent" size="sm">{t(locale, 'landing.pathStreakBonus')}</FeatureChip
            >
          </div>
          <ul class="flex gap-1.5" aria-hidden="true">
            {
              weekdays.map((d, i) => (
                <li
                  class={`numeral flex size-8 items-center justify-center text-[11px] ${
                    i < 3
                      ? 'bg-primary text-on-primary'
                      : i === 3
                        ? 'border border-primary text-text'
                        : 'border border-border text-muted-2'
                  }`}
                >
                  {d}
                </li>
              ))
            }
          </ul>
          <h3 class="font-display text-base">{t(locale, 'landing.pathStreakTitle')}</h3>
          <p class="text-sm leading-relaxed text-muted">{t(locale, 'landing.pathStreakText')}</p>
        </article>

        <article class="flex flex-col gap-4 border-t border-border py-6">
          <span class="numeral text-sm text-muted" aria-hidden="true">02</span>
          <div class="flex items-center gap-4">
            <!-- Ring: square (butt) caps, white stroke — the day's goal, not a course. -->
            <svg width="72" height="72" viewBox="0 0 72 72" aria-hidden="true" class="shrink-0">
              <circle
                cx="36"
                cy="36"
                r="30"
                fill="none"
                stroke="currentColor"
                class="text-surface-3"
                stroke-width="6"></circle>
              <circle
                cx="36"
                cy="36"
                r="30"
                fill="none"
                stroke="currentColor"
                class="text-primary"
                stroke-width="6"
                stroke-linecap="butt"
                stroke-dasharray="188.5"
                stroke-dashoffset="75"
                transform="rotate(-90 36 36)"></circle>
            </svg>
            <div>
              <p class="numeral tabular text-3xl">{formatNumber(locale, 7000)}</p>
              <p class="mt-1 text-xs text-muted">
                {t(locale, 'common.steps')} · {t(locale, 'landing.pathStepsGoal')}
              </p>
            </div>
          </div>
          <h3 class="font-display text-base">{t(locale, 'landing.pathStepsTitle')}</h3>
          <p class="text-sm leading-relaxed text-muted">{t(locale, 'landing.pathStepsText')}</p>
        </article>

        <article class="flex flex-col gap-4 border-t border-border py-6">
          <span class="numeral text-sm text-muted" aria-hidden="true">03</span>
          <ol class="flex flex-col gap-2" aria-hidden="true">
            {
              boardRows.map((row, i) => (
                <li class="flex items-center gap-2 text-xs">
                  <span class="numeral w-4 text-right text-muted">{i + 1}</span>
                  <span
                    class={`size-6 shrink-0 ${row.you ? 'bg-surface-3' : 'border border-border bg-surface-2'}`}
                  />
                  <span class="h-1 flex-1 overflow-hidden bg-surface-3">
                    <span
                      class={`block h-full ${row.you ? 'bg-primary' : 'bg-border-strong'}`}
                      style={`width:${row.w}`}
                    />
                  </span>
                  {row.you && (
                    <span class="inline-flex h-5 items-center bg-primary px-1.5 text-[10px] font-semibold tracking-[0.12em] text-on-primary uppercase">
                      {t(locale, 'landing.pathYou')}
                    </span>
                  )}
                </li>
              ))
            }
          </ol>
          <h3 class="font-display text-base">{t(locale, 'landing.pathBoardTitle')}</h3>
          <p class="text-sm leading-relaxed text-muted">{t(locale, 'landing.pathBoardText')}</p>
        </article>
      </div>
    </div>
  </Section>

  <Section
    id="inside"
    n={4}
    eyebrow={t(locale, 'landing.insideEyebrow')}
    title={t(locale, 'landing.insideTitle')}
    intro={t(locale, 'landing.insideIntro')}
  >
    <Steps
      columns={4}
      steps={[
        {
          title: t(locale, 'landing.insideStep1Title'),
          text: t(locale, 'landing.insideStep1Text'),
        },
        {
          title: t(locale, 'landing.insideStep2Title'),
          text: t(locale, 'landing.insideStep2Text'),
        },
        {
          title: t(locale, 'landing.insideStep3Title'),
          text: t(locale, 'landing.insideStep3Text'),
        },
        {
          title: t(locale, 'landing.insideStep4Title'),
          text: t(locale, 'landing.insideStep4Text'),
        },
      ]}
    />
    {
      explainTile && workTile && (
        /* The player's three beats, on the demo course's colour. One screen, one colour. */
        <div class="mt-8 grid gap-4 md:grid-cols-3" style={demoTile}>
          <div class="overflow-hidden border border-border bg-surface">
            <div class="eyebrow flex items-center justify-between px-5 py-3">
              <span>{t(locale, 'landing.insideStep1Title')}</span>
              <span class="numeral text-text">1/3</span>
            </div>
            <div class="hero-art flex aspect-square items-center justify-center">
              <ExerciseFigure
                animation={explainTile.exercise.animation}
                variant="card"
                playing={false}
                tile={demoCourse?.tile}
                label={l(explainTile.exercise.name, locale)}
              />
            </div>
            <div class="border-t border-border p-5">
              <p class="font-display text-sm">{l(explainTile.exercise.name, locale)}</p>
              <p class="mt-2 text-sm text-muted">{l(explainTile.exercise.cues[0]!, locale)}</p>
            </div>
          </div>

          <div class="overflow-hidden border border-border bg-surface">
            <div class="eyebrow flex items-center justify-between px-5 py-3">
              <span>
                {workTile.item.seconds !== undefined
                  ? t(locale, 'landing.insideTimerLabel')
                  : t(locale, 'landing.insideRepsLabel')}
              </span>
              <span class="numeral text-text">2/3</span>
            </div>
            <div class="hero-art relative flex aspect-square items-center justify-center">
              <ExerciseFigure
                client:visible
                animation={workTile.exercise.animation}
                variant="card"
                tile={demoCourse?.tile}
                label={l(workTile.exercise.name, locale)}
              />
              <span class="numeral tabular absolute right-4 bottom-4 bg-ink/85 px-3 py-1.5 text-sm text-paper">
                {itemTargetLabel(locale, workTile.item)}
              </span>
            </div>
            <div class="border-t border-border p-5">
              <p class="font-display text-sm">{l(workTile.exercise.name, locale)}</p>
              <p class="mt-2 text-sm text-muted">
                {l(workTile.exercise.cues[1] ?? workTile.exercise.cues[0]!, locale)}
              </p>
            </div>
          </div>

          <div class="overflow-hidden border border-border bg-surface">
            <div class="eyebrow flex items-center justify-between px-5 py-3">
              <span>{t(locale, 'landing.insideRestLabel')}</span>
              <span class="numeral text-text">3/3</span>
            </div>
            <div class="relative flex aspect-square flex-col items-center justify-center bg-surface-2">
              {/* Rest ring: the stroke is the course colour, the same as the app's progress. */}
              <svg width="120" height="120" viewBox="0 0 120 120" aria-hidden="true">
                <circle
                  cx="60"
                  cy="60"
                  r="52"
                  fill="none"
                  stroke="currentColor"
                  class="text-surface-3"
                  stroke-width="6"
                />
                <circle
                  cx="60"
                  cy="60"
                  r="52"
                  fill="none"
                  stroke="var(--course-tile, var(--primary))"
                  stroke-width="6"
                  stroke-linecap="butt"
                  stroke-dasharray="326.7"
                  stroke-dashoffset="110"
                  transform="rotate(-90 60 60)"
                />
              </svg>
              {restSec > 0 && (
                <p class="numeral tabular absolute text-2xl">
                  {restSec} {t(locale, 'training.seconds')}
                </p>
              )}
            </div>
            <div class="border-t border-border p-5">
              <p class="font-display text-sm">{t(locale, 'training.rest')}</p>
              <p class="mt-2 text-sm text-muted">{t(locale, 'landing.insideStep4Text')}</p>
            </div>
          </div>
        </div>
      )
    }
  </Section>

  {
    /* Social proof sits next to the coach. The whole section is skipped while there is nothing
       publishable, so the landing never shows an empty "before and after" promise. */
    publishableResults().length > 0 && (
      <Section
        id="results"
        eyebrow={t(locale, 'landing.resultsEyebrow')}
        title={t(locale, 'landing.resultsTitle')}
        intro={t(locale, 'landing.resultsIntro')}
      >
        <BeforeAfter locale={locale} />
      </Section>
    )
  }

  <Section
    id="coach"
    n={5}
    eyebrow={t(locale, 'landing.coachEyebrow')}
    title={t(locale, 'landing.navAbout')}
  >
    <CoachCard locale={locale} moreHref={href(locale, '/about/')} />
  </Section>

  <Section
    id="faq"
    n={6}
    eyebrow={t(locale, 'landing.faqEyebrow')}
    title={t(locale, 'landing.faqTitle')}
  >
    <Faq items={FAQ.map((f) => ({ q: l(f.q, locale), a: l(f.a, locale) }))} />
  </Section>

  <Cta
    title={t(locale, 'landing.ctaTitle')}
    text={t(locale, 'landing.ctaText')}
    primary={{ label: t(locale, 'landing.ctaPrimary'), href: href(locale, '/courses/') }}
    secondary={{ label: t(locale, 'landing.ctaSecondary'), href: appHref() }}
  />
</Landing>
