---
/**
 * Landing home. Placeholder during scaffolding — the landing area replaces this file.
 */
import Base from '@/layouts/Base.astro';
import { t } from '@/i18n/index';
import { appHref } from '@/lib/util/paths';
import type { Locale } from '@/content/schema';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'en' } }];
}

const locale: Locale = Astro.params.lang === 'en' ? 'en' : 'ru';
---

<Base locale={locale}>
  <Fragment slot="head">
    <title>{t(locale, 'common.brand')} — {t(locale, 'common.tagline')}</title>
    <meta name="description" content={t(locale, 'common.tagline')} />
  </Fragment>
  <main
    class="mx-auto flex min-h-dvh max-w-3xl flex-col items-center justify-center gap-6 px-6 text-center"
  >
    <h1 class="font-display text-6xl">{t(locale, 'common.brand')}</h1>
    <p class="text-muted text-lg">{t(locale, 'common.tagline')}</p>
    <a class="bg-primary text-on-primary rounded-pill px-6 py-3 font-semibold" href={appHref()}>
      {t(locale, 'common.openApp')}
    </a>
  </main>
</Base>
