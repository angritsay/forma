---
/**
 * Как заплатить тому, у кого нет рублей.
 *
 * Сайт выходит на двух языках, а касса одна: Prodamus, по-русски, в рублях. Английский читатель
 * доходил до кнопки «купить» и упирался в стену ровно в тот момент, когда решился платить —
 * ссылка вела на страницу, которую он не может ни прочитать, ни оплатить.
 *
 * Решение владельца: вести его сюда. Перевод, почта в комментарии, и кнопка «написать нам» —
 * чтобы человек, у которого что-то пошло не так, попадал к живому человеку, а не в поддержку,
 * которой нет.
 *
 * ## Почему страница, а не блок на странице курса
 *
 * По ссылке её можно прислать в личку — а именно так этот путь и работает: кто-то напишет раньше,
 * чем заплатит. Адрес один (`/en/checkout/`), и он же уезжает во все нерусские кнопки «купить».
 *
 * ## Только для тех языков, у которых кассы нет
 *
 * `getStaticPaths` возвращает не `localeStaticPaths()`, а только неродные языки. Русская
 * `/checkout/` была бы страницей про то, как обойти кассу, которая для русского читателя работает.
 * По той же причине `localizedPaths` перечисляет только эти языки: `alternates()` пропускает язык,
 * которого в карте нет, и hreflang не обещает русскую версию, которой не существует.
 *
 * ## Здесь нет автоматики, и это видно
 *
 * `prodamus-webhook` про эти деньги не узнает: PayPal про Forma не знает ничего. Значит доступ
 * открывается руками в админке («Покупки», «Подписки»), а почта в комментарии к переводу —
 * единственное, что связывает платёж с человеком. Поэтому инструкция просит её дважды: в переводе
 * и в сообщении.
 *
 * `noindex`: страница для тех, кого сюда привели, а не для поиска. В выдаче «как заплатить, если
 * касса не работает» — не то, с чего стоит начинать знакомство.
 */
import Landing from '@/layouts/Landing.astro';
import { LOCALES, type Locale } from '@/content/schema';
import { DEFAULT_LOCALE, l, t } from '@/i18n/index';
import { CHECKOUT_PATH } from '@/lib/util/payment';
import { href } from '@/lib/util/paths';
import { BRAND } from '@content/site/brand';
import { LINKS } from '@content/site/links';
import { hasPaymentHelp, hasPaypal, PAYMENTS } from '@content/site/payments';

const MANUAL_LOCALES = LOCALES.filter((loc) => loc !== DEFAULT_LOCALE);

export function getStaticPaths() {
  // Русскому читателю касса доступна — страницы про обход кассы у него быть не должно.
  return LOCALES.filter((loc) => loc !== DEFAULT_LOCALE).map((loc) => ({
    params: { lang: loc },
  }));
}

const locale = (Astro.params.lang ?? DEFAULT_LOCALE) as Locale;
const title = t(locale, 'landing.checkoutTitle');
const description = t(locale, 'landing.checkoutLead');

const localizedPaths = Object.fromEntries(
  MANUAL_LOCALES.map((loc) => [loc, CHECKOUT_PATH]),
) as Partial<Record<Locale, string>>;

const steps = [
  { heading: t(locale, 'landing.checkoutStep1'), body: t(locale, 'landing.checkoutStep1Body') },
  { heading: t(locale, 'landing.checkoutStep2'), body: t(locale, 'landing.checkoutStep2Body') },
  { heading: t(locale, 'landing.checkoutStep3'), body: t(locale, 'landing.checkoutStep3Body') },
];

const paypal = hasPaypal();
const help = hasPaymentHelp();
const ownNote = PAYMENTS.note ? l(PAYMENTS.note, locale) : '';
// Widened to `string`: the config literal is '' until the owner fills it in.
const email: string = LINKS.supportEmail || BRAND.contactEmail;

const primary =
  'control-label inline-flex h-12 items-center justify-center rounded-control bg-primary px-6 ' +
  'text-[15px] text-on-primary transition-[opacity,transform] duration-150 ease-(--ease-out) ' +
  'hover:opacity-85 active:scale-[0.98]';
const secondary =
  'control-label inline-flex h-12 items-center justify-center rounded-control border ' +
  'border-border-strong px-6 text-[15px] text-text transition-colors duration-150 ' +
  'ease-(--ease-out) hover:bg-surface-2';
---

<Landing
  locale={locale}
  title={title}
  description={description}
  sitePath={CHECKOUT_PATH}
  localizedPaths={localizedPaths}
  noindex
  jsonLd={null}
>
  <div class="mx-auto max-w-3xl px-5 pt-8 pb-12 md:pt-12 md:pb-20">
    <h1 class="display mt-8 text-4xl md:text-6xl">{title}</h1>
    <p class="mt-4 max-w-xl text-[15px] leading-relaxed text-muted md:text-base">{description}</p>

    {
      /*
      Шаги нумерованы, потому что это действительно последовательность: пока не сделан первый,
      второй бессмысленен. Тот случай, когда номера несут смысл, а не украшают.

      И по той же причине их нет, пока не вписан PayPal: первый шаг — «сделай перевод по ссылке
      ниже», а ссылки ниже ещё нет. Инструкция, обещающая кнопку, которой на странице не видно,
      читается как поломка. Остаётся лид, строчка о том, что реквизитов пока нет, и живой человек.
    */
    }
    {
      paypal ? (
        <ol class="mt-10 flex flex-col divide-y divide-border border-t border-b border-border">
          {steps.map((s, i) => (
            <li class="flex items-baseline gap-4 py-4">
              <span class="numeral tabular w-6 shrink-0 text-sm text-text" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="min-w-0">
                <h2 class="font-display text-base md:text-lg">{s.heading}</h2>
                <p class="mt-1.5 max-w-xl text-[15px] leading-relaxed text-muted">{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
      ) : null
    }

    {ownNote ? <p class="mt-6 max-w-xl text-[15px] leading-relaxed text-muted">{ownNote}</p> : null}

    {
      /*
      Ни реквизитов, ни телеграма ещё не вписали (content/site/payments.ts) — тогда страница
      говорит то единственное, что в этом случае правда, и не делает вид, что инструкция полная.
      Стоит над кнопками, а не под ними: это объяснение, почему кнопки, которую человек искал,
      на странице нет. Почта здесь всегда есть — она в BRAND и не бывает пустой.
    */
    }
    {
      !paypal || !help ? (
        <p class="mt-8 max-w-xl text-[15px] leading-relaxed text-muted">
          {!paypal ? t(locale, 'landing.checkoutNoPaypal') : ''}
          {!paypal && !help ? ' ' : ''}
          {!help ? t(locale, 'landing.checkoutNoHelp', { email }) : ''}
        </p>
      ) : null
    }

    <div class="mt-8 flex flex-wrap items-center gap-3">
      {
        paypal ? (
          <a class={primary} href={PAYMENTS.paypal} rel="noopener noreferrer" target="_blank">
            {t(locale, 'landing.checkoutPaypal')}
          </a>
        ) : null
      }
      {
        help ? (
          <a
            class={paypal ? secondary : primary}
            href={PAYMENTS.helpTelegram}
            rel="noopener noreferrer"
            target="_blank"
          >
            {t(locale, 'landing.checkoutWrite')}
          </a>
        ) : null
      }
      <a class={secondary} href={href(locale, '/courses/')}>
        {t(locale, 'landing.checkoutBackToCourses')}
      </a>
    </div>
  </div>
</Landing>
