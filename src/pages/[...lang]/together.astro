---
/**
 * `/together/` — the page a friend opens from «Давай с понедельника вместе» (site synthesis §4).
 *
 * Indexable and in the sitemap (`STATIC_PAGES`), with one canonical URL and no query in it: the
 * link people forward carries `?d=…&from=…&ref=…`, and none of those three is ever written into
 * the HTML. The build knows nothing about who sent the link, so every personal line is filled in
 * by the page's script, from the address bar, through the invite's validators:
 *
 * - `from` → `cleanName` (letters, marks, spaces, hyphens, ≤ 16) → the eyebrow «{Имя} зовёт тебя»,
 *   set with `textContent` only. Never in `<title>`, the H1 or the preview image — the preview is
 *   one static card (`hub-together-*`), so nobody can make a link that previews their own words.
 * - `d` → `validDate` (a Monday in Moscow, today … +14 days, else the coming Monday) → the lead,
 *   «Понедельник, 5 октября — первая тренировка».
 * - `ref` → the layout's `bindVisit` and this script both hand it to `acceptReferral`: stashed
 *   for the app when it has the code's shape, first code wins, and never when it is the visitor's
 *   own (`forma.myRef`) — then the page says «Это твоя ссылка — отправь её». While a code is
 *   pending, every `[data-app-link]` carries it and `[data-club-join]` goes through the app's
 *   club screen, so the +30 days attach before any payment. The club block switches to its
 *   with-code line.
 *
 * Sections, visual-first like the homepage: the blue hero field (H1 «Тренируемся вместе с
 * понедельника», one line, the homepage's three pills, the neon «Начать с тренировки 1» — the
 * page's one neon — and «Ответить: я в деле») beside the coach's loop; the first week as workout
 * 1's three movements, filmed, with the coach's counts, and the course's path in a phone beside
 * them from `lg`; «Вдвоём в клубе» (`club/TogetherClub`: the club in a phone, tiles, the price,
 * the photographs; warm, no neon); the compact `ShareInvite` for «Позвать ещё кого-то»; three
 * questions. JSON-LD: FAQPage and BreadcrumbList.
 */
import Landing from '@/layouts/Landing.astro';
import Breadcrumbs from '@/components/landing/Breadcrumbs.astro';
import Button from '@/components/landing/Button.astro';
import Faq from '@/components/landing/Faq.astro';
import HeroField from '@/components/landing/HeroField.astro';
import KeyTitle from '@/components/landing/KeyTitle.astro';
import PathPhone from '@/components/landing/PathPhone.astro';
import Pill from '@/components/landing/Pill.astro';
import Section from '@/components/landing/Section.astro';
import ShareInvite from '@/components/landing/ShareInvite';
import TogetherClub from '@/components/landing/club/TogetherClub.astro';
import LoopTile from '@/components/landing/media/LoopTile.astro';
import LoopVideo from '@/components/landing/media/LoopVideo.astro';
import { DEMO_COURSE_ID, firstWorkoutFacts } from '@/components/landing/demo';
import { filmedFacts } from '@/components/landing/filmed';
import { shareInviteProps } from '@/components/landing/inviteProps';
import { breadcrumbLd, faqLd } from '@/components/landing/jsonld';
import { COURSE_BY_ID } from '@/content/registry';
import { SITE_COURSES } from '@/content/published';
import type { Locale } from '@/content/schema';
import { l, t } from '@/i18n/index';
import { ogImagePath } from '@/lib/seo/meta';
import { canonicalUrl } from '@/lib/seo/urls';
import { appHref, href, localeStaticPaths, withBase } from '@/lib/util/paths';
import { COACH } from '@content/site/coach';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale: Locale = Astro.params.lang === 'en' ? 'en' : 'ru';
const site = (Astro.site?.toString() ?? 'http://localhost:4321').replace(/\/$/, '');

const title = t(locale, 'seo.togetherTitle');
const description = t(locale, 'seo.togetherDescription');
const h1 = t(locale, 'landing.togetherH1');
/* Heavy for the first two words, light up to the key word: «Тренируемся вместе | с | понедельника». */
const thin = ` ${h1.split(' ').slice(2).join(' ')}`;

const startHref = appHref('/start', { locale });
const demoCourse = COURSE_BY_ID.get(DEMO_COURSE_ID) ?? SITE_COURSES[0];
const facts = firstWorkoutFacts(locale, demoCourse);

/* The lead, split around its date so the script can replace only that span (textContent). */
const leadTemplate = t(locale, 'landing.togetherLead', {
  total: facts ? String(facts.totalMinutes) : '',
});
const [leadBefore = '', leadAfter = ''] = leadTemplate.split('{date}');

/* The homepage hero's pills, the same three facts in the same order. */
const chips = [
  t(locale, 'landing.heroChipNoJumps'),
  t(locale, 'landing.heroChipVideo'),
  t(locale, 'landing.heroChipAdapt'),
];
const rightTilt = chips.length - 1;

/* The coach on video beside the field: the homepage's hero loop, his photograph until it plays. */
const filmed = demoCourse ? filmedFacts(demoCourse) : null;
const loopId = filmed?.training.includes('reverse_lunge')
  ? 'reverse_lunge'
  : (filmed?.training[0] ?? 'reverse_lunge');

const faq = [1, 2, 3].map((n) => ({
  q: t(locale, `landing.togetherFaq${n}Q` as 'landing.togetherFaq1Q'),
  a: t(locale, `landing.togetherFaq${n}A` as 'landing.togetherFaq1A'),
}));

const jsonLd = [
  breadcrumbLd([
    { name: t(locale, 'landing.breadcrumbHome'), url: canonicalUrl(site, locale, '/') },
    { name: t(locale, 'landing.navTogether'), url: canonicalUrl(site, locale, '/together/') },
  ]),
  faqLd(
    faq.map((f) => ({ q: { ru: f.q, en: f.q }, a: { ru: f.a, en: f.a } })),
    locale,
  ),
];
---

<Landing
  locale={locale}
  title={title}
  description={description}
  sitePath="/together/"
  image={ogImagePath('hub', 'together', locale)}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-5 pt-8 md:pt-12" data-together data-locale={locale}>
    <Breadcrumbs
      ariaLabel={t(locale, 'landing.breadcrumbHome')}
      items={[
        { label: t(locale, 'landing.breadcrumbHome'), href: href(locale, '/') },
        { label: t(locale, 'landing.navTogether') },
      ]}
    />

    <p
      class="mt-6 border-l-2 border-accent pl-3 text-[14px] leading-snug text-text"
      data-inapp-hint
      hidden
    >
      {t(locale, 'landing.togetherInApp')}
    </p>

    <div class="mt-6 grid items-end gap-6 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:gap-10">
      <div
        class="relative aspect-[4/3] overflow-hidden rounded-card border border-border bg-surface md:order-2 md:aspect-[4/5]"
      >
        <LoopVideo
          id={loopId}
          poster={withBase(COACH.heroPhoto)}
          alt={l(COACH.name, locale)}
          eager
          class="object-[35%_30%]"
        />
        <div class="photo-grain" aria-hidden="true"></div>
      </div>
      <div class="md:order-1">
        <HeroField>
          {/* Filled by the script with textContent; the HTML says only «Приглашение». */}
          <p
            class="eyebrow"
            data-together-eyebrow
            data-template={t(locale, 'landing.togetherEyebrowFrom')}
          >
            {t(locale, 'landing.togetherEyebrowPlain')}
          </p>
          <KeyTitle
            text={h1}
            keyWords={1}
            thin={thin}
            class="display mt-4 max-w-[18ch] text-[clamp(1.75rem,7vw,2.75rem)]"
          />
          <p class="field-lead mt-5 max-w-xl text-base leading-snug md:text-lg">
            {leadBefore}<span data-together-date>{t(locale, 'landing.togetherLeadSoon')}</span>{
              leadAfter
            }
          </p>
          <ul class="mt-6 flex flex-wrap gap-2">
            {
              chips.map((c, i) => (
                <li class="flex max-w-full">
                  <Pill
                    size="md"
                    tone={i === 0 ? 'white' : 'ghost'}
                    tilt={i === 0 ? 'left' : i === rightTilt ? 'right' : undefined}
                  >
                    {c}
                  </Pill>
                </li>
              ))
            }
          </ul>
        </HeroField>

        <div class="mt-5 flex flex-col gap-3">
          <div class="flex flex-wrap items-center gap-3">
            <Button
              href={startHref}
              variant="primary"
              size="lg"
              class="w-full sm:w-auto"
              data-goal="app_start"
              data-app-link
            >
              {t(locale, 'landing.togetherStart')}
              <span class="glyph" aria-hidden="true">→</span>
            </Button>
            <Button
              variant="plain"
              size="lg"
              class="w-full sm:w-auto"
              data-reply
              data-reply-text={t(locale, 'landing.togetherReplyText')}
              data-reply-done={t(locale, 'landing.togetherReplyDone')}
              data-reply-failed={t(locale, 'landing.togetherReplyFailed')}
              data-goal="together_reply"
            >
              <span data-reply-label aria-live="polite">{t(locale, 'landing.togetherReply')}</span>
            </Button>
          </div>
          <p class="text-[13px] leading-snug text-muted">{t(locale, 'landing.startHint')}</p>
          <p
            class="border-l-2 border-accent pl-3 text-[14px] leading-snug text-text"
            data-own-link
            hidden
          >
            {t(locale, 'landing.togetherOwnLink')}
          </p>
        </div>
      </div>
    </div>
  </div>

  <Section id="week" title={t(locale, 'landing.togetherWeekTitle')}>
    {
      facts && (
        <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,1fr)_260px] lg:gap-12">
          <ul class="-mx-5 flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-px-5 px-5 pb-2 sm:mx-0 sm:grid sm:grid-cols-3 sm:overflow-visible sm:px-0">
            {facts.moves.map((m) => (
              <li class="w-[72%] shrink-0 snap-start sm:w-auto">
                <LoopTile
                  id={m.exerciseId}
                  name={m.name}
                  numeral={m.reps ? `×${m.reps}` : undefined}
                  href={m.href}
                  size="lg"
                />
              </li>
            ))}
          </ul>
          <PathPhone locale={locale} class="max-lg:hidden" />
        </div>
      )
    }
  </Section>

  <TogetherClub locale={locale} />

  <Section id="together" title={t(locale, 'landing.togetherMoreTitle')}>
    <ShareInvite client:visible compact {...shareInviteProps(locale, site)} />
  </Section>

  <Section id="faq" title={t(locale, 'landing.faqTitle')}>
    <Faq items={faq} />
  </Section>
</Landing>

<script>
  import { copyText } from '@/components/landing/shareHome';
  import { acceptReferral, referralIsThisLink } from '@/components/landing/visit';
  import { cleanName, mondayLabel, validDate } from '@/lib/share/invite';

  /*
   * Everything personal on this page comes from the address bar and goes in through `textContent`
   * after a validator. The values are never parsed as HTML, never put into an attribute, and never
   * sent anywhere.
   */
  const root = document.querySelector<HTMLElement>('[data-together]');
  if (root) {
    const locale = root.dataset.locale === 'en' ? 'en' : 'ru';
    const query = new URLSearchParams(location.search);
    const now = new Date();

    const name = cleanName(query.get('from'));
    const eyebrow = document.querySelector<HTMLElement>('[data-together-eyebrow]');
    if (eyebrow && name) {
      eyebrow.textContent = (eyebrow.dataset.template ?? '{name}').split('{name}').join(name);
    }

    const label = mondayLabel(locale, validDate(query.get('d'), now), now);
    const day = label.charAt(0).toLocaleUpperCase(locale) + label.slice(1);
    document.querySelectorAll<HTMLElement>('[data-together-date]').forEach((el) => {
      el.textContent = day;
    });

    // The layout's bindVisit does the same; whichever runs first stashes, the rule is one.
    if (acceptReferral(query.get('ref')) === 'own') {
      document.querySelector<HTMLElement>('[data-own-link]')?.removeAttribute('hidden');
    }
    // The +30 line only when *this* link's code is the one waiting: a code kept from an earlier
    // friend's link (first code wins) or a plain link with no `ref` promises nothing here.
    const withRef = referralIsThisLink(query.get('ref'));
    document.querySelectorAll<HTMLElement>('[data-with-ref]').forEach((el) => {
      el.hidden = !withRef;
    });

    // Instagram's and Facebook's in-app browsers drop storage between sessions.
    if (/\b(Instagram|FBAN|FBAV)\b/.test(navigator.userAgent)) {
      document.querySelector<HTMLElement>('[data-inapp-hint]')?.removeAttribute('hidden');
    }

    // «Ответить: я в деле»: the share sheet inside the tap, else the line on the clipboard.
    document.querySelectorAll<HTMLElement>('[data-reply]').forEach((button) => {
      const text = button.dataset.replyText ?? '';
      const labelEl = button.querySelector<HTMLElement>('[data-reply-label]') ?? button;
      const idle = labelEl.textContent ?? '';
      let timer = 0;
      button.addEventListener('click', () => {
        if (typeof navigator.share === 'function') {
          navigator.share({ text }).catch(() => undefined);
          return;
        }
        void copyText(text).then((ok) => {
          labelEl.textContent =
            (ok ? button.dataset.replyDone : button.dataset.replyFailed) ?? idle;
          window.clearTimeout(timer);
          timer = window.setTimeout(() => (labelEl.textContent = idle), ok ? 2500 : 4000);
        });
      });
    });
  }
</script>
