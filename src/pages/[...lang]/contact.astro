---
/** Contact page: email / Telegram from config, no invented response times. */
import Landing from '@/layouts/Landing.astro';
import Breadcrumbs from '@/components/landing/Breadcrumbs.astro';
import { breadcrumbLd } from '@/components/landing/jsonld';
import type { Locale } from '@/content/schema';
import { t } from '@/i18n/index';
import { canonicalUrl } from '@/lib/seo/urls';
import { href, localeStaticPaths } from '@/lib/util/paths';
import { BRAND } from '@content/site/brand';
import { LINKS } from '@content/site/links';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale: Locale = Astro.params.lang === 'en' ? 'en' : 'ru';
const site = (Astro.site?.toString() ?? 'http://localhost:4321').replace(/\/$/, '');
const title = t(locale, 'landing.contactTitle');
const description = t(locale, 'landing.contactDescription');
// Widened to `string`: the config literals are '' until the owner fills them in.
const email: string = LINKS.supportEmail || BRAND.contactEmail;
const telegram: string = LINKS.supportTelegram || BRAND.telegram;

const jsonLd = breadcrumbLd([
  { name: t(locale, 'landing.breadcrumbHome'), url: canonicalUrl(site, locale, '/') },
  { name: title, url: canonicalUrl(site, locale, '/contact/') },
]);
---

<Landing
  locale={locale}
  title={title}
  description={description}
  sitePath="/contact/"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-3xl px-5 pt-8 pb-12 md:pt-12 md:pb-20">
    <Breadcrumbs
      ariaLabel={t(locale, 'landing.breadcrumbHome')}
      items={[
        { label: t(locale, 'landing.breadcrumbHome'), href: href(locale, '/') },
        { label: title },
      ]}
    />
    <h1 class="display mt-6 text-5xl md:text-6xl">{title}</h1>
    <p class="mt-5 text-lg leading-relaxed text-muted">{t(locale, 'landing.contactIntro')}</p>

    <!-- The two channels as hairline columns: a kicker, then the address in the display face. -->
    <ul class="mt-10 grid gap-x-10 sm:grid-cols-2">
      <li class="border-t border-border pt-5">
        <p class="eyebrow">
          {t(locale, 'landing.contactEmail')}
        </p>
        <a
          href={`mailto:${email}`}
          class="mt-3 block text-xl font-semibold break-all underline decoration-border-strong underline-offset-4 hover:decoration-text"
        >
          {email}
        </a>
      </li>
      {
        telegram && (
          <li class="mt-6 border-t border-border pt-5 sm:mt-0">
            <p class="eyebrow">{t(locale, 'landing.contactTelegram')}</p>
            <a
              href={telegram}
              rel="noopener"
              class="mt-3 block text-xl font-semibold break-all underline decoration-border-strong underline-offset-4 hover:decoration-text"
            >
              {telegram.replace(/^https?:\/\//, '')}
            </a>
          </li>
        )
      }
    </ul>
    <p class="mt-5 text-sm text-muted">{t(locale, 'landing.contactOrder')}</p>

    <section class="mt-12 border-t border-border pt-5">
      <h2 class="font-display text-base">{t(locale, 'landing.contactBeforeTitle')}</h2>
      <ol class="mt-4 flex flex-col divide-y divide-border leading-relaxed text-muted">
        {
          [t(locale, 'landing.contactBefore1'), t(locale, 'landing.contactBefore2')].map(
            (line, i) => (
              <li class="flex items-baseline gap-4 py-3">
                <span class="numeral text-xs text-muted-2" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                {line}
              </li>
            ),
          )
        }
        <li class="flex items-baseline gap-4 py-3">
          <span class="numeral text-xs text-muted-2" aria-hidden="true">03</span>
          <a
            href={href(locale, '/refund/')}
            class="underline decoration-border-strong underline-offset-4 hover:text-text"
          >
            {t(locale, 'landing.contactBefore3')}
          </a>
        </li>
      </ol>
    </section>
  </div>
</Landing>
