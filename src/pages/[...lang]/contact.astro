---
/**
 * Contact page: email / Telegram from config, no invented response times.
 *
 * Drawn in the owner's prototype's language (design/CHANGELOG.md §10, «Профиль»): the channels
 * are rows with the value on the right and a › at the edge — «E-mail … hello@ ›» the way the
 * prototype sets «Подписка … до 12 октября ›» — not kicker-over-address columns. The three
 * things to check before writing stay a numbered «01 / 02 / 03» column.
 */
import Landing from '@/layouts/Landing.astro';
import HeroField from '@/components/landing/HeroField.astro';
import KeyTitle from '@/components/landing/KeyTitle.astro';
import Breadcrumbs from '@/components/landing/Breadcrumbs.astro';
import { breadcrumbLd } from '@/components/landing/jsonld';
import type { Locale } from '@/content/schema';
import { t } from '@/i18n/index';
import { canonicalUrl } from '@/lib/seo/urls';
import { href, localeStaticPaths } from '@/lib/util/paths';
import { BRAND } from '@content/site/brand';
import { LINKS } from '@content/site/links';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale: Locale = Astro.params.lang === 'en' ? 'en' : 'ru';
const site = (Astro.site?.toString() ?? 'http://localhost:4321').replace(/\/$/, '');
const title = t(locale, 'landing.contactTitle');
const description = t(locale, 'landing.contactDescription');
// Widened to `string`: the config literals are '' until the owner fills them in.
const email: string = LINKS.supportEmail || BRAND.contactEmail;
const telegram: string = LINKS.supportTelegram || BRAND.telegram;

const channels = [
  { label: t(locale, 'landing.contactEmail'), value: email, href: `mailto:${email}` },
  ...(telegram
    ? [
        {
          label: t(locale, 'landing.contactTelegram'),
          value: telegram.replace(/^https?:\/\//, ''),
          href: telegram,
        },
      ]
    : []),
];

const jsonLd = breadcrumbLd([
  { name: t(locale, 'landing.breadcrumbHome'), url: canonicalUrl(site, locale, '/') },
  { name: title, url: canonicalUrl(site, locale, '/contact/') },
]);
---

<Landing
  locale={locale}
  title={title}
  description={description}
  sitePath="/contact/"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-3xl px-5 pt-8 pb-12 md:pt-12 md:pb-20">
    <Breadcrumbs
      ariaLabel={t(locale, 'landing.breadcrumbHome')}
      items={[
        { label: t(locale, 'landing.breadcrumbHome'), href: href(locale, '/') },
        { label: title },
      ]}
    />
    <HeroField class="mt-8">
      <KeyTitle text={title} class="display text-4xl md:text-6xl" />
      <p class="field-lead mt-5 max-w-xl text-[15px] leading-relaxed md:text-base">
        {t(locale, 'landing.contactIntro')}
      </p>
    </HeroField>

    <ul class="mt-8 divide-y divide-border border-t border-b border-border">
      {
        channels.map((c) => (
          <li>
            <a
              href={c.href}
              rel={c.href.startsWith('http') ? 'noopener' : undefined}
              class="group flex min-h-14 items-center justify-between gap-4 py-3"
            >
              <span class="eyebrow shrink-0">{c.label}</span>
              <span class="flex min-w-0 items-center gap-3">
                <span class="truncate text-[15px] font-semibold group-hover:underline">
                  {c.value}
                </span>
                <span class="glyph text-base text-muted-2 group-hover:text-text" aria-hidden="true">
                  ›
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-4 text-sm text-muted-2">{t(locale, 'landing.contactOrder')}</p>

    <section aria-labelledby="before-title" class="mt-14">
      <h2 id="before-title" class="display text-lg md:text-xl">
        {t(locale, 'landing.contactBeforeTitle')}
      </h2>
      <ol
        class="mt-5 flex flex-col divide-y divide-border border-t border-border text-[15px] leading-relaxed text-muted"
      >
        {
          [t(locale, 'landing.contactBefore1'), t(locale, 'landing.contactBefore2')].map(
            (line, i) => (
              <li class="flex items-baseline gap-4 py-3.5">
                <span class="numeral tabular w-6 shrink-0 text-sm text-text" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                {line}
              </li>
            ),
          )
        }
        <li class="flex items-baseline gap-4 py-3.5">
          <span class="numeral tabular w-6 shrink-0 text-sm text-text" aria-hidden="true">03</span>
          <a
            href={href(locale, '/refund/')}
            class="underline decoration-border-strong underline-offset-4 hover:text-text"
          >
            {t(locale, 'landing.contactBefore3')}
          </a>
        </li>
      </ol>
    </section>
  </div>
</Landing>
