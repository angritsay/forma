---
/**
 * Guides hub: /guides/ and /en/guides/. Cluster sections with cards; JSON-LD CollectionPage
 * (ItemList) + BreadcrumbList. Cluster headings link to the cluster hub pages.
 */
import { getCollection } from 'astro:content';
import Landing from '@/layouts/Landing.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import GuideCard from '@/components/seo/GuideCard.astro';
import type { Locale } from '@/content/schema';
import { plural, t } from '@/i18n/index';
import { clusterPath, guidePath, guidesByCluster, guidesForLocale } from '@/lib/seo/guides';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/lib/seo/jsonld';
import { ogImagePath } from '@/lib/seo/meta';
import { canonicalUrl, siteOrigin } from '@/lib/seo/urls';
import { href, localeStaticPaths } from '@/lib/util/paths';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale: Locale = Astro.params.lang === 'en' ? 'en' : 'ru';
const site = siteOrigin(Astro.site);
const sitePath = '/guides/';
const url = canonicalUrl(site, locale, sitePath);
const title = t(locale, 'seo.guidesHubTitle');
const description = t(locale, 'seo.guidesHubDescription');

const all = await getCollection('guides');
const list = guidesForLocale(all, locale);
const groups = guidesByCluster(list);

const crumbs = [
  { name: t(locale, 'seo.home'), url: canonicalUrl(site, locale, '/'), href: href(locale, '/') },
  { name: t(locale, 'seo.guides'), url, href: href(locale, sitePath) },
];
const jsonLd = [
  collectionPageJsonLd({
    site,
    locale,
    name: t(locale, 'seo.guidesHubH1'),
    description,
    url,
    items: list.map((g) => ({
      name: g.data.title,
      url: canonicalUrl(site, locale, guidePath(g)),
      description: g.data.description,
    })),
  }),
  breadcrumbJsonLd(crumbs),
];
const countLabel = (n: number) =>
  `${n} ${plural(locale, n, {
    one: t(locale, 'seo.guideWordOne'),
    few: t(locale, 'seo.guideWordFew'),
    many: t(locale, 'seo.guideWordMany'),
  })}`;
---

<Landing
  locale={locale}
  title={title}
  description={description}
  sitePath={sitePath}
  image={ogImagePath('hub', 'guides', locale)}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-5 pb-16 pt-8 md:pt-12">
    <Breadcrumbs locale={locale} items={crumbs} />
    <header class="mt-6 max-w-3xl">
      <h1 class="display text-4xl md:text-6xl">{t(locale, 'seo.guidesHubH1')}</h1>
      <p class="mt-5 text-lg leading-relaxed text-muted">{t(locale, 'seo.guidesHubIntro')}</p>
      {
        list.length > 0 && (
          <p class="tabular mt-3 text-sm text-muted-2">{countLabel(list.length)}</p>
        )
      }
    </header>

    {
      groups.length === 0 ? (
        <p class="mt-10 border-t border-border pt-5 text-muted">
          {t(locale, 'seo.guidesHubEmpty')}
        </p>
      ) : (
        <Fragment>
          {/* Cluster anchors as chips; the count is a plain tabular figure, not a box. */}
          <nav aria-label={t(locale, 'seo.guidesAll')} class="mt-8">
            <ul class="flex flex-wrap gap-2">
              {groups.map((g) => (
                <li>
                  <a
                    href={`#cluster-${g.cluster}`}
                    class="tap-target-y inline-flex h-8.5 items-center gap-2 border border-border bg-surface-3 px-3 text-[12px] font-semibold tracking-[0.06em] text-muted uppercase transition-colors duration-150 hover:border-border-strong hover:text-text"
                  >
                    {t(locale, `seo.cluster_${g.cluster}_title` as const)}
                    <span class="tabular text-muted-2">{g.items.length}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          {groups.map((g, i) => (
            <section
              id={`cluster-${g.cluster}`}
              class="mt-14 scroll-mt-24"
              aria-labelledby={`cluster-${g.cluster}-title`}
            >
              <div class="flex flex-wrap items-end justify-between gap-3">
                <div class="max-w-2xl">
                  <h2
                    id={`cluster-${g.cluster}-title`}
                    class="font-display flex items-baseline gap-4 text-xl md:text-2xl"
                  >
                    <span class="numeral text-sm text-muted" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <a class="hover:underline" href={href(locale, clusterPath(g.cluster))}>
                      {t(locale, `seo.cluster_${g.cluster}_title` as const)}
                    </a>
                  </h2>
                  <p class="mt-3 text-sm leading-relaxed text-muted">
                    {t(locale, `seo.cluster_${g.cluster}_description` as const)}
                  </p>
                </div>
                <a
                  class="control-label tabular inline-flex min-h-11 items-center gap-2 text-[12px] text-muted hover:text-text"
                  href={href(locale, clusterPath(g.cluster))}
                >
                  {countLabel(g.items.length)}
                  <span class="glyph" aria-hidden="true">
                    →
                  </span>
                </a>
              </div>
              <ul class="mt-6 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-3">
                {g.items.map((guide) => (
                  <li>
                    <GuideCard guide={guide} locale={locale} showCluster={false} />
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </Fragment>
      )
    }
  </div>
</Landing>
