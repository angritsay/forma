---
/**
 * Guides hub: /guides/ and /en/guides/. Cluster sections with rows; JSON-LD CollectionPage
 * (ItemList) + BreadcrumbList. Cluster headings link to the cluster hub pages.
 *
 * The frame is the owner's prototype's (design/CHANGELOG.md §10): the count of guides as the one
 * display-size figure, the intro kept to a single muted measure (it is the hub's prose for
 * search), the clusters as a row of chips, and each cluster as a numbered heading over rows of
 * title + reading time. The paragraph under every cluster heading went — it is the cluster
 * page's own intro and is read there — and the row's count moved into the heading itself, where
 * the exercises hub already keeps it.
 */
import { getCollection } from 'astro:content';
import Landing from '@/layouts/Landing.astro';
import HeroField from '@/components/landing/HeroField.astro';
import KeyTitle from '@/components/landing/KeyTitle.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import GuideCard from '@/components/seo/GuideCard.astro';
import type { Locale } from '@/content/schema';
import { plural, t } from '@/i18n/index';
import { clusterPath, guidePath, guidesByCluster, guidesForLocale } from '@/lib/seo/guides';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/lib/seo/jsonld';
import { ogImagePath } from '@/lib/seo/meta';
import { canonicalUrl, siteOrigin } from '@/lib/seo/urls';
import { href, localeStaticPaths } from '@/lib/util/paths';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale: Locale = Astro.params.lang === 'en' ? 'en' : 'ru';
const site = siteOrigin(Astro.site);
const sitePath = '/guides/';
const url = canonicalUrl(site, locale, sitePath);
const title = t(locale, 'seo.guidesHubTitle');
const description = t(locale, 'seo.guidesHubDescription');

const all = await getCollection('guides');
const list = guidesForLocale(all, locale);
const groups = guidesByCluster(list);

const crumbs = [
  { name: t(locale, 'seo.home'), url: canonicalUrl(site, locale, '/'), href: href(locale, '/') },
  { name: t(locale, 'seo.guides'), url, href: href(locale, sitePath) },
];
const jsonLd = [
  collectionPageJsonLd({
    site,
    locale,
    name: t(locale, 'seo.guidesHubH1'),
    description,
    url,
    items: list.map((g) => ({
      name: g.data.title,
      url: canonicalUrl(site, locale, guidePath(g)),
      description: g.data.description,
    })),
  }),
  breadcrumbJsonLd(crumbs),
];
const countWord = plural(locale, list.length, {
  one: t(locale, 'seo.guideWordOne'),
  few: t(locale, 'seo.guideWordFew'),
  many: t(locale, 'seo.guideWordMany'),
});
---

<Landing
  locale={locale}
  title={title}
  description={description}
  sitePath={sitePath}
  image={ogImagePath('hub', 'guides', locale)}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-5 pb-16 pt-8 md:pt-12">
    <Breadcrumbs locale={locale} items={crumbs} />
    <HeroField as="header" class="mt-8 md:flex md:items-end md:justify-between md:gap-10">
      <div class="max-w-2xl md:order-1">
        <KeyTitle text={t(locale, 'seo.guidesHubH1')} class="display text-3xl md:text-5xl" />
        <p class="field-lead mt-4 max-w-xl text-[15px] leading-relaxed">
          {t(locale, 'seo.guidesHubIntro')}
        </p>
      </div>
      {
        list.length > 0 && (
          <p class="mt-8 flex items-baseline gap-3 md:order-2 md:mt-0 md:shrink-0 md:flex-col md:items-end md:gap-1">
            <span class="display tabular text-7xl leading-none md:text-8xl">{list.length}</span>
            <span class="eyebrow">{countWord}</span>
          </p>
        )
      }
    </HeroField>

    {
      groups.length === 0 ? (
        <p class="mt-10 border-t border-border pt-5 text-muted">
          {t(locale, 'seo.guidesHubEmpty')}
        </p>
      ) : (
        <Fragment>
          {/* Cluster anchors as chips — pressed, so 12px, not pills. */}
          <nav aria-label={t(locale, 'seo.guidesAll')} class="mt-10">
            <ul class="flex flex-wrap gap-2">
              {groups.map((g) => (
                <li>
                  <a
                    href={`#cluster-${g.cluster}`}
                    class="tap-target-y control-label inline-flex h-9 items-center gap-2 rounded-control border border-border px-3 text-[11px] text-muted transition-colors duration-150 hover:border-border-strong hover:text-text"
                  >
                    {t(locale, `seo.cluster_${g.cluster}_title` as const)}
                    <span class="tabular text-muted-2">{g.items.length}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          {groups.map((g, i) => (
            <section
              id={`cluster-${g.cluster}`}
              class="mt-14 scroll-mt-24"
              aria-labelledby={`cluster-${g.cluster}-title`}
            >
              {/* The heading is the link to the cluster page; the → beside the count says so. */}
              <h2
                id={`cluster-${g.cluster}-title`}
                class="display flex items-baseline gap-4 text-xl md:text-2xl"
              >
                <span class="numeral tabular shrink-0 text-sm text-muted" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <a
                  class="group flex min-w-0 flex-1 items-baseline gap-4 hover:underline"
                  href={href(locale, clusterPath(g.cluster))}
                >
                  <span>{t(locale, `seo.cluster_${g.cluster}_title` as const)}</span>
                  <span
                    class="numeral tabular ml-auto flex shrink-0 items-baseline gap-2 text-sm text-muted-2 group-hover:text-text"
                    aria-hidden="true"
                  >
                    {g.items.length}
                    <span class="glyph">→</span>
                  </span>
                </a>
              </h2>
              <ul class="mt-5 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-3">
                {g.items.map((guide) => (
                  <li>
                    <GuideCard guide={guide} locale={locale} showCluster={false} />
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </Fragment>
      )
    }
  </div>
</Landing>
