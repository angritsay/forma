---
/**
 * Guides hub: /guides/ and /en/guides/. Cluster sections with cards; JSON-LD CollectionPage
 * (ItemList) + BreadcrumbList. Cluster headings link to the cluster hub pages.
 */
import { getCollection } from 'astro:content';
import Landing from '@/layouts/Landing.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import GuideCard from '@/components/seo/GuideCard.astro';
import type { Locale } from '@/content/schema';
import { plural, t } from '@/i18n/index';
import { clusterPath, guidePath, guidesByCluster, guidesForLocale } from '@/lib/seo/guides';
import { breadcrumbJsonLd, collectionPageJsonLd } from '@/lib/seo/jsonld';
import { ogImagePath } from '@/lib/seo/meta';
import { canonicalUrl, siteOrigin } from '@/lib/seo/urls';
import { href } from '@/lib/util/paths';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'en' } }];
}

const locale: Locale = Astro.params.lang === 'en' ? 'en' : 'ru';
const site = siteOrigin(Astro.site);
const sitePath = '/guides/';
const url = canonicalUrl(site, locale, sitePath);
const title = t(locale, 'seo.guidesHubTitle');
const description = t(locale, 'seo.guidesHubDescription');

const all = await getCollection('guides');
const list = guidesForLocale(all, locale);
const groups = guidesByCluster(list);

const crumbs = [
  { name: t(locale, 'seo.home'), url: canonicalUrl(site, locale, '/'), href: href(locale, '/') },
  { name: t(locale, 'seo.guides'), url, href: href(locale, sitePath) },
];
const jsonLd = [
  collectionPageJsonLd({
    site,
    locale,
    name: t(locale, 'seo.guidesHubH1'),
    description,
    url,
    items: list.map((g) => ({
      name: g.data.title,
      url: canonicalUrl(site, locale, guidePath(g)),
      description: g.data.description,
    })),
  }),
  breadcrumbJsonLd(crumbs),
];
const countLabel = (n: number) =>
  `${n} ${plural(locale, n, {
    one: t(locale, 'seo.guideWordOne'),
    few: t(locale, 'seo.guideWordFew'),
    many: t(locale, 'seo.guideWordMany'),
  })}`;
---

<Landing
  locale={locale}
  title={title}
  description={description}
  sitePath={sitePath}
  image={ogImagePath('hub', 'guides', locale)}
  jsonLd={jsonLd}
>
  <main class="mx-auto max-w-6xl px-5 pb-16 pt-8 md:pt-12">
    <Breadcrumbs locale={locale} items={crumbs} />
    <header class="mt-6 max-w-3xl">
      <h1 class="font-display text-4xl md:text-6xl">{t(locale, 'seo.guidesHubH1')}</h1>
      <p class="mt-5 text-lg leading-relaxed text-muted">{t(locale, 'seo.guidesHubIntro')}</p>
      {list.length > 0 && <p class="mt-3 text-sm text-muted-2">{countLabel(list.length)}</p>}
    </header>

    {
      groups.length === 0 ? (
        <p class="mt-10 rounded-card border border-border bg-surface p-6 text-muted">
          {t(locale, 'seo.guidesHubEmpty')}
        </p>
      ) : (
        <Fragment>
          <nav aria-label={t(locale, 'seo.guidesAll')} class="mt-8">
            <ul class="flex flex-wrap gap-2">
              {groups.map((g) => (
                <li>
                  <a
                    href={`#cluster-${g.cluster}`}
                    class="inline-flex items-center gap-1.5 rounded-pill border border-border px-3 py-1.5 text-sm text-muted hover:text-text"
                  >
                    {t(locale, `seo.cluster_${g.cluster}_title` as const)}
                    <span class="text-muted-2">{g.items.length}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          {groups.map((g) => (
            <section
              id={`cluster-${g.cluster}`}
              class="mt-12 scroll-mt-24"
              aria-labelledby={`cluster-${g.cluster}-title`}
            >
              <div class="flex flex-wrap items-end justify-between gap-3">
                <div class="max-w-2xl">
                  <h2 id={`cluster-${g.cluster}-title`} class="font-display text-2xl md:text-3xl">
                    <a class="hover:text-accent" href={href(locale, clusterPath(g.cluster))}>
                      {t(locale, `seo.cluster_${g.cluster}_title` as const)}
                    </a>
                  </h2>
                  <p class="mt-2 text-sm leading-relaxed text-muted">
                    {t(locale, `seo.cluster_${g.cluster}_description` as const)}
                  </p>
                </div>
                <a
                  class="text-sm text-muted hover:text-text"
                  href={href(locale, clusterPath(g.cluster))}
                >
                  {countLabel(g.items.length)} →
                </a>
              </div>
              <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {g.items.map((guide) => (
                  <li>
                    <GuideCard guide={guide} locale={locale} showCluster={false} />
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </Fragment>
      )
    }
  </main>
</Landing>
