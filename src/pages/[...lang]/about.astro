---
/**
 * The coach page, «Тренер» (site synthesis §5, PR 4). The path stays /about/ — it ranks, and a
 * static host cannot redirect — but the nav calls it «Тренер», and it sells his time: half an hour
 * or an hour online. The homepage's coach block links straight to `#sessions`.
 *
 * Visual-first, like the homepage: a kicker, a headline of at most six words, at most two short
 * lines, one picture and one action per section; lists are glyph tiles, figures are set large, and
 * his bio folds away under «Подробнее».
 *
 *   hero        his photograph (`COACH.cardPhoto`, the 720×900 crop of the hero photograph) beside
 *               the page's one blue field, as his card in the app is blue (§21/§23): the bleu-ciel
 *               «Тренер» tag, `KeyTitle` «Сергей Титов» with the surname the key word, «Основатель
 *               и тренер Forma» (`COACH.formaRole`), his two figures (`COACH.figures`: «10 000+
 *               персональных часов», «10+ лет…») and a white «Записаться на занятие» to `#sessions`
 *   outcomes    `BOOKING.outcomes` titles verbatim, in his voice, as three glyph tiles (the
 *               bodies stay in the app's booking screen; here a title is the whole tile)
 *   sessions    `#sessions`: the offer's pills (online; bookable up to `BOOKING.leadTimeMin` minutes
 *               ahead — the app's own `app.bookLeadTimePill`), `SessionTickets`, how each length is
 *               booked (both the same since 0055: pick a time in the app, then pay — the slot is
 *               held 20 minutes), the money rule (no refund; the client moves a session in the app
 *               at least 24 hours ahead — the owner's decision) and the
 *               page's one neon, «Записаться к тренеру» → `#/book`
 *   daily       his own footage (`AUTH_FILM.poster`, the sign-in film's first frame — not the hero's
 *               photograph again) beside what he does in Forma every day as four glyph tiles, and
 *               his filmed movements (drawn only when the build can point at their stills)
 *   principles  three numbered cards; #1 and #3 say what the product does now (a start from five
 *               questions and a check after workout 2; a skipped workout breaks nothing, the streak
 *               is the club's)
 *   record      the credentials (the checkable list the figures are a poster of), his profiles
 *               (profi.ru, Instagram, Telegram — `COACH.links`), the bio folded
 *   science     one line and the guides
 *
 * The figures restate credentials from content/site/coach.ts and are read from `COACH.figures`,
 * never typed here: the list is the record and the figures are its poster. Every price is read
 * from `content/site/booking.ts` by `SessionTickets`. JSON-LD: Person, BreadcrumbList.
 */
import Landing from '@/layouts/Landing.astro';
import Breadcrumbs from '@/components/landing/Breadcrumbs.astro';
import Button from '@/components/landing/Button.astro';
import Cta from '@/components/landing/Cta.astro';
import HeroField from '@/components/landing/HeroField.astro';
import IconTiles from '@/components/landing/IconTiles.astro';
import KeyTitle from '@/components/landing/KeyTitle.astro';
import Pill from '@/components/landing/Pill.astro';
import Section from '@/components/landing/Section.astro';
import SessionTickets from '@/components/landing/SessionTickets.astro';
import LoopTile from '@/components/landing/media/LoopTile.astro';
import { exerciseHref } from '@/components/landing/courseHelpers';
import { DEMO_COURSE_ID } from '@/components/landing/demo';
import { filmedFacts, wallMoves } from '@/components/landing/filmed';
import { breadcrumbLd, personLd } from '@/components/landing/jsonld';
import { Doodle } from '@/components/ui/Doodle';
import { COURSE_BY_ID, EXERCISE_BY_ID } from '@/content/registry';
import { SITE_COURSES } from '@/content/published';
import type { Locale } from '@/content/schema';
import { l, t } from '@/i18n/index';
import { exerciseStillUrl } from '@/lib/api/storage';
import { HOLD_MINUTES } from '@/lib/coach/slots';
import { canonicalUrl } from '@/lib/seo/urls';
import { appHref, href, localeStaticPaths, withBase } from '@/lib/util/paths';
import { BOOKING } from '@content/site/booking';
import { COACH } from '@content/site/coach';
import { AUTH_FILM } from '@content/site/media';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale: Locale = Astro.params.lang === 'en' ? 'en' : 'ru';
const site = (Astro.site?.toString() ?? 'http://localhost:4321').replace(/\/$/, '');
const title = t(locale, 'landing.aboutTitle');
const description = t(locale, 'landing.aboutDescription');

const name = l(COACH.name, locale);
const bio = l(COACH.bio, locale);
const photo = COACH.cardPhoto || COACH.photo;
const figures = COACH.figures.map((f) => ({ value: f.value, label: l(f.label, locale) }));

/*
 * How each length is booked. Both the same way since the app has its own calendar (0055): pick a
 * time in the app, then pay — the slot is held for 20 minutes and the payment confirms it.
 */
const howTo = BOOKING.options.map((o) => ({
  id: o.id,
  minutes: t(locale, 'landing.ticketsMinutes', { n: o.durationMin }),
  text: t(locale, 'landing.aboutHowPick'),
}));

const daily = [
  { kind: 'camera', label: t(locale, 'landing.aboutDailyFilmed') },
  { kind: 'eye', label: t(locale, 'landing.aboutDailyReports') },
  { kind: 'talk', label: t(locale, 'landing.aboutDailyBot') },
  { kind: 'trophy', label: t(locale, 'landing.aboutDailyWinner') },
] as const;

/* Four of his filmed movements under the tiles — only when the build can show their stills. */
const demoCourse = COURSE_BY_ID.get(DEMO_COURSE_ID) ?? SITE_COURSES[0];
const filmed = demoCourse ? filmedFacts(demoCourse) : null;
const moves = filmed
  ? wallMoves(filmed, [], 4).flatMap((id) => {
      const ex = EXERCISE_BY_ID.get(id);
      return ex ? [{ id, name: l(ex.name, locale), href: exerciseHref(locale, ex) }] : [];
    })
  : [];
const hasStills = moves.length > 0 && exerciseStillUrl(moves[0]?.id ?? '') !== undefined;

/* The daily block's picture: his own footage, a different frame from the hero's portrait. */
const dailyPhoto = AUTH_FILM.poster || COACH.photo;

const principles = [1, 2, 3].map((n) => ({
  title: t(locale, `landing.aboutPhilosophy${n}Title` as 'landing.aboutPhilosophy1Title'),
  text: t(locale, `landing.aboutPhilosophy${n}Text` as 'landing.aboutPhilosophy1Text'),
}));

/*
 * Instagram and Telegram share one handle, so a chip that said only «@titovtrener» twice would not
 * say which is which: the service goes in front. profi.ru is its own name.
 */
const LINK_SERVICE = { profi: 'profi.ru', instagram: 'Instagram', telegram: 'Telegram' } as const;

const quietLink =
  'control-label inline-flex min-h-11 items-center gap-2 text-[14px] text-text underline decoration-border-strong underline-offset-4 hover:decoration-text';

const jsonLd = [
  personLd(site, locale),
  breadcrumbLd([
    { name: t(locale, 'landing.breadcrumbHome'), url: canonicalUrl(site, locale, '/') },
    { name: t(locale, 'landing.navCoach'), url: canonicalUrl(site, locale, '/about/') },
  ]),
];
---

<Landing locale={locale} title={title} description={description} sitePath="/about/" jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-5 pt-8 md:pt-12">
    <Breadcrumbs
      ariaLabel={t(locale, 'landing.breadcrumbHome')}
      items={[
        { label: t(locale, 'landing.breadcrumbHome'), href: href(locale, '/') },
        { label: t(locale, 'landing.navCoach') },
      ]}
    />

    <div class="mt-6 grid items-stretch gap-4 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:gap-6">
      <figure
        class="relative m-0 aspect-[4/3] overflow-hidden rounded-card border border-border bg-surface md:order-2 md:aspect-auto md:min-h-[32rem]"
      >
        <img
          src={withBase(photo)}
          alt={name}
          width="720"
          height="900"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="photo-mono absolute inset-0 size-full object-cover object-[50%_22%]"
        />
        <div class="photo-grain" aria-hidden="true"></div>
      </figure>

      <HeroField as="header" class="flex flex-col justify-between gap-8 md:order-1">
        <div>
          <Pill tone="ciel" size="sm" tilt="right">{t(locale, 'landing.coachEyebrow')}</Pill>
          <KeyTitle text={name} class="display mt-4 text-[clamp(2.25rem,9vw,4rem)] leading-[1.1]" />
          <p class="field-lead mt-4 text-base leading-snug md:text-lg">
            {l(COACH.formaRole, locale)}
          </p>
        </div>
        <dl
          class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-8 gap-y-4 sm:grid-cols-2"
          aria-label={t(locale, 'landing.coachFiguresLabel')}
        >
          {
            figures.map((f) => (
              <div class="flex flex-col-reverse justify-end gap-1.5">
                <dt class="text-[13px] leading-tight text-on-field">{f.label}</dt>
                <dd class="numeral m-0 text-[2rem] leading-none whitespace-nowrap sm:text-5xl text-on-field md:text-6xl">
                  {f.value}
                </dd>
              </div>
            ))
          }
        </dl>
        {
          BOOKING.enabled && (
            <div>
              <Button href="#sessions" variant="plain" size="lg" class="w-full sm:w-auto">
                {t(locale, 'landing.coachBook')}
                <span class="glyph" aria-hidden="true">
                  ↓
                </span>
              </Button>
            </div>
          )
        }
      </HeroField>
    </div>
  </div>

  {
    BOOKING.enabled && (
      <Section id="outcomes" title={t(locale, 'landing.aboutOutcomesTitle')}>
        <ul class="grid gap-3 md:grid-cols-3 md:gap-4">
          {BOOKING.outcomes.map((o) => (
            <li class="glass-card flex flex-col gap-4 rounded-card border border-border p-5 md:p-6">
              <span class="text-accent" aria-hidden="true">
                <Doodle kind={o.doodle} className="size-10 md:size-12" />
              </span>
              <h3 class="font-display text-lg leading-snug md:text-xl">{l(o.title, locale)}</h3>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  {
    BOOKING.enabled && (
      <Section id="sessions" title={t(locale, 'landing.aboutSessionsTitle')} class="scroll-mt-16">
        <ul class="mb-5 flex flex-wrap gap-2">
          <li class="flex max-w-full">
            <Pill tone="ciel" size="md" tilt="left">
              {l(BOOKING.format, locale)}
            </Pill>
          </li>
          <li class="flex max-w-full">
            <Pill size="md">{t(locale, 'app.bookLeadTimePill', { n: BOOKING.leadTimeMin })}</Pill>
          </li>
        </ul>
        <SessionTickets locale={locale} />
        <h3 class="eyebrow mt-8">{t(locale, 'landing.aboutHowTitle')}</h3>
        <ol class="mt-3 grid gap-3 sm:grid-cols-2">
          {howTo.map((h) => (
            <li class="flex items-baseline gap-4 border-t border-border pt-3">
              <span class="numeral tabular shrink-0 text-[13px] text-muted">{h.minutes}</span>
              <span class="font-display text-[15px] leading-snug">{h.text}</span>
            </li>
          ))}
        </ol>
        <p class="mt-6 border-l-2 border-ciel pl-3 text-[14px] leading-snug text-text">
          {t(locale, 'landing.aboutRule', { n: HOLD_MINUTES })}
        </p>
        <div class="mt-8">
          <Button
            href={appHref('/book', { locale })}
            variant="primary"
            size="lg"
            class="w-full sm:w-auto"
            data-app-link
            data-goal="book_open"
          >
            {t(locale, 'landing.ladderCoachCta')}
          </Button>
        </div>
      </Section>
    )
  }

  <Section id="daily" title={t(locale, 'landing.aboutDailyTitle')}>
    <div class="grid items-stretch gap-4 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-6">
      <figure
        class="relative m-0 aspect-[4/3] overflow-hidden rounded-card border border-border bg-surface md:aspect-auto md:min-h-[22rem]"
      >
        <img
          src={withBase(dailyPhoto)}
          alt=""
          width="720"
          height="1280"
          loading="lazy"
          decoding="async"
          class="photo-mono absolute inset-0 size-full object-cover object-[50%_40%]"
        />
        <div class="photo-grain" aria-hidden="true"></div>
      </figure>
      <IconTiles items={daily} cols={2} class="content-center" />
    </div>
    {
      hasStills && (
        <>
          <ul class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
            {moves.map((m) => (
              <li>
                <LoopTile id={m.id} name={m.name} href={m.href} ratio="square" />
              </li>
            ))}
          </ul>
          <div class="mt-6">
            <a href={href(locale, '/exercises/')} class={quietLink}>
              {t(locale, 'landing.filmedMore')}
              <span class="glyph" aria-hidden="true">
                →
              </span>
            </a>
          </div>
        </>
      )
    }
  </Section>

  <Section id="principles" title={t(locale, 'landing.aboutPhilosophyTitle')}>
    <ol class="grid gap-3 md:grid-cols-3 md:gap-4">
      {
        principles.map((p, i) => (
          <li class="glass-card flex flex-col gap-3 rounded-card border border-border p-5 md:p-6">
            <span class="numeral text-5xl leading-none text-accent" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="font-display mt-3 text-lg leading-snug">{p.title}</h3>
            <p class="text-[14px] leading-snug text-muted">{p.text}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="record" title={t(locale, 'landing.coachCredentials')}>
    <div class="grid gap-10 md:grid-cols-12 md:gap-8">
      {
        COACH.credentials.length > 0 && (
          <ol class="flex flex-col divide-y divide-border border-y border-border md:col-span-7">
            {COACH.credentials.map((c, i) => (
              <li class="flex items-baseline gap-4 py-3.5">
                <span class="numeral tabular w-6 shrink-0 text-lg text-accent" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="min-w-0 text-[15px] leading-snug">{l(c, locale)}</span>
              </li>
            ))}
          </ol>
        )
      }
      <div class="flex flex-col gap-6 md:col-span-5">
        {
          COACH.links.length > 0 && (
            <ul class="flex flex-wrap gap-2">
              {COACH.links.map((x) => (
                <li>
                  <a
                    href={x.url}
                    rel="me noopener"
                    class="control-label inline-flex h-12 items-center rounded-control border border-border-strong px-5 text-[14px] text-text transition-colors duration-150 hover:bg-surface-2"
                  >
                    {x.kind !== 'profi' && (
                      <span class="mr-1.5 text-muted">{LINK_SERVICE[x.kind]}</span>
                    )}
                    {x.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        {
          bio && (
            <details class="group border-t border-border pt-4">
              <summary class="control-label flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 text-[15px] text-text [&::-webkit-details-marker]:hidden">
                {t(locale, 'landing.aboutBioMore')}
                <span
                  class="glyph text-muted transition-transform duration-150 group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <p class="mt-3 text-[14px] leading-relaxed text-muted">{bio}</p>
            </details>
          )
        }
      </div>
    </div>
  </Section>

  <Section
    id="science"
    title={t(locale, 'landing.aboutScienceTitle')}
    intro={t(locale, 'landing.aboutScienceText')}
  >
    <Button href={href(locale, '/guides/')} variant="secondary">
      {t(locale, 'landing.aboutScienceLink')}
      <span class="glyph" aria-hidden="true">→</span>
    </Button>
  </Section>

  <Cta
    title={t(locale, 'landing.ctaTitle')}
    text={t(locale, 'landing.ctaText')}
    primary={{ label: t(locale, 'landing.startCta'), href: appHref('/start', { locale }) }}
    primaryData={{ 'data-goal': 'app_start', 'data-app-link': true }}
  />
</Landing>
