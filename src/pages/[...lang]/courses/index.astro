---
/**
 * Courses hub: «Курс для старта» (site synthesis §5, `/courses/`). One course is on sale, so the
 * page is one offer, not a catalogue: the filters it used to open with sorted a list of one.
 *
 *   hero    the blue field, the H1 and one line of facts — twenty workouts, no jumps,
 *           no kit, the first one free
 *   ticket  the course lying sideways (`CourseCard wide`), with the neon «Тренировка 1 —
 *           бесплатно» into the app's `#/start`, the white «Купить — 2 990 ₽» to the course page's
 *           order form and the warm «Неделя клуба в подарок» pill; a grid again if a second
 *           course is ever published
 *   club    `club/ClubBand`: the club beside the course, in its own palette (666 ₽ never without
 *           7 990 ₽; EN the year only)
 *   close   the `Cta` band, «Начать бесплатно» into workout 1
 *
 * Neon: the ticket's start button and the closing band's, far apart. Every price comes from the
 * content files through the blocks that print them. JSON-LD: ItemList + BreadcrumbList.
 */
import Landing from '@/layouts/Landing.astro';
import HeroField from '@/components/landing/HeroField.astro';
import KeyTitle from '@/components/landing/KeyTitle.astro';
import Breadcrumbs from '@/components/landing/Breadcrumbs.astro';
import CourseCard from '@/components/landing/CourseCard.astro';
import Cta from '@/components/landing/Cta.astro';
import ClubBand from '@/components/landing/club/ClubBand.astro';
import { coursePath } from '@/components/landing/courseHelpers';
import { breadcrumbLd, itemListLd } from '@/components/landing/jsonld';
import { SITE_COURSES } from '@/content/published';
import type { Locale } from '@/content/schema';
import { l, t } from '@/i18n/index';
import { canonicalUrl } from '@/lib/seo/urls';
import { appHref, href, localeStaticPaths } from '@/lib/util/paths';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale: Locale = Astro.params.lang === 'en' ? 'en' : 'ru';
const site = (Astro.site?.toString() ?? 'http://localhost:4321').replace(/\/$/, '');

const title = t(locale, 'landing.coursesHubTitle');
const description = t(locale, 'landing.coursesHubDescription');
const startHref = appHref('/start', { locale });
const single = SITE_COURSES.length === 1;

const jsonLd = [
  breadcrumbLd([
    { name: t(locale, 'landing.breadcrumbHome'), url: canonicalUrl(site, locale, '/') },
    { name: t(locale, 'landing.breadcrumbCourses'), url: canonicalUrl(site, locale, '/courses/') },
  ]),
  itemListLd(
    SITE_COURSES.map((c) => ({
      name: l(c.name, locale),
      url: canonicalUrl(site, locale, coursePath(locale, c)),
    })),
    t(locale, 'landing.coursesHubH1'),
  ),
];
---

<Landing
  locale={locale}
  title={title}
  description={description}
  sitePath="/courses/"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-5 pt-8 md:pt-12">
    <Breadcrumbs
      ariaLabel={t(locale, 'landing.breadcrumbHome')}
      items={[
        { label: t(locale, 'landing.breadcrumbHome'), href: href(locale, '/') },
        { label: t(locale, 'landing.breadcrumbCourses') },
      ]}
    />
    <HeroField class="mt-6">
      <KeyTitle text={t(locale, 'landing.coursesHubH1')} class="display text-5xl md:text-6xl" />
      <p class="field-lead mt-5 max-w-xl text-base leading-relaxed md:text-lg">
        {t(locale, 'landing.coursesHubIntro')}
      </p>
    </HeroField>

    <!--
      The ticket. One course on sale lies sideways across the page with both of its buttons; the
      grid never asks for more columns than it has tickets (see the home page's course section).
    -->
    <ul
      id="courses"
      class:list={[
        'mt-8 grid scroll-mt-24 gap-5 md:mt-10',
        SITE_COURSES.length >= 2 && 'sm:grid-cols-2',
        SITE_COURSES.length >= 3 && 'lg:grid-cols-3',
      ]}
      aria-label={t(locale, 'landing.coursesHubListLabel')}
    >
      {
        SITE_COURSES.map((c) => (
          <li>
            <CourseCard
              course={c}
              locale={locale}
              headingLevel="h2"
              wide={single}
              startHref={c.id === 'start' ? startHref : undefined}
            />
          </li>
        ))
      }
    </ul>
  </div>

  <div class="mx-auto max-w-6xl px-5 pt-12 md:pt-16">
    <ClubBand locale={locale} />
  </div>

  <Cta
    title={t(locale, 'landing.ctaTitle')}
    text={t(locale, 'landing.ctaText')}
    primary={{ label: t(locale, 'landing.startCta'), href: startHref }}
    primaryData={{ 'data-goal': 'app_start', 'data-app-link': true }}
  />
</Landing>
