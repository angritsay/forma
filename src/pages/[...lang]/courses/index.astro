---
/**
 * Courses hub: intro, client-side filters by equipment/level (progressive enhancement over
 * plain links), course cards. JSON-LD: ItemList + BreadcrumbList.
 */
import Landing from '@/layouts/Landing.astro';
import Breadcrumbs from '@/components/landing/Breadcrumbs.astro';
import CourseCard from '@/components/landing/CourseCard.astro';
import Cta from '@/components/landing/Cta.astro';
import SubscribeBanner from '@/components/landing/SubscribeBanner.astro';
import {
  coursePath,
  equipmentAcrossCourses,
  equipmentLabel,
  levelLabel,
  levelsAcrossCourses,
} from '@/components/landing/courseHelpers';
import { breadcrumbLd, itemListLd } from '@/components/landing/jsonld';
import { SITE_COURSES } from '@/content/published';
import { EQUIPMENT, type Locale } from '@/content/schema';
import { l, t } from '@/i18n/index';
import { canonicalUrl } from '@/lib/seo/urls';
import { appHref, href, localeStaticPaths } from '@/lib/util/paths';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale: Locale = Astro.params.lang === 'en' ? 'en' : 'ru';
const site = (Astro.site?.toString() ?? 'http://localhost:4321').replace(/\/$/, '');

const title = t(locale, 'landing.coursesHubTitle');
const description = t(locale, 'landing.coursesHubDescription');

const equipmentOptions = equipmentAcrossCourses(SITE_COURSES, EQUIPMENT);
const levelOptions = levelsAcrossCourses(SITE_COURSES);
const self = href(locale, '/courses/');

const jsonLd = [
  breadcrumbLd([
    { name: t(locale, 'landing.breadcrumbHome'), url: canonicalUrl(site, locale, '/') },
    { name: t(locale, 'landing.breadcrumbCourses'), url: canonicalUrl(site, locale, '/courses/') },
  ]),
  itemListLd(
    SITE_COURSES.map((c) => ({
      name: l(c.name, locale),
      url: canonicalUrl(site, locale, coursePath(locale, c)),
    })),
    t(locale, 'landing.coursesHubH1'),
  ),
];
---

<Landing
  locale={locale}
  title={title}
  description={description}
  sitePath="/courses/"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-5 pt-8 md:pt-12">
    <Breadcrumbs
      ariaLabel={t(locale, 'landing.breadcrumbHome')}
      items={[
        { label: t(locale, 'landing.breadcrumbHome'), href: href(locale, '/') },
        { label: t(locale, 'landing.breadcrumbCourses') },
      ]}
    />
    <h1 class="display mt-6 text-5xl md:text-6xl">{t(locale, 'landing.coursesHubH1')}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
      {t(locale, 'landing.coursesHubIntro')}
    </p>

    <!-- Filters as two hairline rows: a kicker, then the chips. -->
    <div
      class="mt-10 flex flex-col divide-y divide-border border-y border-border"
      data-course-filters
    >
      <div class="flex flex-wrap items-center gap-2 py-3">
        <span class="eyebrow mr-3">{t(locale, 'landing.filterEquipment')}</span>
        <a
          href={`${self}#courses`}
          data-filter="equipment"
          data-value="all"
          aria-current="true"
          class="filter-chip"
        >
          {t(locale, 'landing.filterAll')}
        </a>
        {
          equipmentOptions.map((e) => (
            <a
              href={`${self}?equipment=${e}#courses`}
              data-filter="equipment"
              data-value={e}
              class="filter-chip"
            >
              {equipmentLabel(locale, e)}
            </a>
          ))
        }
      </div>
      <div class="flex flex-wrap items-center gap-2 py-3">
        <span class="eyebrow mr-3">{t(locale, 'landing.filterLevel')}</span>
        <a
          href={`${self}#courses`}
          data-filter="level"
          data-value="all"
          aria-current="true"
          class="filter-chip"
        >
          {t(locale, 'landing.filterAll')}
        </a>
        {
          levelOptions.map((lv) => (
            <a
              href={`${self}?level=${lv}#courses`}
              data-filter="level"
              data-value={String(lv)}
              class="filter-chip"
            >
              {levelLabel(locale, lv)}
            </a>
          ))
        }
      </div>
    </div>

    <ul
      id="courses"
      class="mt-8 grid scroll-mt-24 gap-5 sm:grid-cols-2 lg:grid-cols-3"
      aria-label={t(locale, 'landing.filterResultsLabel')}
    >
      {
        SITE_COURSES.map((c) => (
          <li data-course-item data-equipment={c.equipment.join(' ')} data-level={c.level}>
            <CourseCard course={c} locale={locale} headingLevel="h2" />
          </li>
        ))
      }
    </ul>
    <p hidden data-filter-empty role="status" class="mt-8 border-t border-border pt-5 text-muted">
      {t(locale, 'landing.filterNoResults')}
      <a
        href={`${self}#courses`}
        data-filter-reset
        class="control-label ml-3 inline-flex min-h-11 items-center text-[12px] text-text hover:opacity-85"
      >
        {t(locale, 'landing.filterReset')}
      </a>
    </p>
  </div>

  <div class="mx-auto max-w-6xl px-5 pt-10">
    <SubscribeBanner locale={locale} />
  </div>

  <Cta
    title={t(locale, 'landing.ctaTitle')}
    text={t(locale, 'landing.ctaText')}
    primary={{ label: t(locale, 'landing.heroCtaApp'), href: appHref() }}
  />
</Landing>

<style>
  /*
   * The kit's Chip as a scoped style (the chips are plain <a> links so filtering works without
   * JS): 34px, capitals at 12px tracked .06em, --surface-3 behind a hairline. The selected filter
   * is the white fill with black text — the same inversion the primary button uses, and the only
   * fill in the row. The visual box is 34px; the pseudo-element grows the hit area to 44px.
   */
  .filter-chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 2.125rem;
    padding: 0 0.75rem;
    border: 1px solid var(--border);
    background: var(--surface-3);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--muted);
    transition:
      color 150ms var(--ease-out),
      border-color 150ms var(--ease-out),
      background 150ms var(--ease-out),
      transform 150ms var(--ease-out);
  }
  .filter-chip::before {
    content: '';
    position: absolute;
    inset: -5px 0;
  }
  .filter-chip:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }
  .filter-chip:active {
    transform: scale(0.98);
  }
  .filter-chip[aria-current='true'] {
    background: var(--primary);
    border-color: var(--primary);
    color: var(--on-primary);
  }
</style>

<script>
  // Client-side filtering. Without JS the chips are plain links and all courses stay visible.
  const root = document.querySelector<HTMLElement>('[data-course-filters]');
  if (root) {
    const chips = Array.from(root.querySelectorAll<HTMLAnchorElement>('a[data-filter]'));
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-course-item]'));
    const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
    const reset = document.querySelector<HTMLAnchorElement>('[data-filter-reset]');
    type FilterKey = 'equipment' | 'level';
    const isFilterKey = (k: string | undefined): k is FilterKey =>
      k === 'equipment' || k === 'level';
    const state: Record<FilterKey, string> = { equipment: 'all', level: 'all' };

    const apply = () => {
      let visible = 0;
      for (const item of items) {
        const eq = (item.dataset.equipment ?? '').split(' ');
        const okEq = state.equipment === 'all' || eq.includes(state.equipment);
        const okLv = state.level === 'all' || item.dataset.level === state.level;
        const show = okEq && okLv;
        item.hidden = !show;
        if (show) visible++;
      }
      if (empty) empty.hidden = visible > 0;
      for (const chip of chips) {
        const key = chip.dataset.filter;
        const pressed = isFilterKey(key) && state[key] === chip.dataset.value;
        if (pressed) chip.setAttribute('aria-current', 'true');
        else chip.removeAttribute('aria-current');
      }
      const params = new URLSearchParams();
      if (state.equipment !== 'all') params.set('equipment', state.equipment);
      if (state.level !== 'all') params.set('level', state.level);
      const qs = params.toString();
      history.replaceState(null, '', `${location.pathname}${qs ? `?${qs}` : ''}${location.hash}`);
    };

    const initial = new URLSearchParams(location.search);
    for (const key of ['equipment', 'level'] as const) {
      const v = initial.get(key);
      if (v) state[key] = v;
    }
    for (const chip of chips) {
      chip.addEventListener('click', (e) => {
        e.preventDefault();
        const key = chip.dataset.filter;
        if (!isFilterKey(key)) return;
        state[key] = chip.dataset.value ?? 'all';
        apply();
      });
    }
    reset?.addEventListener('click', (e) => {
      e.preventDefault();
      state.equipment = 'all';
      state.level = 'all';
      apply();
    });
    apply();
  }
</script>
