---
/**
 * Course page: the course as a ticket (cover, kicker, name, pills, the price as the figure, one
 * button), its figures, about / for whom / outcomes, program overview, sample workout, how the app
 * adapts, order form, FAQ, related guides and exercises. JSON-LD: Course, BreadcrumbList, FAQPage.
 *
 * Drawn in the owner's prototype's language (design/CHANGELOG.md §10): the headings and the
 * coach's text stay — they are what this page ranks on — but the page shows one paragraph of him
 * and opens the rest on request, and every fact that was a sentence is a pill or a numeral.
 *
 * **Workout 1 first** (site synthesis §5, «Course page»). For the start course the ticket's neon is
 * «Тренировка 1 — бесплатно» into the app's `#/start`, and «Получить доступ · 2 990 ₽» is the
 * white second button to `#order`; the club line under it quotes 666 ₽ only with the year's
 * 7 990 ₽ (EN: the year only). «Первая тренировка — бесплатно» shows workout 1's three movements as
 * loops, folds the full plan under a toggle and puts the QR beside the button from `lg`. «Как
 * приложение подстраивается» is the engine's four steps as figures (`ADAPTATION`, never typed),
 * and a small «Позови с собой» strip to `/together/` stands before the FAQ.
 */
import type { InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';
import Landing from '@/layouts/Landing.astro';
import ExerciseStill from '@/components/media/ExerciseStill';
import Breadcrumbs from '@/components/landing/Breadcrumbs.astro';
import Button from '@/components/landing/Button.astro';
import Faq from '@/components/landing/Faq.astro';
import HeroField from '@/components/landing/HeroField.astro';
import KeyTitle from '@/components/landing/KeyTitle.astro';
import OrderForm from '@/components/landing/OrderForm';
import Pill from '@/components/landing/Pill.astro';
import ProgramOverview from '@/components/landing/ProgramOverview.astro';
import Section from '@/components/landing/Section.astro';
import QrCode from '@/components/landing/QrCode.astro';
import Stat from '@/components/landing/Stat.astro';
import WorkoutPlan from '@/components/landing/WorkoutPlan.astro';
import LoopTile from '@/components/landing/media/LoopTile.astro';
import { firstWorkoutFacts } from '@/components/landing/demo';
import { Doodle } from '@/components/ui/Doodle';
import {
  courseEquipmentForDisplay,
  coursePath,
  courseWorkoutCount,
  equipmentLabel,
  exerciseHref,
  levelLabel,
  metaDescription,
  sampleWorkout,
  sessionsLabel,
  signatureExercise,
  weeksLabel,
  workoutsCountLabel,
} from '@/components/landing/courseHelpers';
import { breadcrumbLd, courseLd, faqLd } from '@/components/landing/jsonld';
import { courseExercises } from '@/content/registry';
import { isCreatorCourse, SITE_COURSES } from '@/content/published';
import { SITE_CREATORS } from '@/content/creators';
import { DEFAULT_LOCALE, LOCALES, type Locale } from '@/content/schema';
import { l, plural, t } from '@/i18n/index';
import { publicMediaUrl } from '@/lib/api/storage';
import { canonicalUrl } from '@/lib/seo/urls';
import { ADAPTATION } from '@/lib/training/constants';
import { courseTileStyle } from '@/lib/ui/tile';
import { absoluteUrl, appHref, href } from '@/lib/util/paths';
import { BRAND } from '@content/site/brand';
import { LINKS } from '@content/site/links';
import { formatPrice, isFree } from '@content/site/pricing';
import { CLUB_PLAN_ID, PLAN_BY_ID, PLANS_ENABLED, planMonthlyPrice } from '@content/site/plans';

export function getStaticPaths() {
  return SITE_COURSES.flatMap((c) =>
    LOCALES.map((locale) => ({
      params: { lang: locale === DEFAULT_LOCALE ? undefined : locale, slug: c.slug[locale] },
      props: { courseId: c.id },
    })),
  );
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { courseId } = Astro.props as Props;
const locale: Locale = Astro.params.lang === 'en' ? 'en' : 'ru';
// The club's plan, quoted per month the way the club screen quotes it (year ÷ 12, never retyped).
const clubPlan = PLAN_BY_ID.get(CLUB_PLAN_ID);
const site = (Astro.site?.toString() ?? 'http://localhost:4321').replace(/\/$/, '');

const course = SITE_COURSES.find((c) => c.id === courseId)!;
const name = l(course.name, locale);
/*
 * Where «do it in the app» and the paid order's «open the app» land: this course, not the home
 * screen. The beginner course goes through `#/start` — its first trainable workout, whatever its
 * layout — and any other through its path. Both survive sign-in (src/app/features/entry/next.ts).
 */
const isStart = course.id === 'start';
const courseAppHref = appHref(isStart ? '/start' : `/courses/${course.id}`, {
  locale,
});
/*
 * The club line under the ticket: the month only beside the year's single charge (RU), the year
 * alone on EN — the same rule `clubPriceLabels` keeps, with the course page's own sentence.
 */
const clubLine =
  PLANS_ENABLED && clubPlan
    ? t(locale, 'landing.courseOrSubscribe', {
        price: formatPrice(locale, planMonthlyPrice(clubPlan)),
        year: formatPrice(locale, clubPlan.price),
      })
    : '';
/* Workout 1's movements as loops, and the QR a desktop visitor scans to open it on the phone. */
const facts = isStart ? firstWorkoutFacts(locale, course) : null;
const qrUrl = `${absoluteUrl(site, '/app/')}?lang=${locale}&src=qr#/${isStart ? 'start' : `courses/${course.id}`}`;
/* The engine's four steps after a workout, as signed whole percents: +5, +2, −5, −10. */
const signed = (d: number) => `${d > 0 ? '+' : '−'}${Math.abs(Math.round(d * 100))}`;
const adaptSteps = [
  { value: signed(ADAPTATION.easyDelta), label: t(locale, 'landing.courseAdaptStepEasy') },
  { value: signed(ADAPTATION.moderateDelta), label: t(locale, 'landing.courseAdaptStepOk') },
  { value: signed(ADAPTATION.hardDelta), label: t(locale, 'landing.courseAdaptStepHard') },
  { value: signed(ADAPTATION.painDelta), label: t(locale, 'landing.courseAdaptStepPain') },
];
// Keep <title> ≤ 60 chars once SeoHead appends " — Forma": drop the suffix for long names.
const titleWithSuffix = `${name} — ${t(locale, 'landing.courseTitleSuffix')}`;
const title = `${titleWithSuffix} — ${BRAND.name}`.length <= 60 ? titleWithSuffix : name;
const description = metaDescription(
  `${l(course.tagline, locale)} ${l(course.description, locale)}`,
);
const localizedPaths = { ru: coursePath('ru', course), en: coursePath('en', course) };
const url = canonicalUrl(site, locale, coursePath(locale, course));
const image = absoluteUrl(site, BRAND.ogImage);

const signature = signatureExercise(course);
/*
 * The course's own cover art beats the signature movement's still — the same rule as the ticket
 * (`CourseCard`) and the app. This page used to draw the still on the flat programme colour even
 * when the course had art, so the same course wore two covers on two pages.
 */
const cover = course.cover ? publicMediaUrl(course.cover) : undefined;
const workout = sampleWorkout(course);
const exercises = courseExercises(course);
const equipment = courseEquipmentForDisplay(course);
const workouts = courseWorkoutCount(course);

const price = isFree(course.price, locale)
  ? t(locale, 'landing.priceFree')
  : formatPrice(locale, course.price);
const paymentUrl = course.paymentUrl?.[locale] || course.paymentUrl?.ru || course.paymentUrl?.en;

/* The figures under the ticket: the number is the object, the word under it the unit. */
const weeksWord = plural(locale, course.weeks, {
  one: t(locale, 'landing.weekWordOne'),
  few: t(locale, 'landing.weekWordFew'),
  many: t(locale, 'landing.weekWordMany'),
});
const workoutsWord = plural(locale, workouts, {
  one: t(locale, 'landing.workoutWordOne'),
  few: t(locale, 'landing.workoutWordFew'),
  many: t(locale, 'landing.workoutWordMany'),
});

const guides = (
  await getCollection(
    'guides',
    (g) =>
      !g.data.draft && g.id.startsWith(`${locale}/`) && g.data.relatedCourses.includes(course.id),
  )
).sort((a, b) => b.data.priority - a.data.priority);

/*
 * The closing link lists stay short on a phone: the five strongest guides and workout 1's own
 * movements (or the first six of the course without it), each with a link to its full hub. All
 * sixteen guides and twenty-eight chips were the longest block on the page, and both hubs list
 * everything anyway.
 */
const quietLink =
  'control-label inline-flex min-h-11 items-center gap-2 text-[14px] text-text underline decoration-border-strong underline-offset-4 hover:decoration-text';
const GUIDES_SHOWN = 5;
const guidesShown = guides.slice(0, GUIDES_SHOWN);
const workout1Ids = new Set(facts?.moves.map((m) => m.exerciseId) ?? []);
const exercisesShown =
  workout1Ids.size > 0 ? exercises.filter((ex) => workout1Ids.has(ex.id)) : exercises.slice(0, 6);

const supportEmail = LINKS.supportEmail || BRAND.contactEmail;
const supportTelegram = LINKS.supportTelegram || BRAND.telegram;
// One screen, one colour: the course's programme colour is set once on every block that shows it.
const tileVars = courseTileStyle(course.tile);

const [firstParagraph, ...moreParagraphs] = course.longDescription;

/*
 * The instructor in the structured data: Forma's coach for Forma's courses; for a creator's course
 * (0068) the creator by name, or nobody when the creator has no page (paused, say) — never Sergey.
 */
const owner = SITE_CREATORS.find((c) => c.courses.some((x) => x.id === course.id));
const instructor = owner ? owner.name : isCreatorCourse(course.id) ? null : undefined;

const jsonLd = [
  courseLd(site, locale, course, { url, image, instructor }),
  breadcrumbLd([
    { name: t(locale, 'landing.breadcrumbHome'), url: canonicalUrl(site, locale, '/') },
    { name: t(locale, 'landing.breadcrumbCourses'), url: canonicalUrl(site, locale, '/courses/') },
    { name, url },
  ]),
  faqLd(course.faq, locale),
];
---

<Landing
  locale={locale}
  title={title}
  description={description}
  sitePath={coursePath(locale, course)}
  localizedPaths={localizedPaths}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-5 pt-8 md:pt-12" style={tileVars}>
    <Breadcrumbs
      ariaLabel={t(locale, 'landing.breadcrumbHome')}
      items={[
        { label: t(locale, 'landing.breadcrumbHome'), href: href(locale, '/') },
        { label: t(locale, 'landing.breadcrumbCourses'), href: href(locale, '/courses/') },
        { label: name },
      ]}
    />

    <!--
      The ticket, opened up to a page. On the phone the cover comes first — the same object the
      app's «Программы» tab shows, at the same 4:3 — and the words follow; from `md` the words take
      the 7 of a 7/5 grid and the cover stands beside them.
    -->
    <section
      class="mt-6 grid gap-8 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:items-end md:gap-14"
    >
      <div
        class:list={[
          'relative aspect-4/3 w-full overflow-hidden rounded-card md:order-2',
          cover ? 'bg-ink' : 'hero-art',
        ]}
      >
        {
          cover ? (
            <img
              src={cover}
              alt=""
              width="1600"
              height="1200"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="absolute inset-0 size-full object-cover"
            />
          ) : (
            <div class="absolute inset-0 flex items-center justify-center">
              {signature && <ExerciseStill exerciseId={signature.id} loading="eager" />}
              {signature && (
                <span class="absolute bottom-4 left-4 flex">
                  <Pill tone="ink" size="sm">
                    {l(signature.name, locale)}
                  </Pill>
                </span>
              )}
            </div>
          )
        }
      </div>

      <!--
        The words in the page's blue field (Style A): the name in white with its last word in light
        blue over the swoosh, the level as the section's own tag — orange for the beginners,
        whatever the course's colour is otherwise — and the facts as white hairline pills. The
        course-coloured outline pills of the rest of the page would not read here: orange on the
        field is 2.5:1.
      -->
      <div class="md:order-1">
        <HeroField>
          <div class="flex flex-wrap items-center gap-3">
            <Pill tone="course-fill" size="md" tilt="left">{levelLabel(locale, course.level)}</Pill>
            <p class="eyebrow">{t(locale, 'landing.cardKicker')}</p>
          </div>
          <KeyTitle text={name} class="display mt-5 text-[clamp(1.625rem,6vw,2.5rem)]" />
          <p class="field-lead mt-5 max-w-xl text-base leading-relaxed md:text-lg">
            {l(course.tagline, locale)}
          </p>
          <ul class="mt-5 flex flex-wrap gap-2">
            <li class="flex max-w-full">
              <Pill tone="ghost" size="md">{weeksLabel(locale, course.weeks)}</Pill>
            </li>
            <li class="flex max-w-full">
              <Pill tone="ghost" size="md">{sessionsLabel(locale, course.sessionsPerWeek)}</Pill>
            </li>
            <li class="flex max-w-full">
              <Pill tone="ghost" size="md"
                >{t(locale, 'landing.avgSession', { n: course.avgSessionMin })}</Pill
              >
            </li>
            {
              equipment.map((e) => (
                <li class="flex max-w-full">
                  <Pill tone="ghost" size="md">
                    {equipmentLabel(locale, e)}
                  </Pill>
                </li>
              ))
            }
            <li class="flex max-w-full">
              <Pill tone="white" size="md">{t(locale, 'landing.courseLifetimeNote')}</Pill>
            </li>
          </ul>
        </HeroField>
        {
          /*
            The start course leads with workout 1 in neon and prices the course in the white
            button beside it; any other course keeps its price as the figure and one button.
          */
        }
        {
          isStart ? (
            <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
              <Button
                href={courseAppHref}
                size="lg"
                class="w-full sm:w-auto"
                data-goal="app_start"
                data-app-link
              >
                {t(locale, 'landing.cardStartCta')}
              </Button>
              <Button href="#order" variant="plain" size="lg" class="w-full sm:w-auto">
                {t(locale, 'landing.courseBuyCta', { price })}
              </Button>
            </div>
          ) : (
            <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-4">
              <span class="numeral tabular text-5xl leading-none">{price}</span>
              <Button href="#order" size="lg" class="w-full sm:w-auto">
                {t(locale, 'landing.courseCtaOrder')}
              </Button>
            </div>
          )
        }
        {
          clubLine && (
            <p class="mt-4 text-sm">
              <a
                href={href(locale, '/subscribe/')}
                class="text-muted underline decoration-border-strong underline-offset-4 hover:text-text hover:decoration-text"
              >
                {clubLine}
              </a>
            </p>
          )
        }
      </div>
    </section>

    <!-- The course in three figures, in the light blue of key figures: the number bigger than the word. -->
    <div class="mt-12 grid grid-cols-3 gap-6 border-t border-border pt-8 md:mt-16 md:gap-10">
      <Stat tone="accent" value={String(course.weeks)} label={weeksWord} />
      <Stat tone="accent" value={String(workouts)} label={workoutsWord} />
      <Stat
        tone="accent"
        value={`~${course.avgSessionMin}`}
        label={t(locale, 'common.minutesUnit')}
      />
    </div>
  </div>

  <Section id="about" title={t(locale, 'landing.courseAboutTitle')} class="!py-12 md:!py-16">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)]" style={tileVars}>
      {
        /*
          The coach's text, one paragraph showing. The other three are his too and stay on the
          page — this is the copy the page is found by — but they open on request instead of
          standing four deep between the ticket and the programme. A details element keeps them in
          the HTML and out of the way; the toggle is the FAQ's + glyph.
        */
      }
      <div class="text-base leading-relaxed text-muted md:text-lg">
        {firstParagraph && <p>{l(firstParagraph, locale)}</p>}
        {
          moreParagraphs.length > 0 && (
            <details class="group mt-4">
              <summary class="control-label flex cursor-pointer list-none items-center gap-2 text-[12px] text-text [&::-webkit-details-marker]:hidden">
                {t(locale, 'landing.courseMoreAbout')}
                <span
                  class="glyph text-lg transition-transform duration-150 ease-(--ease-out) group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <div class="mt-4 flex flex-col gap-4">
                {moreParagraphs.map((p) => (
                  <p>{l(p, locale)}</p>
                ))}
              </div>
            </details>
          )
        }
      </div>
      <!-- Three hairline blocks, not three boxes: a kicker, then the list. -->
      <div class="flex flex-col gap-8">
        <div class="border-t border-border pt-5">
          <h3 class="eyebrow">
            {t(locale, 'landing.courseForWhomTitle')}
          </h3>
          <ul class="mt-4 flex flex-col divide-y divide-border text-sm">
            {
              course.forWhom.map((x, i) => (
                <li class="flex items-baseline gap-4 py-2.5">
                  <span
                    class="numeral tabular w-5 shrink-0 text-xs text-muted-2"
                    aria-hidden="true"
                  >
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span>{l(x, locale)}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="border-t border-border pt-5">
          <h3 class="eyebrow">
            {t(locale, 'landing.courseOutcomesTitle')}
          </h3>
          <ul class="mt-4 flex flex-col divide-y divide-border text-sm">
            {
              course.outcomes.map((x) => (
                <li class="flex items-baseline gap-4 py-2.5">
                  <span class="glyph shrink-0 text-sm text-accent" aria-hidden="true">
                    ✓
                  </span>
                  <span>{l(x, locale)}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="border-t border-border pt-5">
          <h3 class="eyebrow">
            {t(locale, 'landing.courseEquipmentTitle')}
          </h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {
              equipment.map((e) => (
                <li class="flex max-w-full">
                  <Pill tone="course" size="md">
                    {equipmentLabel(locale, e)}
                  </Pill>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </Section>

  <Section
    id="program"
    title={t(locale, 'landing.courseProgramTitle')}
    intro={t(locale, 'landing.courseProgramIntro')}
    class="!py-12 md:!py-16"
  >
    <div style={tileVars}>
      <ProgramOverview locale={locale} course={course} />
    </div>
  </Section>

  {
    workout && (
      <Section
        id="sample"
        title={t(locale, 'landing.courseSampleTitle')}
        intro={t(locale, 'landing.courseSampleIntro')}
        class="!py-12 md:!py-16"
      >
        {/*
          Кнопка стоит над планом, а не под ним: человек, уже решивший попробовать, не должен
          пролистывать всю тренировку, чтобы найти вход. Движения — петлями видео тренера; план
          целиком свёрнут под переключателем, QR — рядом с кнопкой с `lg`.
        */}
        {facts && (
          <ul class="-mx-5 mb-8 flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-px-5 px-5 pb-2 sm:mx-0 sm:grid sm:grid-cols-3 sm:overflow-visible sm:px-0 md:gap-4">
            {facts.moves.map((m) => (
              <li class="w-[72%] shrink-0 snap-start sm:w-auto">
                <LoopTile
                  id={m.exerciseId}
                  name={m.name}
                  numeral={m.reps ? `×${m.reps}` : undefined}
                  href={m.href}
                  size="lg"
                />
              </li>
            ))}
          </ul>
        )}
        <div class="flex flex-wrap items-center gap-6">
          <Button
            href={courseAppHref}
            size="lg"
            class="w-full sm:w-auto"
            data-goal="app_start"
            data-app-link
          >
            {t(locale, 'landing.courseSampleCta')}
          </Button>
          <QrCode url={qrUrl} label={t(locale, 'landing.qrLabel')} class="max-lg:hidden" />
        </div>
        <details class="group mt-8" style={tileVars}>
          <summary class="control-label flex min-h-11 cursor-pointer list-none items-center gap-2 text-[14px] text-text [&::-webkit-details-marker]:hidden">
            {t(locale, 'landing.courseSamplePlan')}
            <span
              class="glyph text-lg transition-transform duration-150 ease-(--ease-out) group-open:rotate-45"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <div class="mt-4">
            <WorkoutPlan locale={locale} workout={workout} />
          </div>
        </details>
      </Section>
    )
  }

  {
    /*
    How the load follows the athlete: the engine's four steps as figures, one tile each, read from
    `ADAPTATION` — the course has no deload, so the page no longer promises one.
  */
  }
  <Section
    id="adapt"
    title={t(locale, 'landing.courseAdaptTitle')}
    intro={t(locale, 'landing.courseAdaptText')}
    class="!py-12 md:!py-16"
  >
    <ul class="grid grid-cols-2 gap-3 md:grid-cols-4">
      {
        adaptSteps.map((step) => (
          <li class="glass-card flex min-h-[8.5rem] flex-col justify-between gap-4 rounded-tile border border-border p-4 md:p-5">
            <span class="numeral text-5xl leading-none text-accent">
              {step.value}
              <span class="text-2xl"> %</span>
            </span>
            <span class="font-display text-[15px] leading-snug md:text-base">{step.label}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section
    id="order"
    title={t(locale, 'landing.courseOrderTitle')}
    intro={t(locale, 'landing.courseOrderIntro')}
    class="scroll-mt-16 !py-12 md:!py-16"
  >
    <div class="grid gap-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]" style={tileVars}>
      <!-- The order ticket: the programme colour with black ink, the price as the figure. -->
      <div class="hero-art flex flex-col justify-between rounded-card p-6 md:p-8">
        <div>
          <p class="eyebrow text-current opacity-70">
            {t(locale, 'landing.cardKicker')} · {levelLabel(locale, course.level)}
          </p>
          <p class="display mt-3 text-2xl md:text-3xl">{name}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            <li class="flex max-w-full">
              <span
                class="control-label inline-flex h-7 items-center rounded-pill border border-current/40 px-3 text-[10px]"
              >
                {weeksLabel(locale, course.weeks)}
              </span>
            </li>
            <li class="flex max-w-full">
              <span
                class="control-label inline-flex h-7 items-center rounded-pill border border-current/40 px-3 text-[10px]"
              >
                {workoutsCountLabel(locale, workouts)}
              </span>
            </li>
            <li class="flex max-w-full">
              <span
                class="control-label inline-flex h-7 items-center rounded-pill border border-current/40 px-3 text-[10px]"
              >
                {t(locale, 'landing.courseLifetimeNote')}
              </span>
            </li>
          </ul>
        </div>
        {
          /* То, что человек получает до всякого решения, — над числом, которого он пока не решил
            платить. */
        }
        {
          /* The tile's own ink: `text-course-accent` is the colour *as type on charcoal*, and here
            it is the fill itself — orange words on the orange ticket. */
        }
        <p class="eyebrow mt-10 text-current">{t(locale, 'landing.courseFreeFirst')}</p>
        <p class="numeral tabular mt-2 text-5xl leading-none md:text-6xl">{price}</p>
      </div>
      <div class="glass-card rounded-card border border-border p-6 md:p-8">
        <OrderForm
          client:load
          courseId={course.id}
          courseName={name}
          locale={locale}
          paymentUrl={paymentUrl}
          appUrl={courseAppHref}
          privacyUrl={href(locale, '/privacy/')}
          supportEmail={supportEmail}
          supportTelegram={supportTelegram}
          labels={{
            emailLabel: t(locale, 'landing.orderEmailLabel'),
            emailPlaceholder: t(locale, 'landing.orderEmailPlaceholder'),
            consent: t(locale, 'landing.orderConsent'),
            consentLink: t(locale, 'landing.orderConsentPrivacy'),
            submit: t(locale, 'landing.orderSubmit'),
            submitting: t(locale, 'landing.orderSubmitting'),
            redirecting: t(locale, 'landing.orderRedirecting'),
            paymentNote: t(locale, 'landing.orderPaymentNote'),
            successTitle: t(locale, 'landing.orderSuccessTitle'),
            successText: t(locale, 'landing.orderSuccessText'),
            successApp: t(locale, 'landing.orderSuccessApp'),
            errorEmail: t(locale, 'landing.orderErrorEmail'),
            emailTypo: t(locale, 'landing.orderEmailTypo'),
            errorConsent: t(locale, 'landing.orderErrorConsent'),
            errorNetwork: t(locale, 'landing.orderErrorNetwork'),
            errorGeneric: t(locale, 'landing.orderErrorGeneric'),
            notConfigured: t(locale, 'landing.orderNotConfigured'),
            payAnyway: t(locale, 'landing.orderPayAnyway'),
            tryAgain: t(locale, 'landing.orderTryAgain'),
            lifetimeNote: t(locale, 'landing.courseLifetimeNote'),
            telegramLabel: t(locale, 'landing.contactTelegram'),
          }}
        />
      </div>
    </div>
  </Section>

  {
    /*
    «Позови с собой»: one line and one button to `/together/`, where the invite card lives — the
    course's own FAQ follows.
  */
  }
  <div class="mx-auto max-w-6xl px-5">
    <div
      class="glass-card flex flex-col gap-4 rounded-card border border-border p-5 sm:flex-row sm:items-center sm:justify-between md:p-6"
    >
      <p class="flex items-center gap-4">
        <span class="shrink-0 text-accent" aria-hidden="true">
          <Doodle kind="heart" className="size-10" />
        </span>
        <span class="font-display text-[15px] leading-snug md:text-base">
          {t(locale, 'landing.courseInviteLine')}
        </span>
      </p>
      <Button
        href={href(locale, '/together/')}
        variant="secondary"
        class="w-full shrink-0 sm:w-auto"
        data-goal="share_course"
      >
        {t(locale, 'landing.shareCta')}
      </Button>
    </div>
  </div>

  <Section id="faq" title={t(locale, 'landing.courseFaqTitle')} class="!py-12 md:!py-16">
    <Faq items={course.faq.map((f) => ({ q: l(f.q, locale), a: l(f.a, locale) }))} />
  </Section>

  {
    (guides.length > 0 || exercises.length > 0) && (
      <section class="mx-auto max-w-6xl px-5 py-12 md:py-16">
        <div class="grid gap-8 lg:grid-cols-2">
          {guides.length > 0 && (
            <div>
              <h2 class="font-display text-2xl">{t(locale, 'landing.courseGuidesTitle')}</h2>
              {/*
                Titles only. Every guide's description opened by restating its own title in longer
                words — sixteen of them made a third of this page a wall of text that said the same
                thing twice and lived on the guide's own page anyway. The link and its anchor text
                are what the internal-linking rule (docs/SPEC.md §11) asks for, and both stay; the
                arrow says the row is a door.
              */}
              <ul class="mt-5 flex flex-col">
                {guidesShown.map((g) => (
                  <li>
                    <a
                      href={href(locale, `/guides/${g.id.slice(locale.length + 1)}/`)}
                      class="group flex items-baseline justify-between gap-4 border-t border-border py-3.5 transition-colors duration-150 hover:border-border-strong"
                    >
                      <span class="text-sm font-semibold group-hover:underline">{g.data.h1}</span>
                      <span class="glyph shrink-0 text-muted" aria-hidden="true">
                        →
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
              {guides.length > guidesShown.length && (
                <a href={href(locale, '/guides/')} class={`mt-4 ${quietLink}`}>
                  {t(locale, 'seo.guidesAll')}
                  <span class="glyph" aria-hidden="true">
                    →
                  </span>
                </a>
              )}
            </div>
          )}
          {exercises.length > 0 && (
            <div>
              <h2 class="font-display text-2xl">{t(locale, 'landing.courseExercisesTitle')}</h2>
              {/* Links, so they stay on the control radius: these are pressed, not read. */}
              <ul class="mt-5 flex flex-wrap gap-2">
                {exercisesShown.map((ex) => (
                  <li>
                    <a
                      href={exerciseHref(locale, ex)}
                      class="inline-flex min-h-11 items-center rounded-control border border-border bg-surface-3 px-4 text-sm transition-colors duration-150 hover:border-border-strong"
                    >
                      {l(ex.name, locale)}
                    </a>
                  </li>
                ))}
              </ul>
              {exercises.length > exercisesShown.length && (
                <a href={href(locale, '/exercises/')} class={`mt-4 ${quietLink}`}>
                  {t(locale, 'landing.filmedMore')}
                  <span class="glyph" aria-hidden="true">
                    →
                  </span>
                </a>
              )}
            </div>
          )}
        </div>
      </section>
    )
  }
</Landing>
