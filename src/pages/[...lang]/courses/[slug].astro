---
/**
 * Course page: hero, description, for whom / outcomes, equipment, program overview, sample
 * workout, how the app adapts, order form, FAQ, related guides and exercises.
 * JSON-LD: Course, BreadcrumbList, FAQPage.
 */
import type { InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';
import Landing from '@/layouts/Landing.astro';
import ExerciseFigure from '@/components/anim/ExerciseFigure';
import Breadcrumbs from '@/components/landing/Breadcrumbs.astro';
import Button from '@/components/landing/Button.astro';
import Faq from '@/components/landing/Faq.astro';
import FeatureChip from '@/components/landing/FeatureChip.astro';
import OrderForm from '@/components/landing/OrderForm';
import ProgramOverview from '@/components/landing/ProgramOverview.astro';
import Section from '@/components/landing/Section.astro';
import WorkoutPlan from '@/components/landing/WorkoutPlan.astro';
import {
  courseEquipmentForDisplay,
  coursePath,
  equipmentLabel,
  exerciseHref,
  isBodyweightCourse,
  levelLabel,
  metaDescription,
  sampleWorkout,
  sessionsLabel,
  signatureExercise,
  weeksLabel,
} from '@/components/landing/courseHelpers';
import { breadcrumbLd, courseLd, faqLd } from '@/components/landing/jsonld';
import { courseExercises } from '@/content/registry';
import { SITE_COURSES } from '@/content/published';
import { DEFAULT_LOCALE, LOCALES, type Locale } from '@/content/schema';
import { l, t } from '@/i18n/index';
import { canonicalUrl } from '@/lib/seo/urls';
import { courseTileStyle } from '@/lib/ui/tile';
import { absoluteUrl, appHref, href } from '@/lib/util/paths';
import { BRAND } from '@content/site/brand';
import { LINKS } from '@content/site/links';
import { formatPrice, isFree } from '@content/site/pricing';
import { PLAN_BY_ID, PLANS_ENABLED } from '@content/site/plans';

export function getStaticPaths() {
  return SITE_COURSES.flatMap((c) =>
    LOCALES.map((locale) => ({
      params: { lang: locale === DEFAULT_LOCALE ? undefined : locale, slug: c.slug[locale] },
      props: { courseId: c.id },
    })),
  );
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { courseId } = Astro.props as Props;
const locale: Locale = Astro.params.lang === 'en' ? 'en' : 'ru';
const monthlyPlan = PLAN_BY_ID.get('monthly');
const site = (Astro.site?.toString() ?? 'http://localhost:4321').replace(/\/$/, '');

const course = SITE_COURSES.find((c) => c.id === courseId)!;
const name = l(course.name, locale);
// Keep <title> ≤ 60 chars once SeoHead appends " — Forma": drop the suffix for long names.
const titleWithSuffix = `${name} — ${t(locale, 'landing.courseTitleSuffix')}`;
const title = `${titleWithSuffix} — ${BRAND.name}`.length <= 60 ? titleWithSuffix : name;
const description = metaDescription(
  `${l(course.tagline, locale)} ${l(course.description, locale)}`,
);
const localizedPaths = { ru: coursePath('ru', course), en: coursePath('en', course) };
const url = canonicalUrl(site, locale, coursePath(locale, course));
const image = absoluteUrl(site, BRAND.ogImage);

const signature = signatureExercise(course);
const workout = sampleWorkout(course);
const exercises = courseExercises(course);
const equipment = courseEquipmentForDisplay(course);

const price = isFree(course.price, locale)
  ? t(locale, 'landing.priceFree')
  : formatPrice(locale, course.price);
const paymentUrl = course.paymentUrl?.[locale] || course.paymentUrl?.ru || course.paymentUrl?.en;

const guides = (
  await getCollection(
    'guides',
    (g) =>
      !g.data.draft && g.id.startsWith(`${locale}/`) && g.data.relatedCourses.includes(course.id),
  )
).sort((a, b) => b.data.priority - a.data.priority);

const supportEmail = LINKS.supportEmail || BRAND.contactEmail;
const supportTelegram = LINKS.supportTelegram || BRAND.telegram;
// One screen, one colour: the course's programme colour is set once on every block that shows it.
const tileVars = courseTileStyle(course.tile);

const jsonLd = [
  courseLd(site, locale, course, { url, image }),
  breadcrumbLd([
    { name: t(locale, 'landing.breadcrumbHome'), url: canonicalUrl(site, locale, '/') },
    { name: t(locale, 'landing.breadcrumbCourses'), url: canonicalUrl(site, locale, '/courses/') },
    { name, url },
  ]),
  faqLd(course.faq, locale),
];
---

<Landing
  locale={locale}
  title={title}
  description={description}
  sitePath={coursePath(locale, course)}
  localizedPaths={localizedPaths}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-5 pt-8 md:pt-12">
    <Breadcrumbs
      ariaLabel={t(locale, 'landing.breadcrumbHome')}
      items={[
        { label: t(locale, 'landing.breadcrumbHome'), href: href(locale, '/') },
        { label: t(locale, 'landing.breadcrumbCourses'), href: href(locale, '/courses/') },
        { label: name },
      ]}
    />

    <section
      class="mt-6 grid items-end gap-8 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:gap-14"
      style={tileVars}
    >
      <div>
        <p class="eyebrow">
          {levelLabel(locale, course.level)} · {weeksLabel(locale, course.weeks)}
        </p>
        <h1 class="display mt-4 text-[clamp(1.625rem,6vw,2.5rem)] text-balance">
          {name}
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
          {l(course.tagline, locale)}
        </p>
        <ul class="mt-6 flex flex-wrap gap-2">
          <li><FeatureChip>{weeksLabel(locale, course.weeks)}</FeatureChip></li>
          <li><FeatureChip>{sessionsLabel(locale, course.sessionsPerWeek)}</FeatureChip></li>
          <li>
            <FeatureChip>{t(locale, 'landing.avgSession', { n: course.avgSessionMin })}</FeatureChip
            >
          </li>
          {
            equipment.map((e) => (
              <li>
                <FeatureChip>{equipmentLabel(locale, e)}</FeatureChip>
              </li>
            ))
          }
        </ul>
        <div class="mt-8 flex flex-wrap items-center gap-5">
          <span class="numeral tabular text-4xl">{price}</span>
          <Button href="#order" size="lg">{t(locale, 'landing.courseCtaOrder')}</Button>
        </div>
        <p class="mt-3 text-sm text-muted">{t(locale, 'landing.courseLifetimeNote')}</p>
        {
          PLANS_ENABLED && monthlyPlan && (
            <p class="mt-2 text-sm">
              <a
                href={href(locale, '/subscribe/')}
                class="underline decoration-border-strong underline-offset-4 hover:decoration-text"
              >
                {t(locale, 'landing.courseOrSubscribe', {
                  price: formatPrice(locale, monthlyPlan.price),
                })}
              </a>
            </p>
          )
        }
      </div>

      <!-- The cover: the programme colour, the signature figure in black ink, the name stamped. -->
      <div
        class="hero-art relative mx-auto flex aspect-[4/5] w-full max-w-md items-center justify-center overflow-hidden md:max-w-none"
      >
        {
          signature && (
            <ExerciseFigure
              client:visible
              animation={signature.animation}
              variant="hero"
              tile={course.tile}
              label={l(signature.name, locale)}
            />
          )
        }
        {
          signature && (
            <span class="absolute bottom-5 left-5 inline-flex h-6 items-center bg-ink/85 px-2.5 text-[11px] font-semibold tracking-[0.12em] text-paper uppercase">
              {l(signature.name, locale)}
            </span>
          )
        }
        <span class="numeral absolute top-4 left-5 text-sm text-tile-fg" aria-hidden="true">
          {String(course.weeks).padStart(2, '0')}
        </span>
      </div>
    </section>
  </div>

  <Section id="about" title={t(locale, 'landing.courseAboutTitle')} class="!py-12 md:!py-16">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)]">
      <div class="flex flex-col gap-4 text-lg leading-relaxed text-muted">
        {course.longDescription.map((p) => <p>{l(p, locale)}</p>)}
      </div>
      <!-- Three hairline blocks, not three boxes: a kicker, then the list. -->
      <div class="flex flex-col gap-8">
        <div class="border-t border-border pt-5">
          <h3 class="eyebrow">
            {t(locale, 'landing.courseForWhomTitle')}
          </h3>
          <ul class="mt-4 flex flex-col divide-y divide-border">
            {
              course.forWhom.map((x, i) => (
                <li class="flex items-baseline gap-4 py-2.5">
                  <span class="numeral text-xs text-muted-2" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span>{l(x, locale)}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="border-t border-border pt-5">
          <h3 class="eyebrow">
            {t(locale, 'landing.courseOutcomesTitle')}
          </h3>
          <ul class="mt-4 flex flex-col divide-y divide-border">
            {
              course.outcomes.map((x) => (
                <li class="flex items-baseline gap-4 py-2.5">
                  <span class="glyph text-sm text-text" aria-hidden="true">
                    ✓
                  </span>
                  <span>{l(x, locale)}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="border-t border-border pt-5">
          <h3 class="eyebrow">
            {t(locale, 'landing.courseEquipmentTitle')}
          </h3>
          {
            isBodyweightCourse(course) ? (
              <p class="mt-4 text-muted">{t(locale, 'landing.courseEquipmentNone')}</p>
            ) : (
              <ul class="mt-4 flex flex-wrap gap-2">
                {equipment.map((e) => (
                  <li>
                    <FeatureChip tone="outline">{equipmentLabel(locale, e)}</FeatureChip>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </div>
    </div>
  </Section>

  <Section
    id="program"
    title={t(locale, 'landing.courseProgramTitle')}
    intro={t(locale, 'landing.courseProgramIntro')}
    class="!py-12 md:!py-16"
  >
    <ProgramOverview locale={locale} course={course} />
  </Section>

  {
    workout && (
      <Section
        id="sample"
        title={t(locale, 'landing.courseSampleTitle')}
        intro={t(locale, 'landing.courseSampleIntro')}
        class="!py-12 md:!py-16"
      >
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)]">
          <WorkoutPlan locale={locale} workout={workout} />
          <div class="border-t border-border pt-5">
            <h3 class="font-display text-xl">{t(locale, 'landing.courseAdaptTitle')}</h3>
            <p class="mt-4 leading-relaxed text-muted">{t(locale, 'landing.courseAdaptText')}</p>
          </div>
        </div>
      </Section>
    )
  }

  <Section
    id="order"
    title={t(locale, 'landing.courseOrderTitle')}
    intro={t(locale, 'landing.courseOrderIntro')}
    class="scroll-mt-16 !py-12 md:!py-16"
  >
    <div class="grid gap-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]" style={tileVars}>
      <!-- The order ticket: the programme colour with black ink, price as the numeral. -->
      <div class="hero-art flex flex-col justify-between p-6 md:p-8">
        <div>
          <p class="eyebrow text-current opacity-70">
            {levelLabel(locale, course.level)}
          </p>
          <p class="display mt-3 text-3xl md:text-4xl">{name}</p>
          <p class="mt-3 opacity-80">{l(course.tagline, locale)}</p>
        </div>
        <div class="mt-8 flex items-end justify-between gap-4">
          <span class="numeral tabular text-4xl">{price}</span>
          <span class="text-sm opacity-80">{weeksLabel(locale, course.weeks)}</span>
        </div>
      </div>
      <div class="border border-border bg-surface p-6 md:p-8">
        <OrderForm
          client:load
          courseId={course.id}
          courseName={name}
          locale={locale}
          paymentUrl={paymentUrl}
          appUrl={appHref()}
          privacyUrl={href(locale, '/privacy/')}
          supportEmail={supportEmail}
          supportTelegram={supportTelegram}
          labels={{
            emailLabel: t(locale, 'landing.orderEmailLabel'),
            emailPlaceholder: t(locale, 'landing.orderEmailPlaceholder'),
            consent: t(locale, 'landing.orderConsent'),
            consentLink: t(locale, 'landing.orderConsentPrivacy'),
            submit: t(locale, 'landing.orderSubmit'),
            submitting: t(locale, 'landing.orderSubmitting'),
            redirecting: t(locale, 'landing.orderRedirecting'),
            paymentNote: t(locale, 'landing.orderPaymentNote'),
            successTitle: t(locale, 'landing.orderSuccessTitle'),
            successText: t(locale, 'landing.orderSuccessText'),
            successApp: t(locale, 'landing.orderSuccessApp'),
            errorEmail: t(locale, 'landing.orderErrorEmail'),
            errorConsent: t(locale, 'landing.orderErrorConsent'),
            errorNetwork: t(locale, 'landing.orderErrorNetwork'),
            errorGeneric: t(locale, 'landing.orderErrorGeneric'),
            notConfigured: t(locale, 'landing.orderNotConfigured'),
            tryAgain: t(locale, 'landing.orderTryAgain'),
            lifetimeNote: t(locale, 'landing.courseLifetimeNote'),
            telegramLabel: t(locale, 'landing.contactTelegram'),
          }}
        />
      </div>
    </div>
  </Section>

  <Section id="faq" title={t(locale, 'landing.courseFaqTitle')} class="!py-12 md:!py-16">
    <Faq items={course.faq.map((f) => ({ q: l(f.q, locale), a: l(f.a, locale) }))} />
  </Section>

  {
    (guides.length > 0 || exercises.length > 0) && (
      <section class="mx-auto max-w-6xl px-5 py-12 md:py-16">
        <div class="grid gap-8 lg:grid-cols-2">
          {guides.length > 0 && (
            <div>
              <h2 class="font-display text-2xl">{t(locale, 'landing.courseGuidesTitle')}</h2>
              <ul class="mt-5 flex flex-col">
                {guides.map((g) => (
                  <li>
                    <a
                      href={href(locale, `/guides/${g.id.slice(locale.length + 1)}/`)}
                      class="group block border-t border-border py-4 transition-colors duration-150 hover:border-border-strong"
                    >
                      <span class="font-semibold group-hover:underline">{g.data.h1}</span>
                      <span class="mt-1 block text-sm text-muted">{g.data.description}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {exercises.length > 0 && (
            <div>
              <h2 class="font-display text-2xl">{t(locale, 'landing.courseExercisesTitle')}</h2>
              <ul class="mt-5 flex flex-wrap gap-2">
                {exercises.map((ex) => (
                  <li>
                    <a
                      href={exerciseHref(locale, ex)}
                      class="inline-flex min-h-11 items-center border border-border bg-surface-3 px-4 text-sm transition-colors duration-150 hover:border-border-strong"
                    >
                      {l(ex.name, locale)}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )
  }
</Landing>
