---
/**
 * HTML shell shared by every page. SEO tags are delegated to <SeoHead>, which the SEO area owns;
 * this layout only guarantees the document skeleton, fonts and global styles.
 */
import '@/styles/global.css';
import { withBase } from '@/lib/util/paths';
import type { Locale } from '@/content/schema';

interface Props {
  locale: Locale;
  /** Extra class on <body>. */
  bodyClass?: string;
}

const { locale, bodyClass = '' } = Astro.props;
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0b0d" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
