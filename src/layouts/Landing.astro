---
/**
 * Landing shell: Base + top navigation (with a mobile menu) + footer.
 * The landing area owns the visual design of nav/footer; other areas only pass props.
 *
 * The header is the lockup «FORMA // Сергей Титов» on the left, the navigation as text-only caps
 * kickers, one white button for the app, and a hairline under it all. No icons anywhere — the
 * mobile menu opens on the word «Меню» and closes on a × glyph. The footer is the mark, the
 * tagline and three columns of links divided by hairlines, not boxes.
 *
 * `sitePath` / `localizedPaths` are forwarded to <SeoHead> for the canonical URL and the hreflang
 * alternates, and to <LangSwitch> for the language links — deliberately the same map, so that what
 * a reader is offered and what a crawler is told can never disagree.
 */
import Base from './Base.astro';
import SeoHead from '@/components/seo/SeoHead.astro';
import Analytics from '@/components/seo/Analytics.astro';
import Logo from '@/components/landing/Logo.astro';
import LangSwitch from '@/components/landing/LangSwitch.astro';
import { t } from '@/i18n/index';
import { href, appHref } from '@/lib/util/paths';
import { BRAND } from '@content/site/brand';
import { entityName } from '@content/site/legalEntity';
import { LINKS } from '@content/site/links';
import { PLANS_ENABLED } from '@content/site/plans';
import { PRICING } from '@content/site/pricing';
import type { Locale } from '@/content/schema';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  sitePath: string;
  localizedPaths?: Partial<Record<Locale, string>>;
  type?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
  jsonLd?: object | object[] | null;
  publishedAt?: string;
  updatedAt?: string;
  /** Extra class on <main>. */
  mainClass?: string;
}

const { locale, sitePath, localizedPaths, mainClass = '', ...seo } = Astro.props;
const year = new Date().getFullYear();

const navLinks = [
  { href: href(locale, '/courses/'), label: t(locale, 'landing.navCourses') },
  // While the subscription is off sale there is no /subscribe/ page, so the nav must not offer
  // one: every other entry point already checks this flag, and an unguarded link in the header
  // sits on every page of the site — the most visible 404 it is possible to ship.
  ...(PLANS_ENABLED
    ? [{ href: href(locale, '/subscribe/'), label: t(locale, 'landing.navSubscribe') }]
    : []),
  { href: href(locale, '/exercises/'), label: t(locale, 'landing.navExercises') },
  { href: href(locale, '/guides/'), label: t(locale, 'landing.navGuides') },
  { href: href(locale, '/about/'), label: t(locale, 'landing.navAbout') },
];
const productLinks = [
  ...navLinks,
  { href: href(locale, '/contact/'), label: t(locale, 'landing.footerContact') },
];
const legalLinks = [
  { href: href(locale, '/privacy/'), label: t(locale, 'landing.footerPrivacy') },
  { href: href(locale, '/terms/'), label: t(locale, 'landing.footerTerms') },
  { href: href(locale, '/refund/'), label: t(locale, 'landing.footerRefund') },
];
const contactEmail = LINKS.supportEmail || BRAND.contactEmail;
const telegram = LINKS.supportTelegram || BRAND.telegram;
const socials = [
  { url: telegram, label: 'Telegram' },
  { url: BRAND.instagram, label: 'Instagram' },
  { url: BRAND.youtube, label: 'YouTube' },
].filter((s) => Boolean(s.url));

const primaryLink =
  'control-label inline-flex h-10 items-center rounded-control bg-primary px-4.5 text-[14px] text-on-primary transition-[opacity,transform] duration-150 ease-(--ease-out) hover:opacity-85 active:scale-[0.98]';
---

<Base locale={locale}>
  <Fragment slot="head">
    <SeoHead locale={locale} sitePath={sitePath} localizedPaths={localizedPaths} {...seo} />
    <Analytics />
    <slot name="head" />
  </Fragment>

  <a
    href="#main"
    class="control-label sr-only z-50 rounded-control bg-primary px-5 text-[14px] text-on-primary focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:inline-flex focus:min-h-11 focus:items-center"
  >
    {t(locale, 'landing.skipToContent')}
  </a>

  <!--
    Glass, from the same token the app uses. This was `bg-bg/85 backdrop-blur` — a flat alpha, which
    is exactly the shape the brandbook now rules out (design/CHANGELOG.md §8): at one constant 85%
    the page's own headings stay legible inside the bar while scrolling past it. `.glass-bar-top`
    is a gradient instead, sheer along the bottom edge where the page arrives and near-opaque where
    the wordmark and the menu sit, and it brings its own hairline — so the border utility is gone.
  -->
  <header class="glass-bar-top sticky top-0 z-40">
    <nav
      class="relative mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-5 md:h-18"
      aria-label={t(locale, 'landing.navMenu')}
    >
      <!--
        The lockup needs room. On a 390px header, next to the app button and the menu, «FORMA //
        Сергей Титов» has none: the separator collapses and his name wraps under the mark, which
        reads as one broken word rather than as a lockup. The mark alone is the correct form at
        that width — the brandbook's lockup is for where it fits.

        Hidden with `max-md:hidden`, not `hidden md:inline-flex`. Both are display utilities in the
        same layer, so the one Tailwind emits last wins — and `.inline-flex` is emitted after
        `.hidden`, which `Logo` sets on itself. `hidden` on such a component is silently ignored;
        `max-md:hidden` is a media rule and wins wherever it applies.
      -->
      <a href={href(locale, '/')} class="text-[17px] text-text md:text-lg">
        <Logo label={BRAND.name} class="md:hidden" />
        <Logo lockup locale={locale} label={BRAND.name} class="max-md:hidden" />
      </a>

      <!--
        The links appear at `lg`, not at `md`, and the reason is measured rather than tidy. At 820px
        — an iPad in portrait — the row was five links at `gap-7`, the full lockup and the app
        button in 780px of usable width: «О тренере» broke onto a second line and the button landed
        on top of it. Everything below 1024 gets the menu button instead, which is what that width
        has room for.
      -->
      <ul class="hidden items-center gap-7 lg:flex">
        {
          navLinks.map((x) => (
            <li>
              <a
                class="eyebrow tap-target-y inline-flex items-center transition-colors duration-150 hover:text-text"
                href={x.href}
              >
                {x.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-2">
        <!--
          Before the app button, not after it: the button is the one thing on this bar that is
          meant to be pressed, and it keeps the edge. The switch is two letters of caps kicker, the
          same weight as the navigation it sits beside.
        -->
        <LangSwitch locale={locale} localizedPaths={localizedPaths} class="-mr-1" />

        <!-- `max-sm:hidden`, not `hidden sm:inline-flex` — see the note on the lockup above. -->
        <a href={appHref()} class:list={[primaryLink, 'max-sm:hidden']}>
          {t(locale, 'landing.navApp')}
        </a>

        <details class="group lg:hidden" data-mobile-nav>
          <!--
            A word, not a hamburger: the brand has almost no icons, and «Меню» says what three
            lines only imply. The open state shows a × glyph, which is punctuation, not a picture.
          -->
          <summary
            class="control-label flex h-10 min-w-11 cursor-pointer list-none items-center justify-center whitespace-nowrap rounded-control border border-border-strong px-3 text-[14px] text-text [&::-webkit-details-marker]:hidden"
            aria-label={t(locale, 'landing.navMenu')}
            aria-expanded="false"
            aria-controls="mobile-nav-panel"
          >
            <span class="group-open:hidden">{t(locale, 'landing.navMenu')}</span>
            <span class="glyph hidden text-lg group-open:inline-flex" aria-hidden="true">×</span>
          </summary>
          <div
            id="mobile-nav-panel"
            class="absolute inset-x-0 top-full border-b border-border bg-bg px-5 pt-2 pb-6"
          >
            <ul class="flex flex-col divide-y divide-border">
              <li>
                <a class="font-display flex min-h-12 items-center text-sm" href={href(locale, '/')}>
                  {t(locale, 'landing.navHome')}
                </a>
              </li>
              {
                navLinks.map((x) => (
                  <li>
                    <a class="font-display flex min-h-12 items-center text-sm" href={x.href}>
                      {x.label}
                    </a>
                  </li>
                ))
              }
              <li>
                <a
                  class="font-display flex min-h-12 items-center text-sm"
                  href={href(locale, '/contact/')}
                >
                  {t(locale, 'landing.navContact')}
                </a>
              </li>
            </ul>
            <a
              href={appHref()}
              class="control-label mt-4 flex h-12 items-center justify-center rounded-control bg-primary px-5 text-[15px] text-on-primary"
            >
              {t(locale, 'landing.navApp')}
            </a>
          </div>
        </details>
      </div>
    </nav>
  </header>

  <main id="main" class={mainClass} tabindex="-1">
    <slot />
  </main>

  <footer class="mt-24 border-t border-border">
    <div
      class="mx-auto grid max-w-6xl gap-x-10 px-5 py-12 md:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)_minmax(0,1fr)_minmax(0,1fr)]"
    >
      <div class="pb-8 md:pb-0">
        <a href={href(locale, '/')} class="inline-flex text-2xl text-text">
          <Logo label={BRAND.name} />
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">
          {t(locale, 'common.tagline')}
        </p>
        <a
          href={appHref()}
          class="control-label mt-6 inline-flex h-10 items-center rounded-control border border-border-strong bg-surface-2 px-4.5 text-[14px] transition-colors duration-150 hover:bg-surface-3"
        >
          {t(locale, 'common.openApp')}
        </a>
      </div>
      <!-- Each column starts with a hairline on the phone and a hairline on its left above it. -->
      <div class="border-t border-border pt-6 md:border-t-0 md:border-l md:pt-0 md:pl-6">
        <p class="eyebrow">
          {t(locale, 'landing.footerProduct')}
        </p>
        <ul class="mt-4 flex flex-col gap-2.5 text-sm">
          {
            productLinks.map((x) => (
              <li>
                <a class="text-muted transition-colors duration-150 hover:text-text" href={x.href}>
                  {x.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div
        class="mt-8 border-t border-border pt-6 md:mt-0 md:border-t-0 md:border-l md:pt-0 md:pl-6"
      >
        <p class="eyebrow">
          {t(locale, 'landing.footerLegal')}
        </p>
        <ul class="mt-4 flex flex-col gap-2.5 text-sm">
          {
            legalLinks.map((x) => (
              <li>
                <a class="text-muted transition-colors duration-150 hover:text-text" href={x.href}>
                  {x.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div
        class="mt-8 border-t border-border pt-6 md:mt-0 md:border-t-0 md:border-l md:pt-0 md:pl-6"
      >
        <p class="eyebrow">
          {t(locale, 'landing.footerReach')}
        </p>
        <ul class="mt-4 flex flex-col gap-2.5 text-sm">
          <li>
            <a
              class="break-words text-muted transition-colors duration-150 hover:text-text"
              href={`mailto:${contactEmail}`}
            >
              {contactEmail}
            </a>
          </li>
          {
            socials.map((s) => (
              <li>
                <a
                  class="text-muted transition-colors duration-150 hover:text-text"
                  href={s.url}
                  rel="noopener"
                >
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="border-t border-border">
      <div
        class="mx-auto flex max-w-6xl flex-wrap items-baseline justify-between gap-x-6 gap-y-2 px-5 py-5 text-xs tracking-[0.04em] text-muted-2"
      >
        <span class="inline-flex text-sm text-muted">
          <Logo lockup locale={locale} label={BRAND.name} />
        </span>
        {
          /*
          The seller, when there is one to name, and the age mark.

          `entityName()` is empty until content/site/legalEntity.ts is filled in, and then this
          line stops saying «Forma» — a brand — and starts saying who is actually taking the money,
          which is what ЗоЗПП ст. 9 is about. The requisites in full are on the offer page; this is
          the footprint on every page.

          «18+» is our own terms made visible: PRICING.minimumAge is 18 and the offer says so, and
          a limit stated only inside a document nobody opens is not stated. It is not a claim about
          436-ФЗ — this is not children's media — it is the product agreeing with itself.
        */
        }
        <span class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span>© {year} {entityName() || BRAND.organization}</span>
          <span aria-label={t(locale, 'landing.footerAgeLabel')}>{PRICING.minimumAge}+</span>
        </span>
      </div>
    </div>
  </footer>

  <script>
    // Mobile menu: keep aria-expanded in sync and close on Esc, on link click, on outside click
    // and when the viewport grows. Esc always returns focus to the summary that opened the menu.
    const nav = document.querySelector<HTMLDetailsElement>('[data-mobile-nav]');
    if (nav) {
      const summary = nav.querySelector<HTMLElement>('summary');
      const close = () => {
        nav.open = false;
      };
      nav.addEventListener('toggle', () => {
        summary?.setAttribute('aria-expanded', String(nav.open));
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav.open) {
          close();
          summary?.focus();
        }
      });
      nav.addEventListener('click', (e) => {
        if (e.target instanceof Element && e.target.closest('a')) close();
      });
      // Tabbing out of the open panel closes it, so focus never lands behind an invisible menu.
      nav.addEventListener('focusout', (e) => {
        if (!nav.open) return;
        const next = e.relatedTarget;
        if (next instanceof Node && nav.contains(next)) return;
        if (next === null) return;
        close();
      });
      document.addEventListener('click', (e) => {
        if (nav.open && e.target instanceof Node && !nav.contains(e.target)) close();
      });
      const mq = window.matchMedia('(min-width: 768px)');
      mq.addEventListener('change', (e) => {
        if (e.matches) close();
      });
    }
  </script>
</Base>
