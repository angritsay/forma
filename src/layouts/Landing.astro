---
/**
 * Landing shell: Base + top navigation (with a mobile menu) + footer + language switcher.
 * The landing area owns the visual design of nav/footer; other areas only pass props.
 *
 * `sitePath` / `localizedPaths` are forwarded to the language switcher so that the switch keeps
 * the visitor on the same page in the other language.
 */
import Base from './Base.astro';
import SeoHead from '@/components/seo/SeoHead.astro';
import Analytics from '@/components/seo/Analytics.astro';
import { t } from '@/i18n/index';
import { href, appHref } from '@/lib/util/paths';
import { BRAND } from '@content/site/brand';
import { LINKS } from '@content/site/links';
import type { Locale } from '@/content/schema';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  sitePath: string;
  localizedPaths?: Partial<Record<Locale, string>>;
  type?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
  jsonLd?: object | object[] | null;
  publishedAt?: string;
  updatedAt?: string;
  /** Extra class on <main>. */
  mainClass?: string;
}

const { locale, sitePath, localizedPaths, mainClass = '', ...seo } = Astro.props;
const other: Locale = locale === 'ru' ? 'en' : 'ru';
const otherPath = localizedPaths ? (localizedPaths[other] ?? '/') : sitePath;
const otherLabel = other === 'en' ? t(locale, 'common.languageEn') : t(locale, 'common.languageRu');
const year = new Date().getFullYear();

const navLinks = [
  { href: href(locale, '/courses/'), label: t(locale, 'landing.navCourses') },
  { href: href(locale, '/exercises/'), label: t(locale, 'landing.navExercises') },
  { href: href(locale, '/guides/'), label: t(locale, 'landing.navGuides') },
  { href: href(locale, '/about/'), label: t(locale, 'landing.navAbout') },
];
const productLinks = [
  ...navLinks,
  { href: href(locale, '/contact/'), label: t(locale, 'landing.footerContact') },
];
const legalLinks = [
  { href: href(locale, '/privacy/'), label: t(locale, 'landing.footerPrivacy') },
  { href: href(locale, '/terms/'), label: t(locale, 'landing.footerTerms') },
  { href: href(locale, '/refund/'), label: t(locale, 'landing.footerRefund') },
];
const contactEmail = LINKS.supportEmail || BRAND.contactEmail;
const telegram = LINKS.supportTelegram || BRAND.telegram;
const socials = [
  { url: telegram, label: 'Telegram' },
  { url: BRAND.instagram, label: 'Instagram' },
  { url: BRAND.youtube, label: 'YouTube' },
].filter((s) => Boolean(s.url));
---

<Base locale={locale}>
  <Fragment slot="head">
    <SeoHead locale={locale} sitePath={sitePath} localizedPaths={localizedPaths} {...seo} />
    <Analytics />
    <slot name="head" />
  </Fragment>

  <a
    href="#main"
    class="sr-only z-50 rounded-pill bg-primary px-4 py-2 text-sm font-semibold text-on-primary focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
  >
    {t(locale, 'landing.skipToContent')}
  </a>

  <header class="sticky top-0 z-40 border-b border-border bg-bg/80 backdrop-blur">
    <nav
      class="relative mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3.5"
      aria-label={t(locale, 'landing.navMenu')}
    >
      <a href={href(locale, '/')} class="font-display text-2xl" aria-label={BRAND.name}>
        {BRAND.name}
      </a>

      <ul class="hidden items-center gap-7 text-sm text-muted md:flex">
        {
          navLinks.map((x) => (
            <li>
              <a class="transition hover:text-text" href={x.href}>
                {x.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-2">
        <a
          href={href(other, otherPath)}
          hreflang={other}
          lang={other}
          class="rounded-pill border border-border px-3 py-1.5 text-xs font-semibold tracking-wide text-muted uppercase transition hover:border-text hover:text-text"
          aria-label={otherLabel}
          title={otherLabel}
        >
          {other}
        </a>
        <a
          href={appHref()}
          class="hidden rounded-pill bg-primary px-4 py-2 text-sm font-semibold text-on-primary transition hover:opacity-90 sm:inline-flex"
        >
          {t(locale, 'landing.navApp')}
        </a>

        <details class="group md:hidden" data-mobile-nav>
          <summary
            class="flex size-10 cursor-pointer list-none items-center justify-center rounded-pill border border-border text-text [&::-webkit-details-marker]:hidden"
            aria-label={t(locale, 'landing.navMenu')}
          >
            <svg
              class="group-open:hidden"
              width="18"
              height="18"
              viewBox="0 0 18 18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M2 4.5h14M2 9h14M2 13.5h14"></path>
            </svg>
            <svg
              class="hidden group-open:block"
              width="18"
              height="18"
              viewBox="0 0 18 18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M3 3l12 12M15 3L3 15"></path>
            </svg>
          </summary>
          <div
            class="absolute inset-x-0 top-full border-b border-border bg-bg/95 px-5 pt-2 pb-6 shadow-card backdrop-blur"
          >
            <ul class="flex flex-col">
              <li>
                <a class="block py-3 text-lg font-medium" href={href(locale, '/')}>
                  {t(locale, 'landing.navHome')}
                </a>
              </li>
              {
                navLinks.map((x) => (
                  <li>
                    <a class="block py-3 text-lg font-medium" href={x.href}>
                      {x.label}
                    </a>
                  </li>
                ))
              }
              <li>
                <a class="block py-3 text-lg font-medium" href={href(locale, '/contact/')}>
                  {t(locale, 'landing.navContact')}
                </a>
              </li>
            </ul>
            <a
              href={appHref()}
              class="mt-3 flex items-center justify-center rounded-pill bg-primary px-5 py-3 text-base font-semibold text-on-primary"
            >
              {t(locale, 'landing.navApp')}
            </a>
          </div>
        </details>
      </div>
    </nav>
  </header>

  <main id="main" class={mainClass}>
    <slot />
  </main>

  <footer class="mt-24 border-t border-border">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-12 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <a href={href(locale, '/')} class="font-display text-2xl">{BRAND.name}</a>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted">
          {t(locale, 'common.tagline')}
        </p>
        <a
          href={appHref()}
          class="mt-5 inline-flex rounded-pill border border-border-strong px-4 py-2 text-sm font-semibold transition hover:border-text"
        >
          {t(locale, 'common.openApp')}
        </a>
      </div>
      <div>
        <p class="text-xs font-semibold tracking-[0.2em] text-muted uppercase">
          {t(locale, 'landing.footerProduct')}
        </p>
        <ul class="mt-3 flex flex-col gap-2 text-sm">
          {
            productLinks.map((x) => (
              <li>
                <a class="text-muted transition hover:text-text" href={x.href}>
                  {x.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="text-xs font-semibold tracking-[0.2em] text-muted uppercase">
          {t(locale, 'landing.footerLegal')}
        </p>
        <ul class="mt-3 flex flex-col gap-2 text-sm">
          {
            legalLinks.map((x) => (
              <li>
                <a class="text-muted transition hover:text-text" href={x.href}>
                  {x.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="text-xs font-semibold tracking-[0.2em] text-muted uppercase">
          {t(locale, 'landing.footerReach')}
        </p>
        <ul class="mt-3 flex flex-col gap-2 text-sm">
          <li>
            <a class="text-muted transition hover:text-text" href={`mailto:${contactEmail}`}>
              {contactEmail}
            </a>
          </li>
          {
            socials.map((s) => (
              <li>
                <a class="text-muted transition hover:text-text" href={s.url} rel="noopener">
                  {s.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              class="text-muted transition hover:text-text"
              href={href(other, otherPath)}
              hreflang={other}
              lang={other}
            >
              {otherLabel}
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="border-t border-border">
      <p class="mx-auto max-w-6xl px-5 py-5 text-xs text-muted-2">
        © {year}
        {BRAND.organization}
      </p>
    </div>
  </footer>

  <script>
    // Mobile menu: close on Esc, on link click, on outside click and when the viewport grows.
    const nav = document.querySelector<HTMLDetailsElement>('[data-mobile-nav]');
    if (nav) {
      const close = () => {
        nav.open = false;
      };
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav.open) {
          close();
          nav.querySelector<HTMLElement>('summary')?.focus();
        }
      });
      nav.addEventListener('click', (e) => {
        if (e.target instanceof Element && e.target.closest('a')) close();
      });
      document.addEventListener('click', (e) => {
        if (nav.open && e.target instanceof Node && !nav.contains(e.target)) close();
      });
      const mq = window.matchMedia('(min-width: 768px)');
      mq.addEventListener('change', (e) => {
        if (e.matches) close();
      });
    }
  </script>
</Base>
