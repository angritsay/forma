# Copy to .env and fill in. docker-compose reads this file automatically.

# Domain for Caddy. Modes:
#   rolls.example.com  → automatic public HTTPS (needs DNS pointing here)
#   localhost          → HTTPS via Caddy's internal CA
#   :80                → plain HTTP, for testing before the domain is decided
ROLLS_DOMAIN=:80

# Bearer token the iPhone app uses for /api/*. Generate:
#   openssl rand -hex 32
SYNC_TOKEN=

# Reserved for P5 (MCP server at /mcp/{secret}) — unused in P3.
# MCP_SECRET=
