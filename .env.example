# --- Site ---------------------------------------------------------------
# Canonical origin of the deployed site (no trailing slash).
#
# Before the domain was attached this pair was https://angritsay.github.io/forma and /forma/.
# Use that pair together if you ever build for the github.io address again: BASE_PATH is what
# every asset URL is written against, and a mismatch serves a page with no CSS.
SITE_URL=https://forma-app.co
# Path prefix: "/" at a domain root, "/<repo>/" on a GitHub Pages project site.
BASE_PATH=/

# --- Supabase (public values, safe to ship to the browser; RLS protects data) ---
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Demo mode (docs/SETUP.md §10) --------------------------------------
# "true" forces the browser-local demo backend for everyone opening the build.
# Leave empty in production; without Supabase the app offers the demo behind a button anyway.
PUBLIC_DEMO_MODE=

# --- SEO / analytics (rendered only when set) ---------------------------
PUBLIC_YANDEX_METRIKA_ID=
PUBLIC_GA_ID=
PUBLIC_YANDEX_VERIFICATION=
PUBLIC_GOOGLE_VERIFICATION=
# IndexNow key (any 8-128 hex/alphanumeric string). Served at /<key>.txt and used by scripts/seo/indexnow.mjs
INDEXNOW_KEY=
