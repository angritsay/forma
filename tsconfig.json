{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@content/*": ["content/*"]
    },
    "types": ["astro/client", "vitest/globals"],
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "content/**/*",
    "scripts/**/*",
    "astro.config.mjs",
    "vitest.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
