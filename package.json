{
  "name": "forma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Forma — adaptive home CrossFit-style training app and SEO landing (Astro + React + Supabase)",
  "scripts": {
    "build": "astro build",
    "postbuild": "node scripts/seo/postbuild.mjs",
    "check": "astro check && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:validate": "node scripts/content/validate.mjs",
    "seo:audit": "node scripts/seo/audit.mjs",
    "seo:indexnow": "node scripts/seo/indexnow.mjs",
    "seo:new-guide": "node scripts/seo/new-guide.mjs",
    "seo:og": "node scripts/seo/og.mjs"
  },
  "dependencies": {
    "@astrojs/react": "4.4.2",
    "@astrojs/rss": "4.0.19",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@supabase/supabase-js": "2.113.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "5.18.2",
    "clsx": "2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.3",
    "tailwindcss": "4.3.3",
    "zod": "3.25.76",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "^9.39.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.69.0",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
