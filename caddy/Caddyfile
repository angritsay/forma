# ROLLS_DOMAIN modes:
#   rolls.example.com  → automatic public HTTPS (Let's Encrypt)
#   localhost          → HTTPS with Caddy's internal CA
#   :80                → plain HTTP (pre-domain testing only)
{$ROLLS_DOMAIN} {
	rate_limit {
		zone rolls {
			key {remote_host}
			events 120
			window 1m
		}
	}

	reverse_proxy app:8080

	# The future /mcp/{secret} endpoint carries a secret in its URL path, so
	# access logs must never record request URIs. Configured from day one.
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>uri replace REDACTED
			}
		}
	}
}
